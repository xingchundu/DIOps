# 客户唯一需要修改的配置（解压后编辑本文件，保存后执行 bin/install.sh 与 bin/start.sh）
# 平台库 Oracle：默认 Thin（无需 Instant Client）。被管库若为 11g 等老版本，WebSQL/Node 直连会 NJS-118：
# 安装 Instant Client 后设置 ORACLE_CLIENT_LIB_DIR=/path/to/instantclient 与 NODE_ORACLEDB_DRIVER_MODE=thick

DB_HOST=192.168.137.102
DB_PORT=1521
DB_SID=ora19c
# 使用服务名时删掉 DB_SID，改用下面一行：
# DB_SERVICE_NAME=ORCLPDB1
# 或整串：DB_CONNECT_STRING=主机:1521/服务名

DB_USER=monitor
DB_PASSWORD=oracle

# 登录令牌密钥。安装时若仍为占位文字，install.sh 会自动生成
JWT_SECRET=请换成至少32位的随机字符串

# 被管库密码 / SSH 凭据的解密密钥。必须与加密这些密码的那台应用服务器完全相同。
# 留空时：新库（库内还没有 AESGCM 密码）由 install.sh 生成；已有加密密码则拒绝启动。
# 不要在第二台服务器上重新生成，否则监控、SQL 采集、Oracle 深度诊断都无法连接已保存的实例。
# DBOPS_SECRET_KEY=

# 浏览器访问端口（仅开放此外网端口；默认 18443，避免占用 443）
HTTPS_PORT=18443

# 内部端口，一般无需修改
JAVA_PORT=3000
NODE_PORT=3001
PORT=3000
BIND_HOST=127.0.0.1
NODE_ORACLEDB_DRIVER_MODE=thin
# ORACLE_CLIENT_LIB_DIR=/opt/oracle/instantclient_19_22
NODE_ENV=production

# 生产默认要求 API 经 Java 网关；仅本地排障可设 DIOPS_REQUIRE_GATEWAY=false 或 DBOPS_ALLOW_DIRECT_NODE=1
DIOPS_REQUIRE_GATEWAY=true

SQL_AGENT_URL=http://127.0.0.1:8000
AI_OPS_AGENT_URL=http://127.0.0.1:8001
SQL_OPT_HOST=127.0.0.1
AI_OPS_HOST=127.0.0.1
