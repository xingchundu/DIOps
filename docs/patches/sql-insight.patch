+package com.dbops.sqlinsight.rules;
+
+import com.dbops.common.Db;
+import com.dbops.common.Values;
+import com.dbops.service.SystemConfigService;
+import com.dbops.sqlinsight.store.AlertBridge;
+import com.dbops.sqlinsight.store.AssetService;
+import com.dbops.sqlinsight.store.InstanceDirectory;
+import com.dbops.sqlinsight.store.Json;
+import org.springframework.stereotype.Service;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+/**
+ * 问题记录（DI_SQL_PROBLEM）：规则命中去重（EVENT_KEY = 规则|实例|资产）、恢复、SKIPPED 原因，
+ * 以及 CRITICAL（可配置）问题推送告警中心。
+ */
+@Service
+public class ProblemService {
+
+    private final Db db;
+    private final RuleConfigService rules;
+    private final AlertBridge alerts;
+    private final SystemConfigService cfg;
+
+    public ProblemService(Db db, RuleConfigService rules, AlertBridge alerts, SystemConfigService cfg) {
+        this.db = db;
+        this.rules = rules;
+        this.alerts = alerts;
+        this.cfg = cfg;
+    }
+
+    public static String key(String code, long instanceId, Object asset) {
+        return code + "|" + instanceId + "|" + asset;
+    }
+
+    /** 窗口规则结果落库；evaluatedAssets 为本窗口参与评估的资产（未命中的已开问题据此恢复） */
+    public int applyWindow(InstanceDirectory.Inst inst, RuntimeRuleEngine.Result res, Collection<Long> evaluatedAssets) {
+        Set<String> hitKeys = new HashSet<>();
+        int opened = 0;
+        // 能力恢复的规则先关闭 SKIPPED 记录，再写本窗口命中：SKIPPED 与 OPEN 共用“活动问题”唯一索引，
+        // 原来顺序相反，能力恢复后第一个窗口的命中可能因唯一键冲突被 insertQuietly 吞掉
+        if (!res.evaluatedCodes().isEmpty()) {
+            List<Object> args = new ArrayList<>();
+            args.add(inst.id());
+            args.addAll(res.evaluatedCodes());
+            db.update("UPDATE DI_SQL_PROBLEM SET STATUS='RESOLVED', RESOLVED_AT=SYSTIMESTAMP, DETAIL='能力已支持' WHERE INSTANCE_ID=? AND STATUS='SKIPPED' "
+                    + "AND RULE_CODE IN (" + Db.placeholders(res.evaluatedCodes().size()) + ")", args);
+        }
+        for (RuntimeRuleEngine.Hit h : res.hits()) {
+            String k = key(h.code(), inst.id(), h.assetId());
+            hitKeys.add(k);
+            opened += upsert(inst, k, h.code(), h.assetId(), h.severity(), h.value(), h.threshold(), h.detail(), h.evidence()) ? 1 : 0;
+        }
+        // 未再命中 → 恢复（只针对本窗口评估过的规则 + 资产）
+        if (!res.evaluatedCodes().isEmpty() && !evaluatedAssets.isEmpty()) {
+            List<Object> args = new ArrayList<>();
+            args.add(inst.id());
+            args.addAll(res.evaluatedCodes());
+            for (Map<String, Object> p : db.query("SELECT PROBLEM_ID, EVENT_KEY, ASSET_ID, ALERT_ID FROM DI_SQL_PROBLEM WHERE INSTANCE_ID=? AND STATUS='OPEN' "
+                    + "AND RULE_CODE IN (" + Db.placeholders(res.evaluatedCodes().size()) + ")", args)) {
+                Long asset = Values.toLong(p.get("ASSET_ID"));
+                if (asset != null && evaluatedAssets.contains(asset) && !hitKeys.contains(Values.str(p.get("EVENT_KEY")))) {
+                    resolve(p, "指标恢复正常");
+                }
+            }
+        }
+        // SKIPPED：能力不支持的规则每实例一条；能力恢复后关闭
+        for (RuntimeRuleEngine.Skip s : res.skipped()) {
+            String k = key(s.code(), inst.id(), "*");
+            int n = db.update("UPDATE DI_SQL_PROBLEM SET LAST_SEEN=SYSTIMESTAMP, DETAIL=? WHERE EVENT_KEY=? AND STATUS='SKIPPED'", s.reason(), k);
+            if (n == 0) {
+                insertQuietly(k, s.code(), inst.id(), null, "INFO", "SKIPPED", null, null, s.reason(), null);
+            }
+        }
+        return opened;
+    }
+
+    /** 会话规则结果落库（P-001/P-002/P-010）；本次采样未命中的会话类问题恢复 */
+    public void applySessions(InstanceDirectory.Inst inst, List<RuntimeRuleEngine.SessionHit> hits, boolean supported, String reason) {
+        if (!supported) {
+            for (String code : RuntimeRuleEngine.SESSION_RULES) {
+                String k = key(code, inst.id(), "*");
+                int n = db.update("UPDATE DI_SQL_PROBLEM SET LAST_SEEN=SYSTIMESTAMP, DETAIL=? WHERE EVENT_KEY=? AND STATUS='SKIPPED'", reason, k);
+                if (n == 0) {
+                    insertQuietly(k, code, inst.id(), null, "INFO", "SKIPPED", null, null, reason, null);
+                }
+            }
+            return;
+        }
+        db.update("UPDATE DI_SQL_PROBLEM SET STATUS='RESOLVED', RESOLVED_AT=SYSTIMESTAMP WHERE INSTANCE_ID=? AND STATUS='SKIPPED' "
+                + "AND RULE_CODE IN ('P-001','P-002','P-010')", inst.id());
+        Set<String> hitKeys = new HashSet<>();
+        for (RuntimeRuleEngine.SessionHit h : hits) {
+            if (h.severity() == null) {
+                continue;
+            }
+            Object asset = h.assetId() > 0 ? h.assetId() : "S" + h.sessionKey();
+            String k = key(h.code(), inst.id(), asset);
+            if (hitKeys.add(k)) {
+                upsert(inst, k, h.code(), h.assetId() > 0 ? h.assetId() : null, h.severity(), h.value(), h.threshold(), h.detail(), h.evidence());
+            }
+        }
+        for (Map<String, Object> p : db.query("SELECT PROBLEM_ID, EVENT_KEY, ALERT_ID FROM DI_SQL_PROBLEM WHERE INSTANCE_ID=? AND STATUS='OPEN' "
+                + "AND RULE_CODE IN ('P-001','P-002','P-010')", inst.id())) {
+            if (!hitKeys.contains(Values.str(p.get("EVENT_KEY")))) {
+                resolve(p, "会话已结束或不再满足条件");
+            }
+        }
+    }
+
+    /** 长时间未再出现的窗口类问题（SQL 不再执行）自动恢复 */
+    public void resolveStale(long instanceId, int minutes) {
+        for (Map<String, Object> p : db.query("SELECT PROBLEM_ID, ALERT_ID FROM DI_SQL_PROBLEM WHERE INSTANCE_ID=? AND STATUS='OPEN' "
+                + "AND LAST_SEEN < SYSTIMESTAMP - NUMTODSINTERVAL(?, 'MINUTE')", instanceId, minutes)) {
+            resolve(p, minutes + " 分钟内未再出现");
+        }
+    }
+
+    /** @return 是否新开问题 */
+    private boolean upsert(InstanceDirectory.Inst inst, String k, String code, Long asset, String severity, double value, double threshold,
+                           String detail, Map<String, Object> evidence) {
+        String evJson = evidence == null ? null : Json.write(evidence);
+        int n = db.update("UPDATE DI_SQL_PROBLEM SET LAST_SEEN=SYSTIMESTAMP, HIT_COUNT=HIT_COUNT+1, METRIC_VALUE=?, THRESHOLD=?, SEVERITY=?, "
+                        + "DETAIL=?, EVIDENCE=? WHERE EVENT_KEY=? AND STATUS='OPEN'",
+                round(value), round(threshold), severity, Values.truncate(detail, 2000), evJson, k);
+        if (n > 0) {
+            return false;
+        }
+        Long id = insertQuietly(k, code, inst.id(), asset, severity, "OPEN", value, threshold, detail, evJson);
+        if (id == null) {
+            return false;
+        }
+        String min = cfg.get("sqlinsight.problem.alert_min_severity", "CRITICAL");
+        if (AssetService.rank(severity) >= AssetService.rank(min)) {
+            RuleConfigService.RuleSetting s = rules.resolve(code, RuleConfigService.Scope.GLOBAL);
+            Map<String, Object> ar = asset == null ? null
+                    : db.one("SELECT DBMS_LOB.SUBSTR(SAMPLE_SQL, 200, 1) AS S FROM DI_SQL_ASSET WHERE ASSET_ID=?", asset);
+            String sql = ar == null ? "" : Values.str(ar.get("S"), "");
+            Long alertId = alerts.fire(AlertBridge.RULE_PROBLEM, inst.id(), inst.name(), severity,
+                    String.format("[%s %s] %s%s%s", code, s.name(), detail, asset == null ? "" : "；SQL#" + asset + " ",
+                            Values.truncate(sql, 200)));
+            if (alertId != null) {
+                db.update("UPDATE DI_SQL_PROBLEM SET ALERT_ID=? WHERE PROBLEM_ID=?", alertId, id);
+            }
+        }
+        return true;
+    }
+
+    private Long insertQuietly(String k, String code, long instanceId, Long asset, String severity, String status, Double value,
+                               Double threshold, String detail, String evidence) {
+        try {
+            return db.insertReturningId("INSERT INTO DI_SQL_PROBLEM (EVENT_KEY, RULE_CODE, INSTANCE_ID, ASSET_ID, SEVERITY, STATUS, METRIC_VALUE, THRESHOLD, DETAIL, EVIDENCE) "
+                            + "VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)", "PROBLEM_ID", k, code, instanceId, asset, severity, status,
+                    value == null ? null : round(value), threshold == null ? null : round(threshold), Values.truncate(detail, 2000), evidence);
+        } catch (Exception e) {
+            if (Db.isUniqueViolation(e)) {
+                return null;     // 并发下另一个节点已插入
+            }
+            throw e;
+        }
+    }
+
+    public void resolve(Map<String, Object> p, String why) {
+        db.update("UPDATE DI_SQL_PROBLEM SET STATUS='RESOLVED', RESOLVED_AT=SYSTIMESTAMP WHERE PROBLEM_ID=? AND STATUS='OPEN'", p.get("PROBLEM_ID"));
+        alerts.resolve(p.get("ALERT_ID"), "SQL 问题已恢复：" + why);
+    }
+
+    private static double round(double v) {
+        return Double.isNaN(v) || Double.isInfinite(v) ? 0 : Values.round(v, 4);
+    }
+}
diff --git a/dbops-server/src/main/java/com/dbops/sqlinsight/rules/RuleConfigService.java b/dbops-server/src/main/java/com/dbops/sqlinsight/rules/RuleConfigService.java
new file mode 100644
index 0000000..2e180ea
--- /dev/null
+++ b/dbops-server/src/main/java/com/dbops/sqlinsight/rules/RuleConfigService.java
@@ -0,0 +1,220 @@
+package com.dbops.sqlinsight.rules;
+
+import com.dbops.common.BizException;
+import com.dbops.common.Db;
+import com.dbops.common.Values;
+import com.dbops.sqlinsight.ast.StaticRuleEngine;
+import com.dbops.sqlinsight.store.Json;
+import org.springframework.stereotype.Service;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Set;
+
+/**
+ * 规则与阈值（DI_SQL_RULE）。覆盖优先级：SQL &gt; 实例 &gt; 业务类型 &gt; 数据库类型 &gt; 全局；
+ * 参数按键合并（只覆盖写了的键），启用/级别取最具体的非空值。
+ * <p>
+ * 同时给静态审核（SqlAuditService）和运行态规则（RuntimeRuleEngine）用，所有入口阈值一致。
+ */
+@Service
+public class RuleConfigService {
+
+    public static final List<String> SCOPE_ORDER = List.of("GLOBAL", "DB_TYPE", "BIZ_TYPE", "INSTANCE", "SQL");
+    private static final Set<String> SCOPES = Set.copyOf(SCOPE_ORDER);
+
+    /** 规则作用域：均可为空 */
+    public record Scope(Long assetId, Long instanceId, String bizType, String dbFamily) {
+        public static final Scope GLOBAL = new Scope(null, null, null, null);
+    }
+
+    public record RuleSetting(String code, String name, String category, boolean enabled, String severity,
+                              Map<String, Object> params) {
+        public double p(String key, double def) {
+            Double d = Values.toDouble(params.get(key));
+            return d == null ? def : d;
+        }
+    }
+
+    private record Row(long id, String code, String name, String category, String scopeType, String scopeValue,
+                       Integer enabled, String severity, Map<String, Object> params) {
+    }
+
+    private final Db db;
+    private volatile Map<String, List<Row>> byCode = Map.of();
+    private volatile long loadedAt;
+
+    public RuleConfigService(Db db) {
+        this.db = db;
+    }
+
+    private Map<String, List<Row>> rows() {
+        if (System.currentTimeMillis() - loadedAt > 60_000) {
+            try {
+                reload();
+            } catch (RuntimeException e) {
+                if (byCode.isEmpty()) {
+                    throw e;
+                }
+                // 已有规则缓存时继续使用旧规则
+            }
+        }
+        return byCode;
+    }
+
+    public synchronized void reload() {
+        Map<String, List<Row>> m = new HashMap<>();
+        try {
+            for (Map<String, Object> r : db.query("SELECT RULE_ID, RULE_CODE, RULE_NAME, CATEGORY, SCOPE_TYPE, SCOPE_VALUE, ENABLED, SEVERITY, PARAMS FROM DI_SQL_RULE")) {
+                Row row = new Row(Values.toLong(r.get("RULE_ID"), 0), Values.str(r.get("RULE_CODE")), Values.str(r.get("RULE_NAME")),
+                        Values.str(r.get("CATEGORY")), Values.str(r.get("SCOPE_TYPE"), "GLOBAL"), Values.str(r.get("SCOPE_VALUE"), "*"),
+                        Values.toInt(r.get("ENABLED")), Values.str(r.get("SEVERITY")), Json.map(Values.str(r.get("PARAMS"))));
+                m.computeIfAbsent(row.code(), k -> new ArrayList<>()).add(row);
+            }
+        } catch (Exception e) {
+            if (!Db.isMissingTable(e)) {
+                // 平台库抖动：沿用上一次的规则，30 秒后再试（原来不更新 loadedAt，之后每次规则判定都会再全表查询一次）
+                loadedAt = System.currentTimeMillis() - 30_000;
+                throw e;
+            }
+        }
+        byCode = m;
+        loadedAt = System.currentTimeMillis();
+    }
+
+    public RuleSetting resolve(String code, Scope s) {
+        List<Row> list = rows().getOrDefault(code, List.of());
+        Row[] picked = new Row[SCOPE_ORDER.size()];
+        for (Row r : list) {
+            if (matches(r, s)) {
+                picked[SCOPE_ORDER.indexOf(r.scopeType())] = r;
+            }
+        }
+        String name = code;
+        String category = null;
+        boolean enabled = true;
+        String severity = null;
+        Map<String, Object> params = new LinkedHashMap<>();
+        for (Row r : picked) {        // 从全局到 SQL，越具体越后覆盖
+            if (r == null) {
+                continue;
+            }
+            if ("GLOBAL".equals(r.scopeType()) || name.equals(code)) {
+                name = r.name() == null ? name : r.name();
+            }
+            category = r.category() == null ? category : r.category();
+            if (r.enabled() != null) {
+                enabled = r.enabled() == 1;
+            }
+            if (r.severity() != null && !r.severity().isBlank()) {
+                severity = r.severity();
+            }
+            params.putAll(r.params());
+        }
+        return new RuleSetting(code, name, category, enabled, severity, params);
+    }
+
+    private static boolean matches(Row r, Scope s) {
+        String v = r.scopeValue();
+        return switch (r.scopeType()) {
+            case "GLOBAL" -> true;
+            case "DB_TYPE" -> s.dbFamily() != null && v.equalsIgnoreCase(s.dbFamily());
+            case "BIZ_TYPE" -> s.bizType() != null && v.equalsIgnoreCase(s.bizType());
+            case "INSTANCE" -> s.instanceId() != null && v.equals(String.valueOf(s.instanceId()));
+            case "SQL" -> s.assetId() != null && v.equals(String.valueOf(s.assetId()));
+            default -> false;
+        };
+    }
+
+    /** 静态规则视图（S-/D-/H-） */
+    public StaticRuleEngine.RuleView staticView(Scope s) {
+        Map<String, RuleSetting> memo = new HashMap<>();
+        return new StaticRuleEngine.RuleView() {
+            private RuleSetting r(String code) {
+                return memo.computeIfAbsent(code, c -> resolve(c, s));
+            }
+
+            @Override
+            public boolean enabled(String code) {
+                return r(code).enabled();
+            }
+
+            @Override
+            public String severity(String code, String def) {
+                String v = r(code).severity();
+                return v == null ? def : v;
+            }
+
+            @Override
+            public double param(String code, String key, double def) {
+                return r(code).p(key, def);
+            }
+        };
+    }
+
+    // ------------------------------------------------------------------ 管理接口
+
+    public List<Map<String, Object>> list(String category, String code) {
+        StringBuilder sql = new StringBuilder("SELECT * FROM DI_SQL_RULE WHERE 1=1");
+        List<Object> args = new ArrayList<>();
+        if (category != null && !category.isBlank()) {
+            sql.append(" AND CATEGORY=?");
+            args.add(category.toUpperCase(Locale.ROOT));
+        }
+        if (code != null && !code.isBlank()) {
+            sql.append(" AND RULE_CODE=?");
+            args.add(code.toUpperCase(Locale.ROOT));
+        }
+        sql.append(" ORDER BY RULE_CODE, DECODE(SCOPE_TYPE,'GLOBAL',1,'DB_TYPE',2,'BIZ_TYPE',3,'INSTANCE',4,5), SCOPE_VALUE");
+        return db.query(sql.toString(), args);
+    }
+
+    /** 新增/修改一条覆盖（同一 code+scope 存在即更新） */
+    public void save(Map<String, Object> b, String username) {
+        String code = Values.str(b.get("ruleCode"), "").toUpperCase(Locale.ROOT);
+        String scopeType = Values.str(b.get("scopeType"), "GLOBAL").toUpperCase(Locale.ROOT);
+        String scopeValue = "GLOBAL".equals(scopeType) ? "*" : Values.str(b.get("scopeValue"), "").trim();
+        if (!code.matches("[PSDH]-\\d{3}")) {
+            throw BizException.badRequest("规则编码不合法");
+        }
+        if (!SCOPES.contains(scopeType) || scopeValue.isEmpty()) {
+            throw BizException.badRequest("作用域不合法");
+        }
+        Object params = b.get("params");
+        String paramsJson = params == null ? null : params instanceof String s ? s : Json.write(params);
+        if (paramsJson != null && !(Json.any(paramsJson) instanceof Map)) {
+            throw BizException.badRequest("参数必须是 JSON 对象");
+        }
+        Map<String, Object> global = db.one("SELECT RULE_NAME, CATEGORY FROM DI_SQL_RULE WHERE RULE_CODE=? AND SCOPE_TYPE='GLOBAL'", code);
+        if (global == null) {
+            throw BizException.notFound("规则不存在: " + code);
+        }
+        Integer enabled = b.containsKey("enabled") ? (Values.truthy(b.get("enabled")) ? 1 : 0) : null;
+        String severity = Values.str(b.get("severity"));
+        int n = db.update("UPDATE DI_SQL_RULE SET ENABLED=NVL(?, ENABLED), SEVERITY=NVL(?, SEVERITY), PARAMS=NVL(?, PARAMS), "
+                + "UPDATED_BY=?, UPDATED_AT=SYSTIMESTAMP WHERE RULE_CODE=? AND SCOPE_TYPE=? AND SCOPE_VALUE=?",
+                enabled, severity, paramsJson, username, code, scopeType, scopeValue);
+        if (n == 0) {
+            db.update("INSERT INTO DI_SQL_RULE (RULE_CODE, RULE_NAME, CATEGORY, SCOPE_TYPE, SCOPE_VALUE, ENABLED, SEVERITY, PARAMS, DESCRIPTION, UPDATED_BY) "
+                            + "VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)", code, global.get("RULE_NAME"), global.get("CATEGORY"), scopeType, scopeValue,
+                    enabled, severity, paramsJson, scopeType + " 覆盖", username);
+        }
+        reload();
+    }
+
+    public void delete(long ruleId) {
+        Map<String, Object> r = db.one("SELECT SCOPE_TYPE FROM DI_SQL_RULE WHERE RULE_ID=?", ruleId);
+        if (r == null) {
+            throw BizException.notFound("规则不存在");
+        }
+        if ("GLOBAL".equals(r.get("SCOPE_TYPE"))) {
+            throw BizException.badRequest("全局规则不能删除，可设置为停用");
+        }
+        db.update("DELETE FROM DI_SQL_RULE WHERE RULE_ID=?", ruleId);
+        reload();
+    }
+}
diff --git a/dbops-server/src/main/java/com/dbops/sqlinsight/rules/RuntimeRuleEngine.java b/dbops-server/src/main/java/com/dbops/sqlinsight/rules/RuntimeRuleEngine.java
new file mode 100644
index 0000000..65be036
--- /dev/null
+++ b/dbops-server/src/main/java/com/dbops/sqlinsight/rules/RuntimeRuleEngine.java
@@ -0,0 +1,281 @@
+package com.dbops.sqlinsight.rules;
+
+import com.dbops.common.Values;
+import com.dbops.sqlinsight.collect.ActiveSession;
+import com.dbops.sqlinsight.collect.Counter;
+import com.dbops.sqlinsight.collect.Metric;
+import com.dbops.sqlinsight.collect.WindowRow;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.function.BiFunction;
+import java.util.function.Function;
+import java.util.function.Predicate;
+
+/**
+ * 运行态规则 P-001 ~ P-013（设计方案第 4 节）。纯函数，依赖通过 {@link Ctx} 注入，便于单测。
+ * <p>
+ * 依赖的指标不受支持时输出 SKIPPED（带原因），不会把“不支持”当作“没问题”。
+ */
+public final class RuntimeRuleEngine {
+
+    public record Hit(String code, String severity, long assetId, double value, double threshold, String detail,
+                      Map<String, Object> evidence) {
+    }
+
+    public record Skip(String code, String reason) {
+    }
+
+    public record Result(List<Hit> hits, List<Skip> skipped, List<String> evaluatedCodes) {
+    }
+
+    /**
+     * @param rule         (规则编码, 资产ID) → 生效配置
+     * @param supports     计数器是否受支持
+     * @param prevShares   资产此前窗口的 DB_TIME_SHARE（新→旧，不含本窗口）
+     * @param prevTmpDisk  资产此前窗口的 D_TMP_DISK（新→旧，不含本窗口）
+     * @param nativeCount  资产在本实例的原生 SQL ID 数
+     */
+    public record Ctx(BiFunction<String, Long, RuleConfigService.RuleSetting> rule, Predicate<Counter> supports,
+                      Function<Long, List<Double>> prevShares, Function<Long, List<Double>> prevTmpDisk,
+                      Function<Long, Long> nativeCount) {
+    }
+
+    public static final List<String> WINDOW_RULES = List.of("P-003", "P-004", "P-005", "P-006", "P-007", "P-008", "P-009", "P-011", "P-012", "P-013");
+    public static final List<String> SESSION_RULES = List.of("P-001", "P-002", "P-010");
+
+    private RuntimeRuleEngine() {
+    }
+
+    public static Result evaluateWindow(List<WindowRow> rows, Ctx ctx) {
+        List<Hit> hits = new ArrayList<>();
+        Map<String, Skip> skipped = new LinkedHashMap<>();
+        List<String> evaluated = new ArrayList<>();
+        // 能力判断（实例级，一条规则一个 SKIPPED）
+        Map<String, String> unsupported = new LinkedHashMap<>();
+        need(unsupported, ctx, "P-003", Counter.ELAPSED_MS);
+        need(unsupported, ctx, "P-004", Counter.CPU_MS);
+        need(unsupported, ctx, "P-005", Counter.LOGICAL_READS);
+        need(unsupported, ctx, "P-007", Counter.ELAPSED_MS);
+        need(unsupported, ctx, "P-008", Counter.ROWS_EXAMINED, Counter.ROWS_RETURNED);
+        need(unsupported, ctx, "P-011", Counter.ERRORS);
+        need(unsupported, ctx, "P-012", Counter.TMP_DISK);
+        if (!ctx.supports().test(Counter.NO_INDEX) && !ctx.supports().test(Counter.LOGICAL_READS)
+                && !ctx.supports().test(Counter.ROWS_EXAMINED)) {
+            unsupported.put("P-009", "源库不提供无索引标记、扫描行数或逻辑读");
+        }
+        for (String code : WINDOW_RULES) {
+            if (!ctx.rule().apply(code, null).enabled()) {
+                continue;
+            }
+            if (unsupported.containsKey(code)) {
+                skipped.put(code, new Skip(code, unsupported.get(code)));
+            } else {
+                evaluated.add(code);
+            }
+        }
+        for (WindowRow r : rows) {
+            long a = r.assetId;
+            double exec = r.d(Counter.EXEC);
+            for (String code : evaluated) {
+                RuleConfigService.RuleSetting s = ctx.rule().apply(code, a);
+                if (!s.enabled()) {
+                    continue;
+                }
+                String sev = s.severity() == null ? "WARNING" : s.severity();
+                switch (code) {
+                    case "P-003" -> threshold(hits, s, sev, r, Metric.AVG_ELAPSED_MS, "avgElapsedMs", 3000, exec,
+                            "窗口平均耗时 %.0f ms ≥ %.0f ms");
+                    case "P-004" -> threshold(hits, s, sev, r, Metric.CPU_PER_EXEC_MS, "cpuPerExecMs", 2000, exec,
+                            "单次 CPU %.0f ms ≥ %.0f ms");
+                    case "P-005" -> threshold(hits, s, sev, r, Metric.LOGICAL_READS_PER_EXEC, "logicalReadsPerExec", 100000, exec,
+                            "单次逻辑读 %.0f ≥ %.0f");
+                    case "P-006" -> {
+                        Double v = r.m(Metric.EXEC_PER_MIN);
+                        double th = s.p("execPerMin", 10000);
+                        if (v != null && v >= th) {
+                            hits.add(new Hit(code, sev, a, v, th, String.format("每分钟执行 %.0f 次 ≥ %.0f", v, th), ev(r)));
+                        }
+                    }
+                    case "P-007" -> {
+                        Double v = r.m(Metric.DB_TIME_SHARE);
+                        double th = s.p("dbTimeShare", 0.2);
+                        int need = (int) s.p("consecutive", 3);
+                        if (v != null && v >= th && consecutive(ctx.prevShares().apply(a), th, need - 1)) {
+                            hits.add(new Hit(code, sev, a, v, th, String.format("DB Time 占比 %.1f%% ≥ %.0f%%，连续 %d 个窗口", v * 100, th * 100, need), ev(r)));
+                        }
+                    }
+                    case "P-008" -> {
+                        Double ratio = r.m(Metric.SCAN_RATIO);
+                        Double rows1 = r.m(Metric.ROWS_EXAMINED_PER_EXEC);
+                        double thR = s.p("scanRatio", 1000);
+                        double thRows = s.p("rowsExaminedPerExec", 10000);
+                        if (ratio != null && rows1 != null && ratio >= thR && rows1 >= thRows) {
+                            hits.add(new Hit(code, sev, a, ratio, thR, String.format("扫描/返回比 %.0f ≥ %.0f，单次扫描 %.0f 行", ratio, thR, rows1), ev(r)));
+                        }
+                    }
+                    case "P-009" -> noIndex(hits, s, sev, r, ctx);
+                    case "P-011" -> {
+                        Double rate = r.m(Metric.ERROR_RATE);
+                        double errs = r.d(Counter.ERRORS);
+                        double th = s.p("errorRate", 0.05);
+                        double minErr = s.p("minErrors", 5);
+                        if (rate != null && rate >= th && errs >= minErr) {
+                            hits.add(new Hit(code, sev, a, rate, th, String.format("错误率 %.1f%%（%.0f 次）≥ %.0f%%", rate * 100, errs, th * 100), ev(r)));
+                        }
+                    }
+                    case "P-012" -> {
+                        double tmp = r.d(Counter.TMP_DISK);
+                        int need = (int) s.p("consecutive", 2);
+                        if (tmp > 0 && consecutive(ctx.prevTmpDisk().apply(a), 1e-9, need - 1)) {
+                            hits.add(new Hit(code, sev, a, tmp, 0, String.format("连续 %d 个窗口产生磁盘临时表/临时写（本窗口 %.0f）", need, tmp), ev(r)));
+                        }
+                    }
+                    case "P-013" -> {
+                        Long n = ctx.nativeCount().apply(a);
+                        double th = s.p("nativeIds", 100);
+                        if (n != null && n >= th) {
+                            hits.add(new Hit(code, sev, a, n, th, String.format("同一规范化 SQL 对应 %d 个原生 SQL ID（未使用绑定变量）", n), ev(r)));
+                        }
+                    }
+                    default -> {
+                    }
+                }
+            }
+        }
+        return new Result(hits, new ArrayList<>(skipped.values()), evaluated);
+    }
+
+    private static void need(Map<String, String> out, Ctx ctx, String code, Counter... counters) {
+        for (Counter c : counters) {
+            if (!ctx.supports().test(c)) {
+                out.put(code, "源库不提供 " + c.capability() + " 统计");
+                return;
+            }
+        }
+    }
+
+    private static void threshold(List<Hit> hits, RuleConfigService.RuleSetting s, String sev, WindowRow r, Metric m, String key,
+                                  double def, double exec, String fmt) {
+        Double v = r.m(m);
+        double th = s.p(key, def);
+        if (v != null && v >= th && exec >= s.p("minExec", 1)) {
+            hits.add(new Hit(s.code(), sev, r.assetId, v, th, String.format(fmt, v, th), ev(r)));
+        }
+    }
+
+    private static void noIndex(List<Hit> hits, RuleConfigService.RuleSetting s, String sev, WindowRow r, Ctx ctx) {
+        double th = s.p("rowsPerExec", 10000);
+        double noIdx = r.d(Counter.NO_INDEX);
+        Double rowsPer = r.m(Metric.ROWS_EXAMINED_PER_EXEC);
+        if (ctx.supports().test(Counter.NO_INDEX)) {
+            if (noIdx > 0 && rowsPer != null && rowsPer >= th) {
+                hits.add(new Hit("P-009", sev, r.assetId, rowsPer, th, String.format("未使用索引执行 %.0f 次，单次扫描 %.0f 行", noIdx, rowsPer), ev(r)));
+            }
+            return;
+        }
+        // 无“无索引标记”的库（Oracle/PG/达梦/SQLServer）：以单次扫描行数或单次逻辑读近似
+        Double lr = r.m(Metric.LOGICAL_READS_PER_EXEC);
+        Double v = rowsPer != null ? rowsPer : lr;
+        if (v != null && v >= th) {
+            hits.add(new Hit("P-009", sev, r.assetId, v, th, String.format("疑似未走索引：单次%s %.0f ≥ %.0f（近似判断，以执行计划为准）",
+                    rowsPer != null ? "扫描行数" : "逻辑读", v, th), ev(r)));
+        }
+    }
+
+    /** prev（新→旧）的前 n 个都 ≥ th */
+    static boolean consecutive(List<Double> prev, double th, int n) {
+        if (n <= 0) {
+            return true;
+        }
+        if (prev == null || prev.size() < n) {
+            return false;
+        }
+        for (int i = 0; i < n; i++) {
+            Double v = prev.get(i);
+            if (v == null || v.isNaN() || v < th) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    private static Map<String, Object> ev(WindowRow r) {
+        Map<String, Object> m = new LinkedHashMap<>();
+        m.put("planHash", r.cur.planHash());
+        m.put("nativeId", r.cur.nativeId());
+        m.put("exec", r.d(Counter.EXEC));
+        for (Map.Entry<Metric, Double> e : r.metrics.entrySet()) {
+            m.put(e.getKey().key, Values.round(e.getValue(), 4));
+        }
+        return m;
+    }
+
+    // ------------------------------------------------------------------ 活动会话规则
+
+    /** 会话命中：key 用于“连续 N 次采样”判断（同一会话同一 SQL） */
+    public record SessionHit(String code, String severity, long assetId, String sessionKey, double value, double threshold,
+                             String detail, Map<String, Object> evidence) {
+    }
+
+    /**
+     * @param assetOf     会话 → 资产 ID（无法识别 SQL 时返回 0）
+     * @param consecutive (规则编码|会话键) → 本次之前已连续命中的次数（调用方维护）
+     */
+    public static List<SessionHit> evaluateSessions(List<ActiveSession> sessions, Function<ActiveSession, Long> assetOf,
+                                                    BiFunction<String, Long, RuleConfigService.RuleSetting> rule,
+                                                    Function<String, Integer> consecutive) {
+        List<SessionHit> out = new ArrayList<>();
+        for (ActiveSession s : sessions) {
+            long a = assetOf.apply(s);
+            String sk = s.sessionId() + "|" + (s.nativeId() != null ? s.nativeId() : String.valueOf(a));
+            Map<String, Object> ev = new LinkedHashMap<>();
+            ev.put("session", s.sessionId());
+            ev.put("runSec", Values.round(s.runSec(), 1));
+            ev.put("waitEvent", s.waitEvent());
+            ev.put("waitSec", Values.round(s.waitSec(), 1));
+            ev.put("blocker", s.blockingSession());
+            ev.put("sql", Values.truncate(s.sqlText(), 300));
+            // P-002 先判，命中 P-002 不再报 P-001
+            boolean longHit = false;
+            RuleConfigService.RuleSetting p2 = rule.apply("P-002", a);
+            if (p2.enabled()) {
+                double th = p2.p("runSec", 10);
+                int need = (int) p2.p("consecutive", 2);
+                if (s.runSec() >= th && consecutive.apply("P-002|" + sk) + 1 >= need) {
+                    out.add(new SessionHit("P-002", sevOr(p2, "CRITICAL"), a, sk, s.runSec(), th,
+                            String.format("会话 %s 运行 %.0f 秒 ≥ %.0f 秒", s.sessionId(), s.runSec(), th), ev));
+                    longHit = true;
+                } else if (s.runSec() >= th) {
+                    out.add(new SessionHit("P-002", null, a, sk, s.runSec(), th, null, ev));   // 计数用，不落问题
+                }
+            }
+            RuleConfigService.RuleSetting p1 = rule.apply("P-001", a);
+            if (p1.enabled() && !longHit) {
+                double th = p1.p("runSec", 3);
+                int need = (int) p1.p("consecutive", 2);
+                if (s.runSec() >= th) {
+                    boolean ok = consecutive.apply("P-001|" + sk) + 1 >= need;
+                    out.add(new SessionHit("P-001", ok ? sevOr(p1, "WARNING") : null, a, sk, s.runSec(), th,
+                            ok ? String.format("会话 %s 运行 %.0f 秒 ≥ %.0f 秒", s.sessionId(), s.runSec(), th) : null, ev));
+                }
+            }
+            RuleConfigService.RuleSetting p10 = rule.apply("P-010", a);
+            if (p10.enabled() && s.lockWait()) {
+                double th = p10.p("waitSec", 10);
+                if (s.waitSec() >= th || s.blockingSession() != null && s.runSec() >= th) {
+                    out.add(new SessionHit("P-010", sevOr(p10, "CRITICAL"), a, sk, Math.max(s.waitSec(), s.runSec()), th,
+                            String.format("会话 %s 锁等待 %.0f 秒%s", s.sessionId(), Math.max(s.waitSec(), s.runSec()),
+                                    s.blockingSession() != null ? "，阻塞者 " + s.blockingSession() : ""), ev));
+                }
+            }
+        }
+        return out;
+    }
+
+    private static String sevOr(RuleConfigService.RuleSetting s, String def) {
+        return s.severity() == null ? def : s.severity();
+    }
+}
diff --git a/dbops-server/src/main/java/com/dbops/sqlinsight/store/AlertBridge.java b/dbops-server/src/main/java/com/dbops/sqlinsight/store/AlertBridge.java
new file mode 100644
index 0000000..0555a7a
--- /dev/null
+++ b/dbops-server/src/main/java/com/dbops/sqlinsight/store/AlertBridge.java
@@ -0,0 +1,76 @@
+package com.dbops.sqlinsight.store;
+
+import com.dbops.alert.AlertPolicyService;
+import com.dbops.common.Db;
+import com.dbops.common.Values;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.stereotype.Component;
+
+import java.util.Map;
+
+/**
+ * SQL 洞察 → 告警中心（ALERT_RECORD）。挂在 ALERT_RULE 的「SQL问题」「SQL异常波动」两条规则下：
+ * 规则停用即不再推送；生成后走现有静默/抑制/聚合策略；事件恢复时自动恢复告警。
+ * 取代原来写 FAULT_EXEC_LOG 的做法（那条路径进不了告警中心）。
+ */
+@Component
+public class AlertBridge {
+
+    public static final String RULE_PROBLEM = "SQL问题";
+    public static final String RULE_ANOMALY = "SQL异常波动";
+
+    private static final Logger log = LoggerFactory.getLogger(AlertBridge.class);
+
+    private final Db db;
+    private final AlertPolicyService policies;
+
+    public AlertBridge(Db db, AlertPolicyService policies) {
+        this.db = db;
+        this.policies = policies;
+    }
+
+    /** @return ALERT_ID；规则不存在/停用返回 null */
+    public Long fire(String ruleName, long instanceId, String instanceName, String severity, String content) {
+        try {
+            Map<String, Object> rule = db.one("SELECT RULE_ID, SEVERITY FROM ALERT_RULE WHERE RULE_NAME=? AND NVL(ENABLED, 1) = 1 "
+                    + "FETCH FIRST 1 ROWS ONLY", ruleName);
+            if (rule == null) {
+                return null;
+            }
+            String level = switch (Values.str(severity, "WARNING").toUpperCase()) {
+                // ERROR 原来落到 default 映射为 P3，比 WARNING(P2) 还低
+                case "CRITICAL" -> "P1";
+                case "ERROR", "HIGH" -> "P1".equals(Values.str(rule.get("SEVERITY"))) ? "P1" : "P2";
+                case "WARNING" -> Values.str(rule.get("SEVERITY"), "P2");
+                default -> "P3";
+            };
+            Long id = db.insertReturningId("INSERT INTO ALERT_RECORD (RULE_ID, RULE_NAME, INSTANCE_ID, INSTANCE_NAME, SEVERITY, CONTENT, STATUS, TRIGGER_TIME) "
+                            + "VALUES (?, ?, ?, ?, ?, ?, 'OPEN', SYSTIMESTAMP)", "ALERT_ID",
+                    rule.get("RULE_ID"), ruleName, instanceId, instanceName, level, Values.truncate(content, 1024));
+            if (id != null) {
+                policies.applyForNewAlert(id);
+            }
+            return id;
+        } catch (Exception e) {
+            log.warn("[sqlinsight] fire alert failed: {}", e.getMessage());
+            return null;
+        }
+    }
+
+    public void resolve(Object alertId, String detail) {
+        Long id = Values.toLong(alertId);
+        if (id == null) {
+            return;
+        }
+        try {
+            int n = db.update("UPDATE ALERT_RECORD SET STATUS='RESOLVED', RESOLVE_TIME=SYSTIMESTAMP, RESOLVE_BY='SYSTEM', DETAIL=? "
+                    + "WHERE ALERT_ID=? AND STATUS <> 'RESOLVED'", Values.truncate(detail, 1000), id);
+            if (n > 0) {
+                policies.releaseSuppressedChildren(id);
+            }
+        } catch (Exception e) {
+            log.warn("[sqlinsight] resolve alert {} failed: {}", id, e.getMessage());
+        }
+    }
+}
diff --git a/dbops-server/src/main/java/com/dbops/sqlinsight/store/AssetService.java b/dbops-server/src/main/java/com/dbops/sqlinsight/store/AssetService.java
new file mode 100644
index 0000000..2596eb0
--- /dev/null
+++ b/dbops-server/src/main/java/com/dbops/sqlinsight/store/AssetService.java
@@ -0,0 +1,177 @@
+package com.dbops.sqlinsight.store;
+
+import com.dbops.common.Db;
+import com.dbops.common.Values;
+import com.dbops.sqlinsight.ast.Finding;
+import com.dbops.sqlinsight.ast.SqlAstService;
+import com.dbops.sqlinsight.ast.StaticRuleEngine;
+import com.dbops.sqlinsight.rules.RuleConfigService;
+import org.springframework.stereotype.Service;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * SQL 资产（DI_SQL_ASSET / DI_SQL_ASSET_SOURCE）：全平台唯一的 SQL 标识。
+ * 采集、审核、工单、AI 优化记录都通过 ASSET_ID 关联，替代原来三套互不相认的 hash。
+ */
+@Service
+public class AssetService {
+
+    public record AssetRef(long assetId, boolean core, String bizType, String fingerprint, boolean created) {
+    }
+
+    private static final int CACHE_MAX = 200_000;
+
+    private final Db db;
+    private final SqlAstService ast;
+    private final RuleConfigService rules;
+    /** 方言族|schema|指纹 → 资产 */
+    private final Map<String, AssetRef> byFingerprint = lru(CACHE_MAX);
+    /** 实例|原生ID → 资产（避免每分钟重复解析同一 SQL） */
+    private final Map<String, AssetRef> byNative = lru(CACHE_MAX);
+    /** 已写入 DI_SQL_ASSET_SOURCE 的组合 → 上次写入时间 */
+    private final Map<String, Long> sourceTouched = lru(CACHE_MAX);
+    private final Map<Long, Long> lastSeenTouched = lru(CACHE_MAX);
+
+    public AssetService(Db db, SqlAstService ast, RuleConfigService rules) {
+        this.db = db;
+        this.ast = ast;
+        this.rules = rules;
+    }
+
+    private static <K, V> Map<K, V> lru(int max) {
+        return java.util.Collections.synchronizedMap(new LinkedHashMap<>(1024, 0.75f, true) {
+            @Override
+            protected boolean removeEldestEntry(Map.Entry<K, V> e) {
+                return size() > max;
+            }
+        });
+    }
+
+    /** 采集链路：按实例+原生 ID 命中缓存，未命中才解析 */
+    public AssetRef resolveNative(long instanceId, String nativeId, String platformType, String schema, String sqlText) {
+        String nk = instanceId + "|" + nativeId;
+        AssetRef r = byNative.get(nk);
+        if (r != null) {
+            return r;
+        }
+        r = resolve(ast.analyze(sqlText, platformType, schema), sqlText);
+        byNative.put(nk, r);
+        return r;
+    }
+
+    public AssetRef resolve(SqlAstService.SqlAnalysis a, String sample) {
+        String key = a.dbFamily() + "|" + a.schema() + "|" + a.fingerprint();
+        AssetRef r = byFingerprint.get(key);
+        if (r != null) {
+            return r;
+        }
+        Map<String, Object> row = db.one("SELECT ASSET_ID, IS_CORE, BIZ_TYPE FROM DI_SQL_ASSET WHERE DB_TYPE=? AND SCHEMA_NAME=? AND FINGERPRINT=?",
+                a.dbFamily(), a.schema(), a.fingerprint());
+        boolean created = false;
+        if (row == null) {
+            try {
+                db.update("INSERT INTO DI_SQL_ASSET (DB_TYPE, SCHEMA_NAME, FINGERPRINT, NORMALIZED_SQL, SAMPLE_SQL, STMT_TYPE, TABLES, PARSE_STATUS) "
+                                + "VALUES (?, ?, ?, ?, ?, ?, ?, ?)", a.dbFamily(), a.schema(), a.fingerprint(), a.normalized(),
+                        Values.truncate(sample, 32000), a.stmtType(), Values.truncate(String.join(",", a.tables()), 2000),
+                        a.parsed() ? "PARSED" : "FALLBACK");
+                created = true;
+            } catch (Exception e) {
+                if (!Db.isUniqueViolation(e)) {
+                    throw e;
+                }
+            }
+            row = db.one("SELECT ASSET_ID, IS_CORE, BIZ_TYPE FROM DI_SQL_ASSET WHERE DB_TYPE=? AND SCHEMA_NAME=? AND FINGERPRINT=?",
+                    a.dbFamily(), a.schema(), a.fingerprint());
+        }
+        r = new AssetRef(Values.toLong(row.get("ASSET_ID"), 0), Values.toInt(row.get("IS_CORE"), 0) == 1,
+                Values.str(row.get("BIZ_TYPE")), a.fingerprint(), created);
+        if (created) {
+            analyzeStatic(r.assetId(), a);
+        }
+        byFingerprint.put(key, r);
+        return r;
+    }
+
+    /** 新资产落库时做一次静态分析（无实例元数据；S-005/S-006 需元数据的部分在审核时补充） */
+    public StaticRuleEngine.Result analyzeStatic(long assetId, SqlAstService.SqlAnalysis a) {
+        StaticRuleEngine.Result res = StaticRuleEngine.analyze(a,
+                rules.staticView(new RuleConfigService.Scope(assetId, null, null, a.dbFamily())), null);
+        List<Map<String, Object>> findings = new ArrayList<>();
+        String risk = "NONE";
+        for (Finding f : res.findings()) {
+            findings.add(f.toMap());
+            risk = maxSeverity(risk, f.severity());
+        }
+        String status = a.parsed() ? "ANALYZED" : "UNANALYZED";
+        db.updateQuietly("UPDATE DI_SQL_ASSET SET STATIC_STATUS=?, STATIC_RESULT=?, STATIC_RISK=? WHERE ASSET_ID=?",
+                status, Json.write(Map.of("findings", findings, "skipped", res.skipped().stream().map(Finding.Skipped::toMap).toList())),
+                risk, assetId);
+        return res;
+    }
+
+    public static String maxSeverity(String a, String b) {
+        return rank(b) > rank(a) ? b : a;
+    }
+
+    public static int rank(String s) {
+        if (s == null) {
+            return 0;
+        }
+        return switch (s.toUpperCase()) {
+            case "CRITICAL" -> 4;
+            case "ERROR" -> 3;
+            case "WARNING", "WARN" -> 2;
+            case "INFO" -> 1;
+            default -> 0;
+        };
+    }
+
+    /** 批量登记原生标识（30 分钟内同一组合只写一次） */
+    public void touchSources(long instanceId, Map<Long, List<String>> nativeIds) {
+        long now = System.currentTimeMillis();
+        List<Object[]> batch = new ArrayList<>();
+        for (Map.Entry<Long, List<String>> e : nativeIds.entrySet()) {
+            for (String nid : e.getValue()) {
+                String k = e.getKey() + "|" + instanceId + "|" + nid;
+                Long t = sourceTouched.get(k);
+                if (t == null || now - t > 1800_000L) {
+                    batch.add(new Object[]{e.getKey(), instanceId, nid});
+                    sourceTouched.put(k, now);
+                }
+            }
+        }
+        if (!batch.isEmpty()) {
+            db.jdbc().batchUpdate("MERGE INTO DI_SQL_ASSET_SOURCE t USING (SELECT ? AS A, ? AS I, ? AS N FROM DUAL) s "
+                    + "ON (t.ASSET_ID = s.A AND t.INSTANCE_ID = s.I AND t.NATIVE_ID = s.N) "
+                    + "WHEN MATCHED THEN UPDATE SET LAST_SEEN = SYSTIMESTAMP "
+                    + "WHEN NOT MATCHED THEN INSERT (ASSET_ID, INSTANCE_ID, NATIVE_ID) VALUES (s.A, s.I, s.N)", batch);
+        }
+    }
+
+    /** 资产 LAST_SEEN（10 分钟内只写一次） */
+    public void touchLastSeen(Collection<Long> assetIds) {
+        long now = System.currentTimeMillis();
+        List<Object[]> batch = new ArrayList<>();
+        for (Long id : assetIds) {
+            Long t = lastSeenTouched.get(id);
+            if (t == null || now - t > 600_000L) {
+                batch.add(new Object[]{id});
+                lastSeenTouched.put(id, now);
+            }
+        }
+        if (!batch.isEmpty()) {
+            db.jdbc().batchUpdate("UPDATE DI_SQL_ASSET SET LAST_SEEN = SYSTIMESTAMP WHERE ASSET_ID = ?", batch);
+        }
+    }
+
+    /** 人工修改核心标记/业务类型后清缓存 */
+    public void invalidate() {
+        byFingerprint.clear();
+        byNative.clear();
+    }
+}
diff --git a/dbops-server/src/main/java/com/dbops/sqlinsight/store/InstanceDirectory.java b/dbops-server/src/main/java/com/dbops/sqlinsight/store/InstanceDirectory.java
new file mode 100644
