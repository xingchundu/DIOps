new file mode 100644
index 0000000..47df529
--- /dev/null
+++ b/backend/src/utils/secrets.js
@@ -0,0 +1,58 @@
+/**
+ * 被管库密码 / SSH 凭据的加解密（与 Java com.dbops.monitor.Secrets 格式一致）。
+ *
+ *   新格式：AESGCM:v1:<base64(iv[12] || ciphertext || tag[16])>，AES-256-GCM
+ *   旧格式：Base64（可带 ENCRYPTED: 前缀）——只读兼容，Java 启动时会把旧格式逐步改写为新格式
+ *
+ * 密钥：环境变量 DBOPS_SECRET_KEY（任意长度口令，经 SHA-256 得到 32 字节密钥）。
+ * 未配置时无法解密新格式数据，加密时退回旧格式并打印警告（仅用于开发环境）。
+ */
+const crypto = require('crypto');
+
+const PREFIX = 'AESGCM:v1:';
+let warned = false;
+
+function key() {
+  const raw = process.env.DBOPS_SECRET_KEY;
+  if (!raw || !String(raw).trim()) return null;
+  return crypto.createHash('sha256').update(String(raw).trim(), 'utf8').digest();
+}
+
+function decrypt(enc) {
+  if (enc == null) return '';
+  const s = String(enc).trim();
+  if (!s) return '';
+  if (s.startsWith(PREFIX)) {
+    const k = key();
+    if (!k) throw new Error('凭据已加密，但未配置 DBOPS_SECRET_KEY，无法解密');
+    const buf = Buffer.from(s.slice(PREFIX.length), 'base64');
+    const iv = buf.subarray(0, 12);
+    const tag = buf.subarray(buf.length - 16);
+    const ct = buf.subarray(12, buf.length - 16);
+    const d = crypto.createDecipheriv('aes-256-gcm', k, iv);
+    d.setAuthTag(tag);
+    return Buffer.concat([d.update(ct), d.final()]).toString('utf8');
+  }
+  const b64 = s.replace(/^ENCRYPTED:/i, '');
+  // 旧数据：Base64；不是合法 Base64 时按明文处理
+  if (/^[A-Za-z0-9+/=\s]+$/.test(b64)) return Buffer.from(b64, 'base64').toString('utf8');
+  return b64;
+}
+
+function encrypt(plain) {
+  if (plain == null || String(plain) === '') return null;
+  const k = key();
+  if (!k) {
+    if (!warned) {
+      warned = true;
+      console.warn('[secrets] 未配置 DBOPS_SECRET_KEY，凭据仅做 Base64 编码保存（不安全，生产环境必须配置）');
+    }
+    return Buffer.from(String(plain), 'utf8').toString('base64');
+  }
+  const iv = crypto.randomBytes(12);
+  const c = crypto.createCipheriv('aes-256-gcm', k, iv);
+  const ct = Buffer.concat([c.update(String(plain), 'utf8'), c.final()]);
+  return PREFIX + Buffer.concat([iv, ct, c.getAuthTag()]).toString('base64');
+}
+
+module.exports = { decrypt, encrypt, PREFIX };
diff --git a/backend/src/utils/sqlAuditRecord.js b/backend/src/utils/sqlAuditRecord.js
new file mode 100644
index 0000000..52e227f
--- /dev/null
+++ b/backend/src/utils/sqlAuditRecord.js
@@ -0,0 +1,95 @@
+/**
+ * SQL 审核记录的公共小工具（SQL 审核工单 / 治理中心 / 发布预审 / 故障自愈 共用）。
+ * 审核本身已统一到 Java（utils/sqlInsightClient.js），这里只负责落库与 JSON 处理。
+ *
+ * 原 services/sqlGovernanceInstanceCheck.js（540 行：5 库连接、表存在性、EXPLAIN、全表扫描识别）已删除，
+ * 由 Java ExplainService 取代；本文件只保留其中与落库相关的 toPlainJson / buildPublishReviewResult。
+ */
+const crypto = require('crypto');
+const oracledb = require('oracledb');
+const db = require('../config/db');
+
+/** 去除 Oracle 驱动等不可 JSON 序列化的对象，避免 circular structure 错误 */
+function toPlainJson(value) {
+  const seen = new WeakSet();
+  return JSON.parse(JSON.stringify(value === undefined ? null : value, (key, val) => {
+    if (val != null && typeof val === 'object') {
+      if (seen.has(val)) return undefined;
+      seen.add(val);
+      const cn = val.constructor?.name || '';
+      if (/ConnectDescription|ConnOption|^Connection$|^Pool$/i.test(cn)) return undefined;
+    }
+    if (typeof val === 'bigint') return String(val);
+    if (val instanceof Date) return val.toISOString();
+    return val;
+  }));
+}
+
+/** 推送发布时合并审核 JSON（附带全表扫描优化建议） */
+function buildPublishReviewResult(auditResultRaw) {
+  let base = {};
+  try {
+    base = typeof auditResultRaw === 'string' ? JSON.parse(auditResultRaw) : (auditResultRaw || {});
+  } catch {
+    base = {};
+  }
+  const ic = base.instanceCheck || {};
+  const hints = [...(base.hints || [])];
+  const extra = [...(ic.optimizeSuggestions || [])];
+  if (ic.fullScanDetected) {
+    if (!hints.some((h) => /全表扫描/.test(h))) {
+      hints.unshift('【执行计划告警】检测到全表扫描，发布审核请重点关注索引与过滤条件');
+    }
+    for (const s of extra) {
+      if (!hints.includes(s)) hints.push(s);
+    }
+  }
+  return JSON.stringify(toPlainJson({
+    ...base,
+    hints,
+    fullScanDetected: !!ic.fullScanDetected,
+    optimizeSuggestions: extra,
+    pushedFromGovernance: true,
+    pushedAt: new Date().toISOString(),
+  }));
+}
+
+/** SQL_HASH 列：优先用统一指纹（Java 返回的 fingerprint），兼容旧数据时退回文本 hash */
+function auditHash(sqlText, result) {
+  if (result && result.fingerprint) return String(result.fingerprint);
+  return crypto.createHash('sha256').update(String(sqlText || '').trim().replace(/\s+/g, ' ')).digest('hex').substring(0, 32);
+}
+
+/**
+ * 写 SQL_AUDIT_RECORD（附 ASSET_ID），返回 AUDIT_ID。
+ * 兼容未执行 migration_sql_insight.sql 的库：缺 ASSET_ID / SOURCE 列时逐级降级。
+ */
+async function insertAuditRecord({ instanceId, sqlText, result, source = 'MANUAL', userId }) {
+  const hash = auditHash(sqlText, result);
+  const json = JSON.stringify(toPlainJson(result));
+  const assetId = result && result.assetId != null ? Number(result.assetId) : null;
+  const base = { inst: instanceId || null, sql: sqlText, hash, res: json, score: result?.score ?? null, risk: result?.risk || null, uid: userId || null };
+  const variants = [
+    [`INSERT INTO SQL_AUDIT_RECORD (INSTANCE_ID,SQL_TEXT,SQL_HASH,AUDIT_RESULT,SCORE,RISK_LEVEL,SOURCE,SUBMITTED_BY,ASSET_ID)
+      VALUES (:inst,:sql,:hash,:res,:score,:risk,:src,:uid,:asset) RETURNING AUDIT_ID INTO :id`, { ...base, src: source, asset: assetId }],
+    [`INSERT INTO SQL_AUDIT_RECORD (INSTANCE_ID,SQL_TEXT,SQL_HASH,AUDIT_RESULT,SCORE,RISK_LEVEL,SOURCE,SUBMITTED_BY)
+      VALUES (:inst,:sql,:hash,:res,:score,:risk,:src,:uid) RETURNING AUDIT_ID INTO :id`, { ...base, src: source }],
+    [`INSERT INTO SQL_AUDIT_RECORD (INSTANCE_ID,SQL_TEXT,SQL_HASH,AUDIT_RESULT,SCORE,RISK_LEVEL,SUBMITTED_BY)
+      VALUES (:inst,:sql,:hash,:res,:score,:risk,:uid) RETURNING AUDIT_ID INTO :id`, { ...base }],
+  ];
+  let lastErr;
+  for (const [sql, binds] of variants) {
+    try {
+      const r = await db.execute(sql, { ...binds, id: { dir: oracledb.BIND_OUT, type: oracledb.NUMBER } });
+      const raw = r?.outBinds?.id;
+      const v = Array.isArray(raw) ? raw[0] : raw;
+      return v == null ? null : Number(v);
+    } catch (e) {
+      lastErr = e;
+      if (!/ORA-00904/.test(String(e.message))) throw e;   // 只有“列不存在”才降级
+    }
+  }
+  throw lastErr;
+}
+
+module.exports = { toPlainJson, buildPublishReviewResult, insertAuditRecord, auditHash };
diff --git a/backend/src/utils/sqlInsightClient.js b/backend/src/utils/sqlInsightClient.js
new file mode 100644
index 0000000..db1272a
--- /dev/null
+++ b/backend/src/utils/sqlInsightClient.js
@@ -0,0 +1,111 @@
+/**
+ * SQL 洞察客户端：Node 侧所有 SQL 解析 / 审核 / 执行计划 / 采集 统一调用 Java dbops-server（/api/sql-insight）。
+ *
+ * 取代原先 Node 内的 4 套正则审核、2 份 isDangerous、540 行 sqlGovernanceInstanceCheck，
+ * 保证同一条 SQL 在“SQL 审核 / 治理中心 / 发布预审 / 工作台 / AI 优化”得到同一结论。
+ *
+ * 鉴权：有用户请求时转发用户的 Authorization（权限与审计跟随真实用户）；
+ *       后台任务（故障自愈等）用 JWT_SECRET 签发 2 分钟有效的系统令牌（以一个启用的 ADMIN 账号身份）。
+ *
+ * 环境变量：JAVA_SERVER_URL（默认 http://127.0.0.1:3000，即 Java 网关端口）
+ */
+const db = require('../config/db');
+
+const BASE = String(process.env.JAVA_SERVER_URL || `http://127.0.0.1:${process.env.JAVA_SERVER_PORT || 3000}`).replace(/\/+$/, '');
+const TIMEOUT_MS = Number(process.env.SQL_INSIGHT_TIMEOUT_MS || 60000);
+
+// 按身份分别缓存（原先单一缓存：先以操作人身份调用后，之后的“系统调用”会沿用该操作人的身份）
+const _userCache = new Map();
+async function systemAuth(operatorId) {
+  const key = operatorId ? `u${operatorId}` : 'admin';
+  let c = _userCache.get(key);
+  if (!c || Date.now() - c.at > 60000) {
+    const r = operatorId
+      ? await db.execute(`SELECT USER_ID, USERNAME, ROLE FROM SYS_USER WHERE USER_ID = :1 AND STATUS = 1`, [operatorId])
+      : await db.execute(`SELECT USER_ID, USERNAME, ROLE FROM SYS_USER WHERE ROLE = 'ADMIN' AND STATUS = 1 ORDER BY USER_ID FETCH FIRST 1 ROWS ONLY`, []);
+    if (!r.rows.length) throw new Error(operatorId ? `操作人 ${operatorId} 不存在或已禁用` : '没有可用于系统调用的启用 ADMIN 账号');
+    c = { user: r.rows[0], at: Date.now() };
+    _userCache.set(key, c);
+  }
+  const { signShortToken } = require('../middleware/auth');
+  return `Bearer ${signShortToken({ userId: c.user.USER_ID, username: c.user.USERNAME, role: c.user.ROLE })}`;
+}
+
+/**
+ * @param {object|null} req  Express 请求（取 Authorization）；后台任务传 null
+ * @returns data 字段；code != 200 时抛出 Error(msg)，err.code 为业务码
+ */
+async function call(req, method, path, body, { operatorId } = {}) {
+  const auth = req?.headers?.authorization || await systemAuth(operatorId);
+  const ctrl = new AbortController();
+  const timer = setTimeout(() => ctrl.abort(), TIMEOUT_MS);
+  try {
+    const resp = await fetch(`${BASE}/api/sql-insight${path}`, {
+      method,
+      headers: { 'Content-Type': 'application/json', Authorization: auth },
+      body: body === undefined ? undefined : JSON.stringify(body),
+      signal: ctrl.signal,
+    });
+    let json;
+    try { json = await resp.json(); } catch { json = { code: resp.status, msg: `HTTP ${resp.status}` }; }
+    if (json.code !== 200) {
+      const err = new Error(json.msg || `SQL 洞察服务返回 ${json.code}`);
+      err.code = json.code;
+      throw err;
+    }
+    return json.data;
+  } catch (e) {
+    if (e.name === 'AbortError') throw new Error(`SQL 洞察服务超时（${TIMEOUT_MS}ms）`);
+    if (e.code === undefined && /fetch failed|ECONNREFUSED/i.test(String(e.message) + String(e.cause?.code || ''))) {
+      const err = new Error(`SQL 洞察服务不可达（${BASE}）：${e.cause?.code || e.message}`);
+      err.unreachable = true;
+      throw err;
+    }
+    throw e;
+  } finally {
+    clearTimeout(timer);
+  }
+}
+
+/** 统一审核：返回 {issues, hints, score, risk, instanceCheck?, assetId?, runtime?, fingerprint, stmtType ...} */
+function audit(req, { sqlText, instanceId, dbType, schema, instanceCheck = true, linkAsset = true }, opts) {
+  return call(req, 'POST', '/audit', { sqlText, instanceId: instanceId || null, dbType, schema, instanceCheck, linkAsset }, opts);
+}
+
+/** 危险语句识别：返回 {types, dangerous} */
+function classify(req, sqlText, dbType) {
+  return call(req, 'POST', '/classify', { sqlText, dbType });
+}
+
+/** 执行计划：返回 {plan, issues, fullScanDetected, dbType} */
+function explain(req, instanceId, sqlText) {
+  return call(req, 'POST', '/explain', { instanceId, sqlText });
+}
+
+/** 基线锚点（发布成功 / 优化完成）：{assetId? | sqlText, dbType?, instanceId?, reason, note} */
+function anchor(req, body, opts) {
+  return call(req, 'POST', '/anchors', body, opts);
+}
+
+/** 变更窗口：{instanceId?, windowType, title, startTime?, endTime? | durationMinutes, source, refId} */
+function changeWindow(req, body, opts) {
+  return call(req, 'POST', '/change-windows', body, opts);
+}
+
+/** 即时采集：返回本轮摘要 + topProblems */
+function collectNow(req, instanceId, opts) {
+  return call(req, 'POST', `/collect/${Number(instanceId)}`, undefined, opts);
+}
+
+/** 审核结果中的 SQL 资产 ID（写入 SQL_AUDIT_RECORD / SQL_REVIEW_TICKET.ASSET_ID） */
+function assetIdOf(result) {
+  return result && result.assetId != null ? Number(result.assetId) : null;
+}
+
+/** 后台任务使用的系统账号 ID（启用的 ADMIN） */
+async function systemUserId() {
+  await systemAuth();
+  return _userCache.get('admin').user.USER_ID;
+}
+
+module.exports = { systemUserId, call, audit, classify, explain, anchor, changeWindow, collectNow, assetIdOf, BASE };
