+package com.dbops.sqlinsight.ast;
+
+import java.util.Set;
+
+/**
+ * 静态规则 S-005 / S-006 需要的元数据（索引列、字段类型）。返回 null 表示未知。
+ */
+public interface TableMetadata {
+
+    /** 表上所有索引包含的列（大写）；表不存在或无权限时返回 null */
+    Set<String> indexedColumns(String schema, String table);
+
+    /** 字段类型族：CHAR / NUMBER / DATE / OTHER；未知返回 null */
+    String columnTypeFamily(String schema, String table, String column);
+
+    /** 各索引的列（按索引内顺序，大写）；未知返回 null。索引建议用来判断是否已有可用索引 */
+    default java.util.List<java.util.List<String>> indexes(String schema, String table) {
+        return null;
+    }
+
+    /** 表的全部列（按定义顺序，大写）；未知返回 null。SELECT * 展开用 */
+    default java.util.List<String> columns(String schema, String table) {
+        return null;
+    }
+
+    /** 列是否 NOT NULL；未知返回 null。NOT IN → NOT EXISTS 只有两侧列都非空时才等价 */
+    default Boolean notNull(String schema, String table, String column) {
+        return null;
+    }
+
+    /** 表的估算行数（统计信息）；未知返回 null。小表不建议加索引 */
+    default Long rowCount(String schema, String table) {
+        return null;
+    }
+
+    TableMetadata NONE = new TableMetadata() {
+        @Override
+        public Set<String> indexedColumns(String schema, String table) {
+            return null;
+        }
+
+        @Override
+        public String columnTypeFamily(String schema, String table, String column) {
+            return null;
+        }
+    };
+}
diff --git a/dbops-server/src/main/java/com/dbops/sqlinsight/audit/ExplainService.java b/dbops-server/src/main/java/com/dbops/sqlinsight/audit/ExplainService.java
new file mode 100644
index 0000000..fa0d7f8
--- /dev/null
+++ b/dbops-server/src/main/java/com/dbops/sqlinsight/audit/ExplainService.java
@@ -0,0 +1,393 @@
+package com.dbops.sqlinsight.audit;
+
+import com.dbops.common.BizException;
+import com.dbops.common.Values;
+import com.dbops.monitor.CmdbInstance;
+import com.dbops.monitor.DbType;
+import com.dbops.monitor.TargetConnector;
+import com.dbops.monitor.TargetDb;
+import com.dbops.sqlinsight.ast.SqlAstService;
+import org.springframework.stereotype.Service;
+
+import java.sql.Connection;
+import java.sql.ResultSet;
+import java.sql.ResultSetMetaData;
+import java.sql.SQLException;
+import java.sql.Statement;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.regex.Pattern;
+
+/**
+ * 执行计划 + 目标实例检查（表存在性 / 可执行性 / 全表扫描）。
+ * 合并原 sql.js /explain（仅 Oracle）与 services/sqlGovernanceInstanceCheck.js（540 行，5 库）两套实现；
+ * 返回结构与原 instanceCheck 完全一致，前端与治理中心无需修改。
+ * <p>
+ * 安全：只接受单条语句（防止 PG/SQLServer 驱动多语句执行）；EXPLAIN 不带 ANALYZE，不会真正执行 DML。
+ */
+@Service
+public class ExplainService {
+
+    private static final Pattern ORA_FULL = Pattern.compile("TABLE\\s+ACCESS\\s+FULL|FULL\\s+TABLE\\s+SCAN", Pattern.CASE_INSENSITIVE);
+    private static final Pattern MY_FULL = Pattern.compile("\\|\\s*ALL\\s*\\||\"access_type\"\\s*:\\s*\"ALL\"|Seq Scan", Pattern.CASE_INSENSITIVE);
+    private static final Pattern PG_FULL = Pattern.compile("Seq Scan on", Pattern.CASE_INSENSITIVE);
+    private static final Pattern MS_SCAN = Pattern.compile("\\bTable Scan\\b", Pattern.CASE_INSENSITIVE);
+    private static final Pattern MS_SEEK = Pattern.compile("\\bIndex Seek\\b", Pattern.CASE_INSENSITIVE);
+
+    public static final List<String> FULL_SCAN_HINTS = List.of(
+            "执行计划存在全表扫描：请为 WHERE/JOIN 条件列创建或补齐索引",
+            "确认过滤条件是否命中索引，避免隐式类型转换导致索引失效",
+            "避免 SELECT *，仅查询必要列以降低回表与 IO",
+            "大表查询建议评估分区、覆盖索引或 SQL 改写（如 EXISTS 替代 IN）");
+
+    private final TargetConnector connector;
+    private final SqlAstService ast;
+
+    public ExplainService(TargetConnector connector, SqlAstService ast) {
+        this.connector = connector;
+        this.ast = ast;
+    }
+
+    public static boolean detectFullScan(String plan, String platformType) {
+        if (plan == null || plan.isBlank()) {
+            return false;
+        }
+        return switch (DbType.normalize(platformType)) {
+            case DbType.ORACLE, DbType.DAMENG -> ORA_FULL.matcher(plan).find();
+            case DbType.MYSQL, DbType.GOLDENDB -> MY_FULL.matcher(plan).find();
+            case DbType.POSTGRESQL, DbType.PANWEI -> PG_FULL.matcher(plan).find();
+            case DbType.SQLSERVER -> MS_SCAN.matcher(plan).find() && !MS_SEEK.matcher(plan).find();
+            default -> ORA_FULL.matcher(plan).find() || PG_FULL.matcher(plan).find();
+        };
+    }
+
+    static String clean(String sql) {
+        String s = sql == null ? "" : sql.trim();
+        while (s.endsWith(";")) {
+            s = s.substring(0, s.length() - 1).trim();
+        }
+        return s;
+    }
+
+    /** 拒绝多语句（解析失败时按去注释后的分号判断） */
+    void requireSingle(String sql, String platformType) {
+        SqlAstService.SqlAnalysis a = ast.analyze(sql, platformType, null);
+        if (a.parsed() ? a.statements().size() > 1 : SqlAstService.stripComments(sql).replaceAll("'(?:[^']|'')*'", "''").contains(";")) {
+            throw BizException.badRequest("一次只能分析一条 SQL 语句");
+        }
+    }
+
+    private static final java.util.Set<String> EXPLAINABLE = java.util.Set.of("SELECT", "INSERT", "UPDATE", "DELETE", "MERGE");
+    /** 以这些词开头的文本不拼到 EXPLAIN 后面：如 PG/磐维 "EXPLAIN " + "ANALYZE DELETE …" 会真正执行 DELETE */
+    private static final Pattern UNSAFE_HEAD = Pattern.compile("^\\s*(EXPLAIN|ANALYZE|ANALYSE|SET|EXEC|EXECUTE|CALL|BEGIN|DECLARE|DO|USE|PRAGMA|SHOWPLAN)\\b",
+            Pattern.CASE_INSENSITIVE);
+
+    /**
+     * 只对 SELECT / INSERT / UPDATE / DELETE / MERGE 取执行计划（SQL Server 只允许 SELECT）；
+     * 无法解析的语句只在首关键字是 SELECT/WITH 时放行。返回 null 表示允许，否则为拒绝原因。
+     */
+    String explainRejectReason(String sql, String platformType) {
+        String body = SqlAstService.stripComments(sql).trim();
+        if (UNSAFE_HEAD.matcher(body).find()) {
+            return "该语句类型不支持获取执行计划";
+        }
+        SqlAstService.SqlAnalysis a = ast.analyze(sql, platformType, null);
+        String type = a.parsed() ? a.stmtType() : (body.matches("(?is)^(SELECT|WITH)\\b.*") ? "SELECT" : "UNPARSED");
+        if (DbType.SQLSERVER.equals(DbType.normalize(platformType)) && !"SELECT".equals(type)) {
+            return "SQL Server 仅支持查询语句的执行计划";
+        }
+        if (!EXPLAINABLE.contains(type)) {
+            return "UNPARSED".equals(type) ? "语句无法解析，未获取执行计划" : "执行计划仅支持 SELECT / INSERT / UPDATE / DELETE / MERGE";
+        }
+        return null;
+    }
+
+    // ------------------------------------------------------------------ 执行计划
+
+    /** /api/sql/explain 兼容：{plan, issues:[{type, desc}], fullScanDetected, dbType} */
+    public Map<String, Object> explain(long instanceId, String sql) {
+        String text = clean(sql);
+        CmdbInstance inst = connector.fetch(instanceId);
+        requireSingle(text, inst.dbType());
+        String reject = explainRejectReason(text, inst.dbType());
+        if (reject != null) {
+            throw BizException.badRequest(reject);
+        }
+        try (TargetDb db = connector.open(inst)) {
+            String plan = runExplain(db, inst.dbType(), text);
+            List<Map<String, Object>> issues = new ArrayList<>();
+            if (detectFullScan(plan, inst.dbType())) {
+                issues.add(Map.of("type", "FULL_SCAN", "desc", "存在全表扫描，建议添加合适索引"));
+            }
+            if (plan.toUpperCase(Locale.ROOT).split("NESTED LOOPS", -1).length > 3) {
+                issues.add(Map.of("type", "NESTED_LOOP", "desc", "多层嵌套循环，可能影响性能"));
+            }
+            if (plan.toUpperCase(Locale.ROOT).contains("CARTESIAN")) {
+                issues.add(Map.of("type", "CARTESIAN", "desc", "笛卡尔积连接，检查WHERE条件是否完整"));
+            }
+            Map<String, Object> out = new LinkedHashMap<>();
+            out.put("plan", plan);
+            out.put("issues", issues);
+            out.put("fullScanDetected", detectFullScan(plan, inst.dbType()));
+            out.put("dbType", inst.dbType());
+            return out;
+        } catch (SQLException e) {
+            throw new BizException(500, "获取执行计划失败: " + e.getMessage());
+        }
+    }
+
+    String runExplain(TargetDb db, String platformType, String sql) throws SQLException {
+        String t = DbType.normalize(platformType);
+        Connection c = db.connection();
+        return switch (t) {
+            case DbType.ORACLE -> "[Oracle] Execution Plan:\n" + "-".repeat(50) + "\n" + explainOracle(c, sql);
+            case DbType.DAMENG -> {
+                try {
+                    yield "[达梦 DM] Execution Plan:\n" + "-".repeat(50) + "\n" + explainOracle(c, sql);
+                } catch (SQLException e1) {
+                    yield "[达梦 DM] Execution Plan:\n" + "-".repeat(50) + "\n" + table(c, "EXPLAIN " + sql);
+                }
+            }
+            case DbType.MYSQL, DbType.GOLDENDB -> "[" + (DbType.GOLDENDB.equals(t) ? "GoldenDB" : "MySQL") + "] Execution Plan:\n" + table(c, "EXPLAIN " + sql);
+            case DbType.POSTGRESQL -> "[PostgreSQL] Execution Plan:\n" + "-".repeat(50) + "\n" + table(c, "EXPLAIN (FORMAT TEXT) " + sql);
+            case DbType.PANWEI -> "[PanWei] Execution Plan:\n" + "-".repeat(50) + "\n" + table(c, "EXPLAIN " + sql);
+            case DbType.SQLSERVER -> "[SQL Server] Execution Plan:\n" + "-".repeat(50) + "\n" + explainSqlServer(c, sql);
+            default -> throw new SQLException("不支持 EXPLAIN 的数据库类型: " + platformType);
+        };
+    }
+
+    private String explainOracle(Connection c, String sql) throws SQLException {
+        String id = "DIOPS_" + Long.toString(System.nanoTime(), 36).toUpperCase(Locale.ROOT);
+        try (Statement st = c.createStatement()) {
+            st.setQueryTimeout(30);
+            st.execute("EXPLAIN PLAN SET STATEMENT_ID = '" + id + "' FOR " + sql);
+            StringBuilder sb = new StringBuilder();
+            try (ResultSet rs = st.executeQuery("SELECT PLAN_TABLE_OUTPUT FROM TABLE(DBMS_XPLAN.DISPLAY('PLAN_TABLE', '" + id + "', 'ALL'))")) {
+                while (rs.next()) {
+                    sb.append(rs.getString(1)).append('\n');
+                }
+            }
+            try {
+                st.execute("DELETE FROM PLAN_TABLE WHERE STATEMENT_ID = '" + id + "'");
+                if (!c.getAutoCommit()) {
+                    c.commit();
+                }
+            } catch (SQLException ignore) {
+                // PLAN_TABLE 为会话级临时表时无需清理
+            }
+            return sb.length() == 0 ? "执行计划为空" : sb.toString();
+        }
+    }
+
+    private String explainSqlServer(Connection c, String sql) throws SQLException {
+        try (Statement st = c.createStatement()) {
+            st.execute("SET SHOWPLAN_TEXT ON");
+            try {
+                StringBuilder sb = new StringBuilder();
+                boolean rsNext = st.execute(sql);
+                while (true) {
+                    if (rsNext) {
+                        try (ResultSet rs = st.getResultSet()) {
+                            while (rs.next()) {
+                                sb.append(rs.getString(1)).append('\n');
+                            }
+                        }
+                    } else if (st.getUpdateCount() == -1) {
+                        break;
+                    }
+                    rsNext = st.getMoreResults();
+                }
+                return sb.length() == 0 ? "(无计划输出)" : sb.toString();
+            } finally {
+                try {
+                    st.execute("SET SHOWPLAN_TEXT OFF");
+                } catch (SQLException ignore) {
+                    // ignore
+                }
+            }
+        }
+    }
+
+    private String table(Connection c, String sql) throws SQLException {
+        try (Statement st = c.createStatement()) {
+            st.setQueryTimeout(30);
+            try (ResultSet rs = st.executeQuery(sql)) {
+                ResultSetMetaData md = rs.getMetaData();
+                int n = md.getColumnCount();
+                List<String> lines = new ArrayList<>();
+                if (n > 1) {
+                    List<String> head = new ArrayList<>();
+                    for (int i = 1; i <= n; i++) {
+                        head.add(md.getColumnLabel(i));
+                    }
+                    lines.add(String.join(" | ", head));
+                    lines.add("-".repeat(40));
+                }
+                while (rs.next()) {
+                    List<String> cells = new ArrayList<>();
+                    for (int i = 1; i <= n; i++) {
+                        Object v = rs.getObject(i);
+                        cells.add(v == null ? "NULL" : String.valueOf(v));
+                    }
+                    lines.add(String.join(" | ", cells));
+                }
+                return String.join("\n", lines);
+            }
+        }
+    }
+
+    // ------------------------------------------------------------------ 实例检查（审核用）
+
+    /** 表存在性 + 可执行性 + 执行计划；结构同原 sanitizeInstanceCheck */
+    public Map<String, Object> instanceCheck(long instanceId, String sql, List<String> tables, String stmtType) {
+        Map<String, Object> out = new LinkedHashMap<>();
+        out.put("instanceId", instanceId);
+        out.put("instanceName", null);
+        out.put("dbType", null);
+        out.put("connected", false);
+        out.put("connectionError", null);
+        out.put("tables", List.of());
+        out.put("tableNote", null);
+        out.put("executable", null);
+        out.put("executeMessage", null);
+        out.put("explainSupported", false);
+        out.put("explainOk", false);
+        out.put("explainPlan", "");
+        out.put("fullScanDetected", false);
+        out.put("optimizeSuggestions", List.of());
+        String text = clean(sql);
+        CmdbInstance inst;
+        try {
+            inst = connector.fetch(instanceId);
+        } catch (Exception e) {
+            out.put("connectionError", e.getMessage());
+            out.put("executable", false);
+            out.put("executeMessage", e.getMessage());
+            return out;
+        }
+        out.put("instanceName", inst.instanceName());
+        out.put("dbType", inst.dbType());
+        try (TargetDb db = connector.open(inst)) {
+            out.put("connected", true);
+            List<Map<String, Object>> tl = new ArrayList<>();
+            for (String full : tables) {
+                tl.add(checkTable(db, inst.dbType(), full));
+            }
+            out.put("tables", tl);
+            if (tables.isEmpty()) {
+                out.put("tableNote", "未从 SQL 中识别到表名（如 SELECT 1、仅函数调用等）");
+            }
+            boolean explainable = "SELECT".equals(stmtType);
+            boolean multi = false;
+            try {
+                requireSingle(text, inst.dbType());
+            } catch (BizException e) {
+                multi = true;
+            }
+            if (multi) {
+                out.put("executable", false);
+                out.put("executeMessage", "包含多条语句，请逐条审核");
+                out.put("explainPlan", "包含多条语句，未获取执行计划");
+                return out;
+            }
+            if ("DDL".equals(stmtType) || "DCL".equals(stmtType)) {
+                out.put("executeMessage", "DDL/DCL 不做 EXPLAIN 探测，请在发布环节验证");
+                out.put("explainPlan", "执行计划仅支持 SELECT / WITH 语句");
+                return out;
+            }
+            String reject = explainRejectReason(text, inst.dbType());
+            if (reject != null) {
+                out.put("executeMessage", reject + "，请在发布环节验证");
+                out.put("explainPlan", reject);
+                return out;
+            }
+            try {
+                String plan = runExplain(db, inst.dbType(), text);
+                out.put("executable", true);
+                out.put("executeMessage", explainable ? "SELECT 语句 EXPLAIN 成功" : "语句已通过 EXPLAIN 语法检查");
+                if (explainable) {
+                    boolean full = detectFullScan(plan, inst.dbType());
+                    out.put("explainSupported", true);
+                    out.put("explainOk", true);
+                    out.put("explainPlan", plan);
+                    out.put("fullScanDetected", full);
+                    out.put("optimizeSuggestions", full ? FULL_SCAN_HINTS : List.of());
+                } else {
+                    out.put("explainPlan", "执行计划仅支持 SELECT / WITH 语句；当前语句已通过语法检查");
+                }
+            } catch (SQLException e) {
+                out.put("executable", false);
+                out.put("executeMessage", "EXPLAIN 失败: " + e.getMessage());
+                out.put("explainSupported", explainable);
+                out.put("explainPlan", "获取执行计划失败: " + e.getMessage());
+            }
+        } catch (Exception e) {
+            out.put("connected", false);
+            out.put("connectionError", e.getMessage());
+            out.put("executable", false);
+            out.put("executeMessage", e.getMessage());
+            out.put("explainPlan", e.getMessage());
+        }
+        return out;
+    }
+
+    Map<String, Object> checkTable(TargetDb db, String platformType, String full) {
+        String schema = null;
+        String name = full;
+        int dot = full.lastIndexOf('.');
+        if (dot > 0) {
+            schema = full.substring(0, dot).replace("\"", "").replace("`", "");
+            name = full.substring(dot + 1);
+        }
+        name = name.replace("\"", "").replace("`", "").replace("[", "").replace("]", "");
+        Map<String, Object> m = new LinkedHashMap<>();
+        m.put("schema", schema);
+        m.put("name", name);
+        String t = DbType.normalize(platformType);
+        String q = switch (t) {
+            case DbType.ORACLE, DbType.DAMENG -> "SELECT COUNT(*) AS C FROM ALL_TABLES WHERE OWNER = NVL(?, SYS_CONTEXT('USERENV','CURRENT_SCHEMA')) AND TABLE_NAME = ?";
+            case DbType.MYSQL, DbType.GOLDENDB -> "SELECT COUNT(*) AS C FROM information_schema.tables WHERE table_schema = IFNULL(?, DATABASE()) AND table_name = ?";
+            case DbType.POSTGRESQL, DbType.PANWEI -> "SELECT COUNT(*) AS C FROM information_schema.tables WHERE table_schema = COALESCE(LOWER(?), current_schema()) "
+                    + "AND table_name = LOWER(?)";
+            case DbType.SQLSERVER -> "SELECT COUNT(*) AS C FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_SCHEMA = ISNULL(?, 'dbo') AND TABLE_NAME = ?";
+            default -> null;
+        };
+        if (q == null) {
+            m.put("exists", false);
+            m.put("message", "未知库类型");
+            return m;
+        }
+        String sch = schema;
+        String tbl = name;
+        if (DbType.ORACLE.equals(t) || DbType.DAMENG.equals(t)) {
+            sch = schema == null ? null : schema.toUpperCase(Locale.ROOT);
+            tbl = name.toUpperCase(Locale.ROOT);
+        }
+        try {
+            Map<String, Object> r = db.one(q, sch, tbl);
+            boolean exists = r != null && Values.toLong(r.get("C"), 0) > 0;
+            // 视图/同义词也视为存在（Oracle/DM）
+            if (!exists && (DbType.ORACLE.equals(t) || DbType.DAMENG.equals(t))) {
+                Map<String, Object> v = db.oneQuietly("SELECT COUNT(*) AS C FROM ALL_OBJECTS WHERE OWNER IN (NVL(?, SYS_CONTEXT('USERENV','CURRENT_SCHEMA')), 'PUBLIC') "
+                        + "AND OBJECT_NAME = ? AND OBJECT_TYPE IN ('VIEW', 'SYNONYM', 'MATERIALIZED VIEW')", sch, tbl);
+                exists = v != null && Values.toLong(v.get("C"), 0) > 0;
+            }
+            m.put("exists", exists);
+            m.put("message", exists ? "表存在" : "表不存在");
+        } catch (SQLException e) {
+            m.put("exists", false);
+            m.put("message", "检查失败: " + e.getMessage());
+        }
+        return m;
+    }
+
+    /** 审核时需要元数据：开一个连接交给回调 */
+    public <T> T withConnection(long instanceId, java.util.function.Function<TargetDb, T> fn) throws SQLException {
+        try (TargetDb db = connector.open(instanceId)) {
+            return fn.apply(db);
+        }
+    }
+}
diff --git a/dbops-server/src/main/java/com/dbops/sqlinsight/audit/SqlAuditService.java b/dbops-server/src/main/java/com/dbops/sqlinsight/audit/SqlAuditService.java
new file mode 100644
index 0000000..cc639fe
--- /dev/null
+++ b/dbops-server/src/main/java/com/dbops/sqlinsight/audit/SqlAuditService.java
@@ -0,0 +1,315 @@
+package com.dbops.sqlinsight.audit;
+
+import com.dbops.common.Db;
+import com.dbops.common.Values;
+import com.dbops.monitor.DbType;
+import com.dbops.sqlinsight.ast.Finding;
+import com.dbops.sqlinsight.ast.SqlAstService;
+import com.dbops.sqlinsight.ast.StaticRuleEngine;
+import com.dbops.sqlinsight.ast.TableMetadata;
+import com.dbops.sqlinsight.rules.RuleConfigService;
+import com.dbops.sqlinsight.store.AssetService;
+import com.dbops.sqlinsight.store.InstanceDirectory;
+import org.springframework.stereotype.Service;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Set;
+import java.util.regex.Pattern;
+
+/**
+ * 统一 SQL 审核引擎：SQL 审核工单 / 治理中心即时审核 / 发布预审 / AI 优化 Agent / SQL 优化建议 全部调用这里，
+ * 同一条 SQL 在任何入口得到同一个结论。
+ * <p>
+ * 组成：Druid AST 静态规则（S-001~S-007、D-001~D-003、H-001~H-003，阈值来自 DI_SQL_RULE）
+ * + DDL_AUDIT_RULE 中用户自定义的正则策略（内置的 6 条已由 AST 规则取代并停用）
+ * + 可选的目标实例检查（表存在性 / 可执行性 / 执行计划 / 全表扫描）
+ * + 资产关联（该 SQL 在线上的运行时问题与波动）。
+ * <p>
+ * 返回结构兼容原 automation.js sqlAuditCheckDynamic：{issues:[{code,severity,message}], hints, score, risk, instanceCheck}。
+ */
+@Service
+public class SqlAuditService {
+
+    /** 已被 AST 规则取代的内置正则规则编码（迁移脚本会把它们停用；这里再兜底过滤一次） */
+    public static final Set<String> SUPERSEDED = Set.of("NO_SELECT_STAR", "WHERE_REQUIRED", "NO_DROP_TABLE", "NO_TRUNCATE",
+            "NO_IMPLICIT_CONVERT", "NO_DELETE_LARGE_TABLE", "NO_DELETE_NOINDEX", "NO_DELETE_LARGE", "ADD_COL_DEFAULT", "NO_CARTESIAN",
+            "LIMIT_WITHOUT_ORDER");
+
+    public record Request(String sql, String dbType, String schema, Long instanceId, boolean instanceCheck, boolean linkAsset) {
+    }
+
+    private record Custom(String code, Pattern pattern, String severity, String message, String dbType) {
+    }
+
+    private final SqlAstService ast;
+    private final RuleConfigService rules;
+    private final ExplainService explain;
+    private final AssetService assets;
+    private final InstanceDirectory instances;
+    private final Db db;
+    private volatile List<Custom> custom = List.of();
+    private volatile long customAt;
+
+    public SqlAuditService(SqlAstService ast, RuleConfigService rules, ExplainService explain, AssetService assets,
+                           InstanceDirectory instances, Db db) {
+        this.ast = ast;
+        this.rules = rules;
+        this.explain = explain;
+        this.assets = assets;
+        this.instances = instances;
+        this.db = db;
+    }
+
+    // ------------------------------------------------------------------ 评分（与原实现系数一致）
+
+    public static int score(List<Map<String, Object>> issues) {
+        int s = 100;
+        for (Map<String, Object> i : issues) {
+            s -= switch (Values.str(i.get("severity"), "").toUpperCase(Locale.ROOT)) {
+                case "CRITICAL" -> 40;
+                case "ERROR" -> 20;
+                case "WARNING" -> 8;
+                case "INFO" -> 2;
+                default -> 0;
+            };
+        }
+        return Math.max(0, s);
+    }
+
+    public static String risk(int score) {
+        return score >= 90 ? "LOW" : score >= 70 ? "MEDIUM" : score >= 50 ? "HIGH" : "CRITICAL";
+    }
+
+    // ------------------------------------------------------------------ 审核
+
+    public Map<String, Object> audit(Request req) {
+        String sql = req.sql() == null ? "" : req.sql();
+        List<Map<String, Object>> issues = new ArrayList<>();
+        List<String> hints = new ArrayList<>();
+        Map<String, Object> out = new LinkedHashMap<>();
+        out.put("engine", "druid-ast");
+
+        if (sql.isBlank()) {
+            issues.add(issue("EMPTY_SQL", "ERROR", "SQL 内容不能为空", null));
+            return finish(out, issues, hints);
+        }
+        if (SqlAstService.stripComments(sql).isBlank()) {
+            issues.add(issue("EMPTY_SQL", "ERROR", "SQL 内容不能只包含注释", null));
+            return finish(out, issues, hints);
+        }
+
+        InstanceDirectory.Inst inst = req.instanceId() == null ? null : instances.get(req.instanceId());
+        String platform = inst != null ? inst.dbType() : req.dbType();
+        SqlAstService.SqlAnalysis a = ast.analyze(sql, platform, req.schema());
+        out.put("dbType", a.dbFamily());
+        out.put("dialect", a.dialect() == null ? null : a.dialect().name());
+        out.put("parsed", a.parsed());
+        out.put("stmtType", a.stmtType());
+        out.put("statementTypes", a.parsed() ? a.statements().stream().map(SqlAstService::stmtType).toList() : List.of(a.stmtType()));
+        out.put("tables", a.tables());
+        out.put("fingerprint", a.fingerprint());
+        out.put("normalizedSql", a.normalized());
+
+        if (!a.parsed()) {
+            if ("UNKNOWN".equals(a.stmtType())) {
+                issues.add(issue("INVALID_SQL", "CRITICAL", "输入内容不是有效的 SQL 语句：" + Values.truncate(a.parseError(), 200), null));
+                return finish(out, issues, hints);
+            }
+            issues.add(issue("PARSE_FAILED", "WARNING", "SQL 解析失败，静态规则未执行（不能视为通过）：" + Values.truncate(a.parseError(), 200),
+                    "检查语法是否与目标库方言一致"));
+        }
+
+        // 静态规则（有实例时读取索引/字段类型元数据）
+        RuleConfigService.Scope scope = new RuleConfigService.Scope(null, req.instanceId(), inst == null ? null : inst.bizType(), a.dbFamily());
+        StaticRuleEngine.Result res;
+        if (inst != null && a.parsed()) {
+            res = withMetadata(inst, a, scope);
+        } else {
+            res = StaticRuleEngine.analyze(a, rules.staticView(scope), TableMetadata.NONE);
+        }
+        for (Finding f : res.findings()) {
+            issues.add(issue(f.code(), f.severity(), f.message(), f.suggestion(), f.title()));
+            if (f.code().startsWith("H-") && f.suggestion() != null) {
+                hints.add(f.suggestion());
+            }
+        }
+        out.put("skipped", res.skipped().stream().map(Finding.Skipped::toMap).toList());
+
+        // 用户自定义正则策略
+        String clean = SqlAstService.stripComments(sql);
+        for (Custom c : customRules()) {
+            if (c.dbType() != null && !"ALL".equalsIgnoreCase(c.dbType()) && !c.dbType().equalsIgnoreCase(a.dbFamily())
+                    && !c.dbType().equalsIgnoreCase(DbType.normalize(platform))) {
+                continue;
+            }
+            try {
+                if (c.pattern().matcher(clean).find()) {
+                    issues.add(issue(c.code(), c.severity(), c.message(), null));
+                }
+            } catch (RuntimeException ignore) {
+                // 灾难性回溯等异常正则：跳过
+            }
+        }
+
+        if ("SELECT".equals(a.stmtType()) && !(req.instanceCheck() && inst != null)) {
+            hints.add("建议在执行前使用 EXPLAIN 确认执行计划");
+        }
+
+        // 目标实例检查
+        if (req.instanceCheck() && req.instanceId() != null) {
+            Map<String, Object> ic = explain.instanceCheck(req.instanceId(), sql, a.tables(), a.stmtType());
+            mergeInstanceCheck(issues, hints, ic);
+            out.put("instanceCheck", ic);
+        }
+
+        // 资产关联（运行时问题 / 波动史）
+        if (req.linkAsset() && a.parsed()) {
+            AssetService.AssetRef ref = assets.resolve(a, sql);
+            out.put("assetId", ref.assetId());
+            out.put("runtime", runtime(ref.assetId(), req.instanceId()));
+        }
+        return finish(out, issues, hints);
+    }
+
+    private StaticRuleEngine.Result withMetadata(InstanceDirectory.Inst inst, SqlAstService.SqlAnalysis a, RuleConfigService.Scope scope) {
+        try {
+            return explain.withConnection(inst.id(), tdb -> StaticRuleEngine.analyze(a, rules.staticView(scope), new TargetMetadata(tdb, inst.dbType())));
+        } catch (Exception e) {
+            StaticRuleEngine.Result r = StaticRuleEngine.analyze(a, rules.staticView(scope), TableMetadata.NONE);
+            List<Finding.Skipped> sk = new ArrayList<>(r.skipped());
+            sk.add(new Finding.Skipped("META", "无法连接目标实例读取元数据：" + Values.truncate(e.getMessage(), 200)));
+            return new StaticRuleEngine.Result(r.findings(), sk);
+        }
+    }
+
+    static void mergeInstanceCheck(List<Map<String, Object>> issues, List<String> hints, Map<String, Object> ic) {
+        if (!Boolean.TRUE.equals(ic.get("connected"))) {
+            issues.add(issue("DB_UNREACHABLE", "CRITICAL", "无法连接目标实例: " + Values.str(ic.get("connectionError"), "连接失败"), null));
+            return;
+        }
+        Object tl = ic.get("tables");
+        if (tl instanceof List<?> list) {
+            for (Object o : list) {
+                if (o instanceof Map<?, ?> t && !Boolean.TRUE.equals(t.get("exists"))) {
+                    String sch = t.get("schema") == null ? "" : t.get("schema") + ".";
+                    issues.add(issue("TABLE_NOT_FOUND", "ERROR", "表 " + sch + t.get("name") + " 在实例 [" + ic.get("instanceName") + "] 中不存在", null));
+                }
+            }
+        }
+        if (Boolean.FALSE.equals(ic.get("executable"))) {
+            issues.add(issue("SQL_NOT_EXECUTABLE", "ERROR", Values.str(ic.get("executeMessage"), "SQL 无法在目标库执行"), null));
+        }
+        if (Boolean.TRUE.equals(ic.get("explainOk"))) {
+            hints.removeIf(h -> h.contains("EXPLAIN"));
+        }
+        if (Boolean.TRUE.equals(ic.get("fullScanDetected"))) {
+            if (hints.stream().noneMatch(h -> h.contains("全表扫描"))) {
+                hints.add(0, "【执行计划】检测到全表扫描，建议优化索引或改写 SQL 后再发布");
+            }
+            for (String s : ExplainService.FULL_SCAN_HINTS) {
+                if (!hints.contains(s)) {
+                    hints.add(s);
+                }
+            }
+            issues.add(issue("FULL_TABLE_SCAN", "WARNING", "执行计划存在全表扫描，推送发布时将附带优化建议供审核人参考", null));
+        }
+    }
+
+    private Map<String, Object> runtime(long assetId, Long instanceId) {
+        Map<String, Object> m = new LinkedHashMap<>();
+        String instCond = instanceId == null ? "" : " AND INSTANCE_ID=" + instanceId.longValue();
+        try {
+            m.put("openProblems", db.query("SELECT PROBLEM_ID, RULE_CODE, INSTANCE_ID, SEVERITY, DETAIL, LAST_SEEN FROM DI_SQL_PROBLEM WHERE ASSET_ID=? "
+                    + "AND STATUS='OPEN'" + instCond + " ORDER BY LAST_SEEN DESC FETCH FIRST 20 ROWS ONLY", assetId));
+            m.put("anomalies", db.query("SELECT ANOMALY_ID, INSTANCE_ID, METRIC, ANOMALY_TYPE, SEVERITY, STATUS, RATIO, START_TIME, LAST_TIME FROM DI_SQL_ANOMALY "
+                    + "WHERE ASSET_ID=?" + instCond + " AND START_TIME >= SYSTIMESTAMP - INTERVAL '30' DAY ORDER BY START_TIME DESC FETCH FIRST 20 ROWS ONLY", assetId));
+            m.put("last24h", db.one("SELECT SUM(D_EXEC) EXECS, ROUND(SUM(D_ELAPSED_MS) / NULLIF(SUM(D_EXEC), 0), 2) AVG_ELAPSED_MS, COUNT(DISTINCT INSTANCE_ID) INSTANCES "
+                    + "FROM DI_SQL_STATS_MIN WHERE ASSET_ID=?" + instCond + " AND WINDOW_START >= LOCALTIMESTAMP - INTERVAL '1' DAY", assetId));
+        } catch (Exception e) {
+            m.put("error", e.getMessage());
+        }
+        return m;
+    }
+
+    private List<Custom> customRules() {
+        if (System.currentTimeMillis() - customAt < 30_000) {
+            return custom;
+        }
+        List<Custom> list = new ArrayList<>();
+        try {
+            for (Map<String, Object> r : db.query("SELECT RULE_CODE, RULE_PATTERN, SEVERITY, MESSAGE, DB_TYPE FROM DDL_AUDIT_RULE WHERE ENABLED=1")) {
+                String code = Values.str(r.get("RULE_CODE"), "");
+                if (SUPERSEDED.contains(code)) {
+                    continue;
+                }
+                try {
+                    list.add(new Custom(code, Pattern.compile(Values.str(r.get("RULE_PATTERN"), "(?!)"), Pattern.CASE_INSENSITIVE | Pattern.DOTALL),
+                            Values.str(r.get("SEVERITY"), "WARNING"), Values.str(r.get("MESSAGE"), code), Values.str(r.get("DB_TYPE"))));
+                } catch (RuntimeException ignore) {
+                    // 非法正则跳过
+                }
+            }
+        } catch (Exception e) {
+            if (!Db.isMissingTable(e)) {
+                throw e;
+            }
+        }
+        custom = list;
+        customAt = System.currentTimeMillis();
+        return list;
+    }
+
+    private static Map<String, Object> finish(Map<String, Object> out, List<Map<String, Object>> issues, List<String> hints) {
+        int s = score(issues);
+        out.put("issues", issues);
+        out.put("hints", hints);
+        out.put("score", s);
+        out.put("risk", risk(s));
+        out.putIfAbsent("skipped", List.of());
+        return out;
+    }
+
+    static Map<String, Object> issue(String code, String severity, String message, String suggestion) {
+        return issue(code, severity, message, suggestion, null);
+    }
+
+    static Map<String, Object> issue(String code, String severity, String message, String suggestion, String title) {
+        Map<String, Object> m = new LinkedHashMap<>();
+        m.put("code", code);
+        m.put("severity", severity);
+        m.put("message", message);
+        if (title != null) {
+            m.put("title", title);
+        }
+        if (suggestion != null) {
+            m.put("suggestion", suggestion);
+        }
+        return m;
+    }
+
+    // ------------------------------------------------------------------ 兼容输出
+
+    /** /api/sql/optimize 兼容：suggestions [{rule, severity(HIGH/WARN/INFO), desc}] */
+    public List<Map<String, Object>> optimizeSuggestions(Map<String, Object> audit) {
+        List<Map<String, Object>> out = new ArrayList<>();
+        Object is = audit.get("issues");
+        if (is instanceof List<?> list) {
+            for (Object o : list) {
+                if (o instanceof Map<?, ?> i) {
+                    String sev = Values.str(i.get("severity"), "INFO").toUpperCase(Locale.ROOT);
+                    String mapped = "CRITICAL".equals(sev) || "ERROR".equals(sev) ? "HIGH" : "WARNING".equals(sev) ? "WARN" : "INFO";
+                    String desc = Values.str(i.get("message"), "") + (i.get("suggestion") != null ? "；建议：" + i.get("suggestion") : "");
+                    out.add(Map.of("rule", Values.str(i.get("code"), ""), "severity", mapped, "desc", desc));
+                }
+            }
+        }
+        if (out.isEmpty()) {
+            out.add(Map.of("rule", "OK", "severity", "INFO", "desc", "SQL结构检查未发现明显问题，建议结合执行计划进一步分析"));
+        }
+        return out;
+    }
+}
