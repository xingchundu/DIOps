-    `SELECT ALERT_ID, INSTANCE_ID, INSTANCE_NAME, SEVERITY, RULE_NAME, TRIGGER_TIME, STATUS
-     FROM ALERT_RECORD WHERE STATUS = 'OPEN' ORDER BY TRIGGER_TIME ASC`, []
-  );
-
-  let silenced = 0;
-  let suppressed = 0;
-  for (const alert of openAlerts) {
-    const rule = await checkSilenceForAlert(alert);
-    if (rule) {
-      await applySilenceToAlert(alert, rule);
-      silenced += 1;
-      continue;
-    }
-    const before = await db.execute(`SELECT STATUS FROM ALERT_RECORD WHERE ALERT_ID=:1`, [alert.ALERT_ID]);
-    const wasOpen = before.rows[0]?.STATUS === 'OPEN';
-    await checkSuppressionForAlert(alert.ALERT_ID);
-    const after = await db.execute(`SELECT STATUS FROM ALERT_RECORD WHERE ALERT_ID=:1`, [alert.ALERT_ID]);
-    if (wasOpen && after.rows[0]?.STATUS === 'SUPPRESSED') suppressed += 1;
-  }
-
-  const agg = await aggregateAlerts();
-  return {
-    checked: openAlerts.length,
-    silenced,
-    suppressed,
-    aggregated: agg.merged || 0,
-    aggGroups: agg.groups || 0,
-  };
-}
