+package com.dbops.sqlinsight.collect;
+
+import org.junit.jupiter.api.Test;
+
+import java.util.Map;
+import java.util.Set;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class StatsSourceTest {
+
+    @Test
+    void postgresVersionDifferencesResolvedByCandidates() {
+        StatsSource.Spec spec = StatsSource.postgres();
+        StatsSource.Probe pg13 = StatsSource.resolve(spec, Set.of("USERID", "DBID", "QUERYID", "TOPLEVEL", "QUERY", "DBNAME", "CALLS",
+                "TOTAL_EXEC_TIME", "SHARED_BLKS_HIT", "SHARED_BLKS_READ", "ROWS", "TEMP_BLKS_WRITTEN"));
+        assertTrue(pg13.ok());
+        assertEquals("TOTAL_EXEC_TIME", pg13.counters().get(Counter.ELAPSED_MS).expr());
+        assertEquals(4, pg13.ids().size());
+        StatsSource.Probe pg12 = StatsSource.resolve(spec, Set.of("USERID", "DBID", "QUERYID", "QUERY", "DBNAME", "CALLS", "TOTAL_TIME", "ROWS"));
+        assertTrue(pg12.ok());
+        assertEquals("TOTAL_TIME", pg12.counters().get(Counter.ELAPSED_MS).expr());
+        assertFalse(pg12.supports(Counter.LOGICAL_READS));
+        assertFalse(pg12.supports(Counter.CPU_MS));
+        Map<String, Boolean> cap = pg12.capability();
+        assertFalse(cap.get("cpu"));
+        assertTrue(cap.get("exec"));
+    }
+
+    @Test
+    void missingCoreColumnsFailProbe() {
+        StatsSource.Probe p = StatsSource.resolve(StatsSource.dameng(1), Set.of("SQL_ID", "SQL_TEXT"));
+        assertFalse(p.ok());
+        assertTrue(p.error().contains("缺少执行次数"));
+    }
+
+    @Test
+    void queryUsesDialectLimitAndActivityFilter() {
+        StatsSource.Probe ora = StatsSource.resolve(StatsSource.oracle(), Set.of("SQL_ID", "PLAN_HASH_VALUE", "SQL_TEXT", "PARSING_SCHEMA_NAME",
+                "EXECUTIONS", "ELAPSED_TIME", "CPU_TIME", "BUFFER_GETS", "DISK_READS", "ROWS_PROCESSED", "LAST_ACTIVE_TIME", "COMMAND_TYPE"));
+        String q = StatsSource.buildQuery(ora, 500);
+        assertTrue(q.contains("ROWNUM <= 500"));
+        assertTrue(q.contains("LAST_ACTIVE_TIME >= SYSDATE - 2/1440"));
+        assertTrue(ora.activityFiltered());
+        StatsSource.Probe ms = StatsSource.resolve(StatsSource.sqlserver(), Set.of("QHASH", "PHASH", "DBNAME", "STMT", "EXECS", "ELAPSED_US",
+                "CPU_US", "LR", "PR", "ROWS_RET", "LAST_EXEC"));
+        assertTrue(StatsSource.buildQuery(ms, 100).startsWith("SELECT TOP 100 "));
+        StatsSource.Probe my = StatsSource.resolve(StatsSource.mysql("MYSQL"), Set.of("SCHEMA_NAME", "DIGEST", "DIGEST_TEXT", "COUNT_STAR",
+                "SUM_TIMER_WAIT", "SUM_ROWS_EXAMINED", "SUM_ROWS_SENT", "SUM_ERRORS", "SUM_NO_INDEX_USED", "LAST_SEEN"));
+        String mq = StatsSource.buildQuery(my, 50);
+        assertTrue(mq.endsWith("LIMIT 50"));
+        assertEquals("SUM_NO_INDEX_USED", my.counters().get(Counter.NO_INDEX).expr());
+    }
+
+    @Test
+    void unitConversionAndNativeId() {
+        StatsSource.Probe my = StatsSource.resolve(StatsSource.mysql("MYSQL"), Set.of("SCHEMA_NAME", "DIGEST", "DIGEST_TEXT", "COUNT_STAR", "SUM_TIMER_WAIT"));
+        SqlCounters c = StatsSource.toCounters(my, Map.of("NID0", "shop", "NID1", "abc123", "TXT", "SELECT 1", "C_EXEC", 10, "C_ELAPSED_MS", 5_000_000_000L));
+        assertEquals("shop|abc123", c.nativeId());
+        assertEquals(5.0, c.get(Counter.ELAPSED_MS));
+        assertTrue(Double.isNaN(c.get(Counter.CPU_MS)));
+        assertEquals("NA", c.planHash());
+    }
+}
diff --git a/dbops-server/src/test/java/com/dbops/sqlinsight/diagnosis/CauseClassifierTest.java b/dbops-server/src/test/java/com/dbops/sqlinsight/diagnosis/CauseClassifierTest.java
new file mode 100644
index 0000000..6821cbe
--- /dev/null
+++ b/dbops-server/src/test/java/com/dbops/sqlinsight/diagnosis/CauseClassifierTest.java
@@ -0,0 +1,77 @@
+package com.dbops.sqlinsight.diagnosis;
+
+import com.dbops.sqlinsight.collect.Metric;
+import org.junit.jupiter.api.Test;
+
+import java.util.List;
+import java.util.Map;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+/** 设计方案 6.2 原因分类表 */
+class CauseClassifierTest {
+
+    static final double NA = Double.NaN;
+
+    static CauseClassifier.Evidence ev(Map<Metric, Double> r, boolean planSupported, boolean newPlan, boolean lock, double cpu, double io,
+                                       int concurrent, boolean inst) {
+        return new CauseClassifier.Evidence(r, planSupported, newPlan, newPlan ? "14:02 出现新 plan_hash 1234，异常窗口中占比 96%" : null,
+                lock, lock ? "会话 101 被 88 阻塞 30 秒" : null, cpu, io, concurrent, inst, List.of("发布：v2.3（14:00）"));
+    }
+
+    static List<String> codes(CauseClassifier.Evidence e) {
+        return CauseClassifier.classify(e).stream().map(CauseClassifier.Cause::code).toList();
+    }
+
+    @Test
+    void planRegressionFirstAndReleaseIsEvidenceNotCause() {
+        List<CauseClassifier.Cause> c = CauseClassifier.classify(ev(Map.of(Metric.AVG_ELAPSED_MS, 50.0, Metric.LOGICAL_READS_PER_EXEC, 6.0),
+                true, true, false, NA, NA, 0, false));
+        assertEquals("PLAN_REGRESSION", c.get(0).code());
+        assertTrue(c.get(0).evidence().get(0).contains("plan_hash 1234"));
+        assertFalse(c.stream().anyMatch(x -> x.code().contains("RELEASE")));
+    }
+
+    @Test
+    void noPlanRegressionWhenPlanNotSupported() {
+        List<String> c = codes(ev(Map.of(Metric.AVG_ELAPSED_MS, 5.0, Metric.LOGICAL_READS_PER_EXEC, 6.0), false, true, false, NA, NA, 0, false));
+        assertFalse(c.contains("PLAN_REGRESSION"));
+    }
+
+    @Test
+    void lockWaitNeedsStableCpuAndReads() {
+        assertEquals("LOCK_WAIT", codes(ev(Map.of(Metric.AVG_ELAPSED_MS, 5.0, Metric.LOGICAL_READS_PER_EXEC, 1.0, Metric.CPU_PER_EXEC_MS, 1.1),
+                true, false, true, NA, NA, 0, false)).get(0));
+        // CPU 未采集（NaN）不算“稳定”，不下锁等待结论
+        assertFalse(codes(ev(Map.of(Metric.AVG_ELAPSED_MS, 5.0, Metric.LOGICAL_READS_PER_EXEC, 1.0), true, false, true, NA, NA, 0, false))
+                .contains("LOCK_WAIT"));
+    }
+
+    @Test
+    void thresholdsAreOneFiveAndOneTwo() {
+        assertEquals("DATA_GROWTH_OR_SKEW", codes(ev(Map.of(Metric.ROWS_EXAMINED_PER_EXEC, 1.5), true, false, false, NA, NA, 0, false)).get(0));
+        assertEquals("UNKNOWN", codes(ev(Map.of(Metric.ROWS_EXAMINED_PER_EXEC, 1.49), true, false, false, NA, NA, 0, false)).get(0));
+        assertEquals("TRAFFIC_SURGE", codes(ev(Map.of(Metric.AVG_ELAPSED_MS, 1.19, Metric.EXEC_PER_MIN, 3.0), true, false, false, NA, NA, 0, false)).get(0));
+        assertFalse(codes(ev(Map.of(Metric.AVG_ELAPSED_MS, 1.2, Metric.EXEC_PER_MIN, 3.0), true, false, false, NA, NA, 0, false)).contains("TRAFFIC_SURGE"));
+    }
+
+    @Test
+    void cacheResourceErrorAndUnknown() {
+        assertEquals("CACHE_OR_IO", codes(ev(Map.of(Metric.PHYSICAL_READS_PER_EXEC, 4.0, Metric.LOGICAL_READS_PER_EXEC, 1.0),
+                true, false, false, NA, NA, 0, false)).get(0));
+        assertEquals("CACHE_OR_IO", codes(ev(Map.of(), true, false, false, NA, 2.0, 0, false)).get(0));
+        assertEquals("RESOURCE_CONTENTION", codes(ev(Map.of(Metric.LOGICAL_READS_PER_EXEC, 1.0), true, false, false, 1.8, NA, 3, false)).get(0));
+        assertEquals("RESOURCE_CONTENTION", codes(ev(Map.of(), true, false, false, 2.0, NA, 8, true)).get(0));
+        assertEquals("ERROR_SURGE", codes(ev(Map.of(Metric.ERROR_RATE, 10.0), true, false, false, NA, NA, 0, false)).get(0));
+        assertEquals(List.of("UNKNOWN"), codes(ev(Map.of(), true, false, false, NA, NA, 0, false)));
+    }
+
+    @Test
+    void multipleCausesInPriorityOrder() {
+        List<String> c = codes(ev(Map.of(Metric.AVG_ELAPSED_MS, 3.0, Metric.LOGICAL_READS_PER_EXEC, 3.0, Metric.ERROR_RATE, 2.0),
+                true, true, false, NA, NA, 0, false));
+        assertEquals(List.of("PLAN_REGRESSION", "ERROR_SURGE"), c);
+    }
+}
diff --git a/dbops-server/src/test/java/com/dbops/sqlinsight/optimize/OptimizeEngineTest.java b/dbops-server/src/test/java/com/dbops/sqlinsight/optimize/OptimizeEngineTest.java
new file mode 100644
index 0000000..96ca5cb
--- /dev/null
+++ b/dbops-server/src/test/java/com/dbops/sqlinsight/optimize/OptimizeEngineTest.java
@@ -0,0 +1,164 @@
+package com.dbops.sqlinsight.optimize;
+
+import com.alibaba.druid.DbType;
+import com.dbops.sqlinsight.ast.SqlAstService;
+import com.dbops.sqlinsight.ast.TableMetadata;
+import org.junit.jupiter.api.Test;
+
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+/** 规则优化：执行计划分析 / 索引建议 / 等价改写 */
+class OptimizeEngineTest {
+
+    static final String ORA_PLAN = """
+            Plan hash value: 1234
+            ---------------------------------------------------------------------------
+            | Id  | Operation          | Name   | Rows  | Bytes | Cost (%CPU)| Time     |
+            ---------------------------------------------------------------------------
+            |   0 | SELECT STATEMENT   |        |    10 |   500 |   812   (2)| 00:00:01 |
+            |*  1 |  TABLE ACCESS FULL | ORDERS |    10 |   500 |   812   (2)| 00:00:01 |
+            ---------------------------------------------------------------------------
+            """;
+
+    /** 测试用元数据：ORDERS 有 (STATUS) 索引，CREATED_AT 为 DATE，CUST_NO 为字符 */
+    static final TableMetadata META = new TableMetadata() {
+        @Override
+        public Set<String> indexedColumns(String schema, String table) {
+            return "ORDERS".equalsIgnoreCase(table) ? Set.of("ID", "STATUS") : Set.of();
+        }
+
+        @Override
+        public String columnTypeFamily(String schema, String table, String column) {
+            return switch (column.toUpperCase()) {
+                case "CREATED_AT" -> "DATE";
+                case "CUST_NO", "STATUS" -> "CHAR";
+                default -> "NUMBER";
+            };
+        }
+
+        @Override
+        public List<List<String>> indexes(String schema, String table) {
+            return "ORDERS".equalsIgnoreCase(table) ? List.of(List.of("ID"), List.of("STATUS")) : List.of();
+        }
+
+        @Override
+        public List<String> columns(String schema, String table) {
+            return "ORDERS".equalsIgnoreCase(table) ? List.of("ID", "CUST_NO", "STATUS", "AMOUNT", "CREATED_AT") : null;
+        }
+
+        @Override
+        public Long rowCount(String schema, String table) {
+            return 5_000_000L;
+        }
+
+        @Override
+        public Boolean notNull(String schema, String table, String column) {
+            return column.equalsIgnoreCase("ID") || column.equalsIgnoreCase("ORDER_ID");
+        }
+    };
+
+    static SqlAstService.SqlAnalysis analyze(String sql) {
+        return new SqlAstService().analyze(sql, "ORACLE", "APP");
+    }
+
+    @Test
+    void planAnalyzer() {
+        assertEquals(Set.of("ORDERS"), PlanAnalyzer.fullScanTables(ORA_PLAN, "ORACLE"));
+        assertEquals(812.0, PlanAnalyzer.cost(ORA_PLAN, "ORACLE"), 0.01);
+        assertEquals("X-001", PlanAnalyzer.analyze(ORA_PLAN, "ORACLE").get(0).code());
+        String pg = "Nested Loop  (cost=0.00..1520.50 rows=10 width=8)\n  ->  Seq Scan on orders o  (cost=0.00..1200.00 rows=1 width=8)";
+        assertTrue(PlanAnalyzer.fullScanTables(pg, "PANWEI").contains("ORDERS"));
+        assertEquals(1520.5, PlanAnalyzer.cost(pg, "POSTGRESQL"), 0.01);
+        assertTrue(PlanAnalyzer.analyze(pg, "POSTGRESQL").stream().anyMatch(f -> f.code().equals("X-007")));
+        assertTrue(PlanAnalyzer.analyze(null, "ORACLE").isEmpty());
+    }
+
+    @Test
+    void indexAdviceFollowsEqualityThenRangeAndSkipsCovered() {
+        SqlAstService.SqlAnalysis a = analyze("SELECT ID FROM ORDERS WHERE CREATED_AT >= :1 AND CUST_NO = :2 ORDER BY CREATED_AT");
+        List<IndexAdvisor.IndexAdvice> adv = IndexAdvisor.advise(a, META, Set.of("ORDERS"), "ORACLE");
+        assertFalse(adv.isEmpty());
+        IndexAdvisor.IndexAdvice x = adv.get(0);
+        assertEquals(List.of("CUST_NO", "CREATED_AT"), x.columns());
+        assertNotNull(x.ddl());
+        assertTrue(x.ddl().toUpperCase().contains("ONLINE"), x.ddl());
+        assertTrue(x.fullScanInPlan());
+
+        // 已有 (STATUS) 索引覆盖 STATUS = ? → 不再建议
+        SqlAstService.SqlAnalysis b = analyze("SELECT ID FROM ORDERS WHERE STATUS = 'A'");
+        assertTrue(IndexAdvisor.advise(b, META, Set.of(), "ORACLE").stream().noneMatch(i -> i.ddl() != null));
+    }
+
+    @Test
+    void indexDdlPerDialect() {
+        SqlAstService.SqlAnalysis a = new SqlAstService().analyze("SELECT id FROM orders WHERE cust_no = $1", "POSTGRESQL", "public");
+        List<IndexAdvisor.IndexAdvice> adv = IndexAdvisor.advise(a, TableMetadata.NONE, Set.of(), "PANWEI");
+        assertTrue(adv.stream().anyMatch(i -> i.ddl() != null && i.ddl().toUpperCase().contains("CONCURRENTLY")), String.valueOf(adv));
+    }
+
+    static Map<String, RewriteEngine.Rewrite> byCode(RewriteEngine.Result r) {
+        return r.rewrites().stream().collect(java.util.stream.Collectors.toMap(RewriteEngine.Rewrite::code, x -> x, (p, q) -> p));
+    }
+
+    @Test
+    void rewritesApplyEquivalentChanges() {
+        RewriteEngine.Result r = RewriteEngine.rewrite("SELECT * FROM ORDERS WHERE TRUNC(CREATED_AT) = DATE '2026-01-01' AND CUST_NO = 123",
+                DbType.oracle, "ORACLE", META);
+        Map<String, RewriteEngine.Rewrite> m = byCode(r);
+        assertTrue(m.get("RW-01").applied());
+        assertTrue(m.get("RW-05").applied());
+        // 数字→字符会改变匹配结果（'0123' = 123 成立，'0123' = '123' 不成立），只给建议
+        assertFalse(m.get("RW-06").applied());
+        String s = r.rewrittenSql().toUpperCase();
+        assertTrue(s.contains("CUST_NO = 123"), s);
+        assertTrue(s.contains("CREATED_AT >="), s);
+        assertFalse(s.contains("TRUNC("), s);
+        assertFalse(s.contains("*"), s);
+    }
+
+    @Test
+    void functionRewriteOnlyForDateConstants() {
+        // 绑定变量可能带时间部分，TRUNC(col)=:d 与 col∈[:d, :d+1) 不等价 → 只建议
+        RewriteEngine.Result bind = RewriteEngine.rewrite("SELECT ID FROM ORDERS WHERE TRUNC(CREATED_AT) = :d", DbType.oracle, "ORACLE", META);
+        assertFalse(byCode(bind).get("RW-05").applied());
+        assertNull(bind.rewrittenSql());
+        // 带时分秒的 TO_DATE 也不改写
+        RewriteEngine.Result withTime = RewriteEngine.rewrite(
+                "SELECT ID FROM ORDERS WHERE TRUNC(CREATED_AT) = TO_DATE('2026-01-01 10:00:00','YYYY-MM-DD HH24:MI:SS')", DbType.oracle, "ORACLE", META);
+        assertFalse(byCode(withTime).get("RW-05").applied());
+        RewriteEngine.Result lit = RewriteEngine.rewrite("SELECT ID FROM ORDERS WHERE TRUNC(CREATED_AT) = TO_DATE('2026-01-01','YYYY-MM-DD')",
+                DbType.oracle, "ORACLE", META);
+        assertTrue(byCode(lit).get("RW-05").applied());
+    }
+
+    @Test
+    void notInRewrittenOnlyWhenBothSidesNotNull() {
+        String sql = "SELECT ID FROM ORDERS o WHERE o.ID NOT IN (SELECT ORDER_ID FROM REFUND) AND o.CUST_NO LIKE '%9' ORDER BY DBMS_RANDOM.VALUE";
+        RewriteEngine.Result unknown = RewriteEngine.rewrite(sql, DbType.oracle, "ORACLE", TableMetadata.NONE);
+        Map<String, RewriteEngine.Rewrite> m = byCode(unknown);
+        assertFalse(m.get("RW-02").applied());
+        assertFalse(m.get("RW-07").applied());
+        assertTrue(m.containsKey("RW-11"));
+        assertNull(unknown.rewrittenSql());
+
+        RewriteEngine.Result known = RewriteEngine.rewrite(sql, DbType.oracle, "ORACLE", META);
+        assertTrue(byCode(known).get("RW-02").applied());
+        assertTrue(known.rewrittenSql().toUpperCase().contains("NOT EXISTS"), known.rewrittenSql());
+
+        // 子查询列可空 → 不自动改写
+        RewriteEngine.Result nullable = RewriteEngine.rewrite("SELECT ID FROM ORDERS o WHERE o.ID NOT IN (SELECT CUST_NO FROM REFUND)",
+                DbType.oracle, "ORACLE", META);
+        assertFalse(byCode(nullable).get("RW-02").applied());
+
+        RewriteEngine.Result clean = RewriteEngine.rewrite("SELECT ID FROM ORDERS WHERE ID = :1", DbType.oracle, "ORACLE", META);
+        assertNull(clean.rewrittenSql());
+    }
+}
diff --git a/dbops-server/src/test/java/com/dbops/sqlinsight/rules/RuntimeRuleEngineTest.java b/dbops-server/src/test/java/com/dbops/sqlinsight/rules/RuntimeRuleEngineTest.java
new file mode 100644
index 0000000..a11dea8
--- /dev/null
+++ b/dbops-server/src/test/java/com/dbops/sqlinsight/rules/RuntimeRuleEngineTest.java
@@ -0,0 +1,104 @@
+package com.dbops.sqlinsight.rules;
+
+import com.dbops.sqlinsight.collect.ActiveSession;
+import com.dbops.sqlinsight.collect.Counter;
+import com.dbops.sqlinsight.collect.SqlCounters;
+import com.dbops.sqlinsight.collect.WindowRow;
+import org.junit.jupiter.api.Test;
+
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class RuntimeRuleEngineTest {
+
+    static RuleConfigService.RuleSetting rule(String code, Map<String, Object> p) {
+        return new RuleConfigService.RuleSetting(code, code, "RUNTIME", true, null, p);
+    }
+
+    static WindowRow row(long asset, double exec, double elapsed, double rowsEx, double rowsRet, double share) {
+        double[] d = SqlCounters.empty();
+        d[Counter.EXEC.ordinal()] = exec;
+        d[Counter.ELAPSED_MS.ordinal()] = elapsed;
+        d[Counter.ROWS_EXAMINED.ordinal()] = rowsEx;
+        d[Counter.ROWS_RETURNED.ordinal()] = rowsRet;
+        WindowRow r = new WindowRow(new SqlCounters("n" + asset, "P", "S", "x", SqlCounters.empty()), d, 1, "NORMAL");
+        r.assetId = asset;
+        r.computeMetrics(elapsed / share);
+        return r;
+    }
+
+    static RuntimeRuleEngine.Ctx ctx(Set<Counter> supported, Map<String, Map<String, Object>> params, List<Double> prevShares) {
+        return new RuntimeRuleEngine.Ctx((code, asset) -> rule(code, params.getOrDefault(code, Map.of())), supported::contains,
+                a -> prevShares, a -> List.of(), a -> 1L);
+    }
+
+    @Test
+    void slowSqlThresholdAndOverride() {
+        Map<String, Map<String, Object>> p = new HashMap<>();
+        p.put("P-003", Map.of("avgElapsedMs", 3000, "minExec", 1));
+        RuntimeRuleEngine.Result r = RuntimeRuleEngine.evaluateWindow(List.of(row(1, 2, 8000, 0, 0, 0.1), row(2, 10, 1000, 0, 0, 0.1)),
+                ctx(Set.of(Counter.EXEC, Counter.ELAPSED_MS), p, List.of()));
+        assertEquals(1, r.hits().stream().filter(h -> h.code().equals("P-003")).count());
+        assertEquals(1L, r.hits().get(0).assetId());
+        // 批处理业务覆盖到 60 秒后不再命中
+        p.put("P-003", Map.of("avgElapsedMs", 60000));
+        RuntimeRuleEngine.Result r2 = RuntimeRuleEngine.evaluateWindow(List.of(row(1, 2, 8000, 0, 0, 0.1)),
+                ctx(Set.of(Counter.EXEC, Counter.ELAPSED_MS), p, List.of()));
+        assertFalse(r2.hits().stream().anyMatch(h -> h.code().equals("P-003")));
+    }
+
+    @Test
+    void unsupportedMetricsAreSkippedNotPassed() {
+        RuntimeRuleEngine.Result r = RuntimeRuleEngine.evaluateWindow(List.of(row(1, 2, 8000, 0, 0, 0.1)),
+                ctx(Set.of(Counter.EXEC, Counter.ELAPSED_MS), Map.of(), List.of()));
+        Set<String> skipped = Set.copyOf(r.skipped().stream().map(RuntimeRuleEngine.Skip::code).toList());
+        assertTrue(skipped.contains("P-004"));   // CPU
+        assertTrue(skipped.contains("P-008"));   // 扫描行数
+        assertTrue(skipped.contains("P-011"));   // 错误数
+        assertTrue(skipped.contains("P-009"));
+        assertFalse(r.evaluatedCodes().contains("P-004"));
+        assertTrue(r.evaluatedCodes().contains("P-003"));
+    }
+
+    @Test
+    void dbTimeShareNeedsConsecutiveWindows() {
+        Set<Counter> sup = Set.of(Counter.EXEC, Counter.ELAPSED_MS);
+        RuntimeRuleEngine.Result once = RuntimeRuleEngine.evaluateWindow(List.of(row(1, 10, 100, 0, 0, 0.5)), ctx(sup, Map.of(), List.of(0.05, 0.5)));
+        assertFalse(once.hits().stream().anyMatch(h -> h.code().equals("P-007")));
+        RuntimeRuleEngine.Result three = RuntimeRuleEngine.evaluateWindow(List.of(row(1, 10, 100, 0, 0, 0.5)), ctx(sup, Map.of(), List.of(0.4, 0.3)));
+        assertTrue(three.hits().stream().anyMatch(h -> h.code().equals("P-007")));
+    }
+
+    @Test
+    void scanEfficiencyAndNoIndexApproximation() {
+        Set<Counter> sup = Set.of(Counter.EXEC, Counter.ELAPSED_MS, Counter.ROWS_EXAMINED, Counter.ROWS_RETURNED);
+        RuntimeRuleEngine.Result r = RuntimeRuleEngine.evaluateWindow(List.of(row(1, 10, 100, 2_000_000, 10, 0.1)), ctx(sup, Map.of(), List.of()));
+        assertTrue(r.hits().stream().anyMatch(h -> h.code().equals("P-008")));
+        assertTrue(r.hits().stream().anyMatch(h -> h.code().equals("P-009") && h.detail().contains("近似")));
+    }
+
+    @Test
+    void sessionRulesRespectConsecutiveSamples() {
+        ActiveSession s = new ActiveSession("12", "abc", "S", "select 1", 15, null, 0, false, null);
+        Map<String, Integer> streak = new HashMap<>();
+        List<RuntimeRuleEngine.SessionHit> first = RuntimeRuleEngine.evaluateSessions(List.of(s), x -> 5L,
+                (c, a) -> rule(c, Map.of()), k -> streak.getOrDefault(k, 0));
+        assertTrue(first.stream().noneMatch(h -> h.severity() != null));      // 第一次只计数
+        for (RuntimeRuleEngine.SessionHit h : first) {
+            streak.merge(h.code() + "|" + h.sessionKey(), 1, Integer::sum);
+        }
+        List<RuntimeRuleEngine.SessionHit> second = RuntimeRuleEngine.evaluateSessions(List.of(s), x -> 5L,
+                (c, a) -> rule(c, Map.of()), k -> streak.getOrDefault(k, 0));
+        assertTrue(second.stream().anyMatch(h -> h.code().equals("P-002") && "CRITICAL".equals(h.severity())));
+        assertFalse(second.stream().anyMatch(h -> h.code().equals("P-001")));   // 命中 P-002 不再报 P-001
+        ActiveSession lock = new ActiveSession("13", "def", "S", "update t", 30, "enq: TX - row lock contention", 25, true, "99");
+        List<RuntimeRuleEngine.SessionHit> l = RuntimeRuleEngine.evaluateSessions(List.of(lock), x -> 6L, (c, a) -> rule(c, Map.of()), k -> 0);
+        assertTrue(l.stream().anyMatch(h -> h.code().equals("P-010") && h.detail().contains("99")));
+    }
+}
