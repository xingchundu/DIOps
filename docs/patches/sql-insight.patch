+        for (Map<String, Object> r : safeList(() -> db.query("SELECT INSTANCE_ID, COUNT(*) TOTAL, SUM(REACHABLE) UP, MIN(COLLECTED_AT) FIRST_AT, MAX(COLLECTED_AT) LAST_AT, "
