+++ b/dbops-server/src/test/java/com/dbops/sqlinsight/anomaly/AnomalyDetectorTest.java
@@ -0,0 +1,83 @@
+package com.dbops.sqlinsight.anomaly;
+
+import com.dbops.sqlinsight.baseline.Baseline;
+import com.dbops.sqlinsight.collect.Metric;
+import org.junit.jupiter.api.Test;
+
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class AnomalyDetectorTest {
+
+    static final AnomalyDetector.Params P = AnomalyDetector.Params.DEFAULTS;
+    static final AnomalyDetector.Spec ELAPSED = AnomalyDetector.SPECS.get(0);
+
+    static AnomalyDetector.Spec spec(Metric m, AnomalyDetector.Direction d) {
+        return AnomalyDetector.SPECS.stream().filter(s -> s.metric() == m && s.direction() == d).findFirst().orElseThrow();
+    }
+
+    @Test
+    void allFiveChecksMustPass() {
+        Baseline b = new Baseline(100, 10, 200, "WD-9");
+        assertTrue(AnomalyDetector.check(ELAPSED, 400.0, b, 50, true, P).hit());
+        // 1 样本不足
+        assertFalse(AnomalyDetector.check(ELAPSED, 400.0, new Baseline(100, 10, 10, "WD-9"), 50, true, P).hit());
+        // 2 倍率不足
+        assertEquals("倍率不足", AnomalyDetector.check(ELAPSED, 180.0, b, 50, true, P).reason());
+        // 4 绝对变化量不足：2ms → 6ms
+        assertFalse(AnomalyDetector.check(ELAPSED, 6.0, new Baseline(2, 0.5, 200, "R24"), 50, true, P).hit());
+        assertEquals("绝对变化量不足", AnomalyDetector.check(ELAPSED, 60.0, new Baseline(12, 0.5, 200, "R24"), 50, true, P).reason());
+        // 5 执行次数不足 / 数据质量
+        assertFalse(AnomalyDetector.check(ELAPSED, 400.0, b, 2, true, P).hit());
+        assertFalse(AnomalyDetector.check(ELAPSED, 400.0, b, 50, false, P).hit());
+    }
+
+    @Test
+    void zScoreGuardsNoisySql() {
+        // 基线波动大（MAD 很大）时 2.5 倍也不算异常
+        assertEquals("Z 分数不足", AnomalyDetector.check(ELAPSED, 250.0, new Baseline(100, 80, 200, "WD-9"), 50, true, P).reason());
+    }
+
+    @Test
+    void zeroMadDoesNotExplode() {
+        AnomalyDetector.Check c = AnomalyDetector.check(ELAPSED, 400.0, new Baseline(100, 0, 200, "WD-9"), 50, true, P);
+        assertTrue(c.hit());
+        assertTrue(Double.isFinite(c.z()));
+    }
+
+    @Test
+    void execDropDirection() {
+        AnomalyDetector.Spec down = spec(Metric.EXEC_PER_MIN, AnomalyDetector.Direction.DOWN);
+        assertTrue(AnomalyDetector.check(down, 50.0, new Baseline(1000, 50, 200, "WD-9"), 50, true, P).hit());
+        assertFalse(AnomalyDetector.check(down, 900.0, new Baseline(1000, 50, 200, "WD-9"), 900, true, P).hit());
+        assertFalse(AnomalyDetector.bit(down) == AnomalyDetector.bit(spec(Metric.EXEC_PER_MIN, AnomalyDetector.Direction.UP)));
+    }
+
+    @Test
+    void sustainedIsThreeOfFive() {
+        int bit = AnomalyDetector.bit(ELAPSED);
+        assertTrue(AnomalyDetector.sustained(List.of(bit, 0, bit, bit, 0), bit, P));
+        assertFalse(AnomalyDetector.sustained(List.of(bit, 0, 0, bit, 0, bit), bit, P));
+        assertFalse(AnomalyDetector.sustained(null, bit, P));
+    }
+
+    @Test
+    void recoveryAndSeverity() {
+        Baseline b = new Baseline(100, 10, 200, "WD-9");
+        assertTrue(AnomalyDetector.stillElevated(ELAPSED, 160.0, b, P));
+        assertFalse(AnomalyDetector.stillElevated(ELAPSED, 140.0, b, P));
+        assertEquals("CRITICAL", AnomalyDetector.severity(6, 0.01));
+        assertEquals("CRITICAL", AnomalyDetector.severity(2.5, 0.3));
+        assertEquals("WARNING", AnomalyDetector.severity(2.5, 0.05));
+    }
+
+    @Test
+    void zeroMedianRatioIsCappedNotInfinite() {
+        AnomalyDetector.Check c = AnomalyDetector.check(ELAPSED, 400.0, new Baseline(0, 0, 200, "WD-9"), 50, true, P);
+        assertTrue(Double.isFinite(c.ratio()));
+        assertEquals(AnomalyDetector.RATIO_CAP, c.ratio());
+    }
+}
diff --git a/dbops-server/src/test/java/com/dbops/sqlinsight/ast/SqlAstServiceTest.java b/dbops-server/src/test/java/com/dbops/sqlinsight/ast/SqlAstServiceTest.java
new file mode 100644
index 0000000..0a58b9a
--- /dev/null
+++ b/dbops-server/src/test/java/com/dbops/sqlinsight/ast/SqlAstServiceTest.java
@@ -0,0 +1,85 @@
+package com.dbops.sqlinsight.ast;
+
+import org.junit.jupiter.api.Test;
+
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+/** 真实 Druid 解析器：指纹归一化 + 危险语句识别 */
+class SqlAstServiceTest {
+
+    private final SqlAstService ast = new SqlAstService();
+
+    @Test
+    void literalsAndInListsShareFingerprint() {
+        SqlAstService.SqlAnalysis a = ast.analyze("select * from emp where empno = 7369 and ename in ('A','B')", "ORACLE", "scott");
+        SqlAstService.SqlAnalysis b = ast.analyze("SELECT *  FROM emp WHERE empno=1 AND ename IN ('X','Y','Z')", "ORACLE", "SCOTT");
+        assertTrue(a.parsed());
+        assertEquals(a.fingerprint(), b.fingerprint());
+        assertEquals("SELECT", a.stmtType());
+    }
+
+    @Test
+    void bindVariablesNormalizeLikeLiterals() {
+        String a = ast.analyze("select name from t where id = :1", "ORACLE", null).fingerprint();
+        String b = ast.analyze("select name from t where id = 42", "ORACLE", null).fingerprint();
+        assertEquals(a, b);
+        String pg1 = ast.analyze("select name from t where id = $1", "POSTGRESQL", null).fingerprint();
+        String pg2 = ast.analyze("select name from t where id = 5", "POSTGRESQL", null).fingerprint();
+        assertEquals(pg1, pg2);
+    }
+
+    @Test
+    void schemaAndDialectAreSeparateAssets() {
+        String a = ast.analyze("select 1 from t where x = 1", "ORACLE", "A").fingerprint();
+        String b = ast.analyze("select 1 from t where x = 1", "ORACLE", "B").fingerprint();
+        String c = ast.analyze("select 1 from t where x = 1", "MYSQL", "A").fingerprint();
+        assertFalse(a.equals(b));
+        assertFalse(a.equals(c));
+        // GoldenDB 与 MySQL 同族
+        assertEquals(ast.analyze("select 1 from t", "MYSQL", null).fingerprint(), ast.analyze("select 1 from t", "GOLDENDB", null).fingerprint());
+    }
+
+    @Test
+    void mysqlDigestTextParses() {
+        SqlAstService.SqlAnalysis a = ast.analyze("SELECT `a` FROM `t1` WHERE `id` IN (...) AND `x` = ?", "MYSQL", "db1");
+        assertTrue(a.parsed());
+        assertEquals(a.fingerprint(), ast.analyze("SELECT a FROM t1 WHERE id IN (1,2,3) AND x = 'q'", "MYSQL", "db1").fingerprint());
+    }
+
+    @Test
+    void parseFailureFallsBackToTextNormalization() {
+        SqlAstService.SqlAnalysis a = ast.analyze("select id from t1 where id = 5 and garbage(((", "ORACLE", null);
+        SqlAstService.SqlAnalysis b = ast.analyze("select id from t1 where id = 6 and garbage(((", "ORACLE", null);
+        assertFalse(a.parsed());
+        assertEquals(a.fingerprint(), b.fingerprint());
+    }
+
+    @Test
+    void dangerousDetectionCannotBeBypassed() {
+        assertNull(ast.dangerousType("select * from t", "ORACLE"));
+        assertEquals("DDL", ast.dangerousType("/* harmless */ DROP TABLE t", "ORACLE"));
+        assertEquals("DELETE", ast.dangerousType("select 1 from dual; delete from t", "ORACLE"));
+        assertEquals("DELETE", ast.dangerousType("WITH x AS (SELECT id FROM a) DELETE FROM b WHERE id IN (SELECT id FROM x)", "POSTGRESQL"));
+        assertEquals("UNKNOWN", ast.dangerousType("BEGIN delete_all; END;", "ORACLE"));
+        assertEquals("DCL", ast.dangerousType("grant select on t to u", "MYSQL"));
+        assertEquals("DDL", ast.dangerousType("truncate table t", "MYSQL"));
+    }
+
+    @Test
+    void classifyKeepsEveryStatement() {
+        List<String> t = ast.classify("select 1; update t set a = 1 where id = 2", "MYSQL");
+        assertEquals(2, t.size());
+        assertEquals("UPDATE", t.get(1));
+    }
+
+    @Test
+    void tablesExtracted() {
+        SqlAstService.SqlAnalysis a = ast.analyze("select e.ename from emp e join dept d on e.deptno = d.deptno", "ORACLE", null);
+        assertEquals(2, a.tables().size());
+    }
+}
diff --git a/dbops-server/src/test/java/com/dbops/sqlinsight/ast/StaticRuleEngineTest.java b/dbops-server/src/test/java/com/dbops/sqlinsight/ast/StaticRuleEngineTest.java
