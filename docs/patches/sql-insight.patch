-async function checkTableSqlServer(pool, schema, tableName) {
-  const sch = schema ? String(schema) : 'dbo';
-  const r = await pool.request()
-    .input('schema', sql.VarChar, sch)
-    .input('table', sql.VarChar, tableName)
-    .query(
-      `SELECT COUNT(*) AS c FROM INFORMATION_SCHEMA.TABLES
-       WHERE TABLE_SCHEMA = @schema AND TABLE_NAME = @table`
-    );
-  const exists = Number(r.recordset?.[0]?.c || 0) > 0;
-  return { exists, message: exists ? '表存在' : '表不存在' };
