diff --git a/dbops-server/src/main/java/com/dbops/sqlinsight/SqlInsightScheduler.java b/dbops-server/src/main/java/com/dbops/sqlinsight/SqlInsightScheduler.java
new file mode 100644
index 0000000..3c1c20f
--- /dev/null
+++ b/dbops-server/src/main/java/com/dbops/sqlinsight/SqlInsightScheduler.java
@@ -0,0 +1,216 @@
+package com.dbops.sqlinsight;
+
+import com.dbops.config.DbopsProperties;
+import com.dbops.service.SystemConfigService;
+import com.dbops.sqlinsight.anomaly.AnomalyService;
+import com.dbops.sqlinsight.baseline.BaselineService;
+import com.dbops.sqlinsight.collect.SqlCollectService;
+import com.dbops.sqlinsight.collect.SlowSqlService;
+import com.dbops.sqlinsight.store.InstanceDirectory;
+import com.dbops.sqlinsight.store.StatsRepo;
+import jakarta.annotation.PreDestroy;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.boot.context.event.ApplicationReadyEvent;
+import org.springframework.context.event.EventListener;
+import org.springframework.stereotype.Component;
+
+import java.util.concurrent.Executors;
+import java.util.concurrent.LinkedBlockingQueue;
+import java.util.concurrent.ScheduledExecutorService;
+import java.util.concurrent.ThreadPoolExecutor;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicBoolean;
+
+/**
+ * SQL 洞察调度：与监控调度器共用 MONITOR_SCHEDULER_ENABLED（Java 接管后 Node 侧关闭即可，不会双采），
+ * 各阶段再由 SYS_CONFIG 的 sqlinsight.* 开关控制。
+ * <ul>
+ *   <li>分钟采集：每 sqlinsight.collect.interval_sec（默认 60s）一轮，实例并发度 sqlinsight.collect.parallel</li>
+ *   <li>活动会话采样：每 sqlinsight.sampler.interval_sec（默认 15s）</li>
+ *   <li>慢 SQL 快照：每 sqlinsight.slow.capture_interval_min（默认 30 分钟）一批，写 SQL_SLOW_SUMMARY</li>
+ *   <li>每小时：基线刷新 + 缓慢劣化判断 + 过期数据清理</li>
+ * </ul>
+ */
+@Component
+public class SqlInsightScheduler {
+
+    private static final Logger log = LoggerFactory.getLogger(SqlInsightScheduler.class);
+
+    private final SqlCollectService collect;
+    private final SlowSqlService slowSql;
+    private volatile long lastSlowRound;
+    private final BaselineService baselines;
+    private final AnomalyService anomalies;
+    private final InstanceDirectory instances;
+    private final StatsRepo stats;
+    private final SystemConfigService cfg;
+    private final boolean enabled;
+    private final com.dbops.license.LicenseService license;
+    private final ScheduledExecutorService ses = Executors.newScheduledThreadPool(3, r -> {
+        Thread t = new Thread(r, "sqlinsight-scheduler");
+        t.setDaemon(true);
+        return t;
+    });
+    // 有界队列 + 同一任务（类型+实例）排队中不重复入队：原来是无界队列，实例多/目标库慢时
+    // 每轮都给同一实例再排一个任务，队列越积越长、内存上涨、采集严重滞后
+    private final ThreadPoolExecutor workers = new ThreadPoolExecutor(4, 4, 60, TimeUnit.SECONDS, new LinkedBlockingQueue<>(2000), r -> {
+        Thread t = new Thread(r, "sqlinsight-worker");
+        t.setDaemon(true);
+        return t;
+    }, new ThreadPoolExecutor.AbortPolicy());
+    private final java.util.Set<String> queued = java.util.concurrent.ConcurrentHashMap.newKeySet();
+
+    /** 同一 key 已在排队则跳过；队列满则本轮跳过（下一轮会再来） */
+    private void submitOnce(String key, Runnable job) {
+        if (!queued.add(key)) {
+            return;
+        }
+        try {
+            workers.execute(() -> {
+                queued.remove(key);
+                job.run();
+            });
+        } catch (java.util.concurrent.RejectedExecutionException e) {
+            queued.remove(key);
+        }
+    }
+    private final AtomicBoolean hourly = new AtomicBoolean(false);
+
+    public SqlInsightScheduler(SqlCollectService collect, BaselineService baselines, AnomalyService anomalies, InstanceDirectory instances,
+                               StatsRepo stats, SystemConfigService cfg, DbopsProperties props, SlowSqlService slowSql,
+                               com.dbops.license.LicenseService license) {
+        this.license = license;
+        this.collect = collect;
+        this.slowSql = slowSql;
+        this.baselines = baselines;
+        this.anomalies = anomalies;
+        this.instances = instances;
+        this.stats = stats;
+        this.cfg = cfg;
+        this.enabled = props.getMonitor().isSchedulerEnabled();
+    }
+
+    @EventListener(ApplicationReadyEvent.class)
+    public void start() {
+        if (!enabled) {
+            log.info("[sqlinsight] scheduler disabled (MONITOR_SCHEDULER_ENABLED=false)");
+            return;
+        }
+        int parallel = (int) Math.max(1, Math.min(32, cfg.getLong("sqlinsight.collect.parallel", 4)));
+        workers.setMaximumPoolSize(Math.max(parallel, workers.getCorePoolSize()));
+        workers.setCorePoolSize(parallel);
+        workers.setMaximumPoolSize(parallel);
+        long interval = Math.max(30, cfg.getLong("sqlinsight.collect.interval_sec", 60));
+        long sampler = Math.max(5, cfg.getLong("sqlinsight.sampler.interval_sec", 15));
+        // 对齐到整分钟后 5 秒，让窗口起点稳定
+        long delay = 65_000 - System.currentTimeMillis() % 60_000;
+        ses.scheduleAtFixedRate(this::collectRound, delay, interval * 1000, TimeUnit.MILLISECONDS);
+        ses.scheduleWithFixedDelay(this::sampleRound, 20_000, sampler * 1000, TimeUnit.MILLISECONDS);
+        ses.scheduleWithFixedDelay(this::hourlyRound, 10 * 60_000L, 3600_000L, TimeUnit.MILLISECONDS);
+        ses.scheduleWithFixedDelay(this::slowRound, 3 * 60_000L, 60_000L, TimeUnit.MILLISECONDS);
+        log.info("[sqlinsight] scheduler started: collect {}s, sampler {}s, parallel {}", interval, sampler, parallel);
+    }
+
+    @PreDestroy
+    public void stop() {
+        ses.shutdownNow();
+        workers.shutdownNow();
+    }
+
+    void collectRound() {
+        if (!license.backgroundAllowed()) {
+            return;   // 授权到期超过宽限期：SQL 采集 / 检测停止
+        }
+        if (!cfg.getBool("sqlinsight.collect.enabled", true)) {
+            return;
+        }
+        try {
+            for (InstanceDirectory.Inst i : instances.collectable()) {
+                if (!collect.isRunning(i.id())) {
+                    submitOnce("collect:" + i.id(), () -> collect.collect(i.id()));
+                }
+            }
+        } catch (Exception e) {
+            log.warn("[sqlinsight] collect round: {}", e.getMessage());
+        }
+    }
+
+    void sampleRound() {
+        if (!license.backgroundAllowed()) {
+            return;   // 授权到期超过宽限期：SQL 采集 / 检测停止
+        }
+        if (!cfg.getBool("sqlinsight.collect.enabled", true) || !cfg.getBool("sqlinsight.rules.enabled", true)) {
+            return;
+        }
+        try {
+            for (InstanceDirectory.Inst i : instances.collectable()) {
+                submitOnce("sample:" + i.id(), () -> collect.sampleSessions(i.id()));
+            }
+        } catch (Exception e) {
+            log.warn("[sqlinsight] sampler round: {}", e.getMessage());
+        }
+    }
+
+    /** 定时慢 SQL 快照：每 sqlinsight.slow.capture_interval_min 分钟一批（0 = 只手动采集） */
+    void slowRound() {
+        if (!license.backgroundAllowed()) {
+            return;   // 授权到期超过宽限期：SQL 采集 / 检测停止
+        }
+        long intervalMin = cfg.getLong("sqlinsight.slow.capture_interval_min", 30);
+        if (intervalMin <= 0 || System.currentTimeMillis() - lastSlowRound < intervalMin * 60_000L - 5_000L) {
+            return;
+        }
+        lastSlowRound = System.currentTimeMillis();
+        try {
+            for (InstanceDirectory.Inst i : instances.collectable()) {
+                if (!slowSql.isRunning(i.id())) {
+                    submitOnce("slow:" + i.id(), () -> {
+                        try {
+                            slowSql.capture(i.id(), "SCHEDULE", null);
+                        } catch (Exception e) {
+                            log.warn("[sqlinsight] slow capture inst={}: {}", i.id(), e.getMessage());
+                        }
+                    });
+                }
+            }
+        } catch (Exception e) {
+            log.warn("[sqlinsight] slow round: {}", e.getMessage());
+        }
+    }
+
+    void hourlyRound() {
+        if (!license.backgroundAllowed()) {
+            return;   // 授权到期超过宽限期：SQL 采集 / 检测停止
+        }
+        if (!hourly.compareAndSet(false, true)) {
+            return;
+        }
+        try {
+            boolean anomalyOn = cfg.getBool("sqlinsight.anomaly.enabled", true);
+            for (InstanceDirectory.Inst i : instances.collectable()) {
+                try {
+                    if (anomalyOn) {
+                        baselines.refresh(i.id());
+                        anomalies.processDegradations(i, baselines.slowDegradation(i.id(), cfg.getNumber("sqlinsight.anomaly.degradation_ratio", 1.5)));
+                    }
+                } catch (Exception e) {
+                    log.warn("[sqlinsight] hourly inst={}: {}", i.id(), e.getMessage());
+                }
+            }
+            int purged = stats.purge((int) cfg.getLong("sqlinsight.retention.stats_days", 35));
+            try {
+                purged += slowSql.purge((int) cfg.getLong("sqlinsight.retention.slow_days", 30));
+            } catch (Exception e) {
+                log.warn("[sqlinsight] purge slow sql: {}", e.getMessage());
+            }
+            if (purged > 0) {
+                log.info("[sqlinsight] purged {} stats rows", purged);
+            }
+        } catch (Exception e) {
+            log.warn("[sqlinsight] hourly round: {}", e.getMessage());
+        } finally {
+            hourly.set(false);
+        }
+    }
+}
diff --git a/dbops-server/src/main/java/com/dbops/sqlinsight/anomaly/AnomalyDetector.java b/dbops-server/src/main/java/com/dbops/sqlinsight/anomaly/AnomalyDetector.java
new file mode 100644
index 0000000..da330ce
--- /dev/null
+++ b/dbops-server/src/main/java/com/dbops/sqlinsight/anomaly/AnomalyDetector.java
@@ -0,0 +1,129 @@
+package com.dbops.sqlinsight.anomaly;
+
+import com.dbops.sqlinsight.baseline.Baseline;
+import com.dbops.sqlinsight.baseline.RobustStats;
+import com.dbops.sqlinsight.collect.Metric;
+
+import java.util.List;
+
+/**
+ * 波动判定（设计方案 5.3）。纯函数。
+ * <p>
+ * 单窗口“五项判定”全部满足才记一次命中：
+ * <ol>
+ *   <li>基线可用：样本数 ≥ minSamples</li>
+ *   <li>倍率：当前值 / 基线中位数 ≥ ratio（下降类指标 ≤ 1/ratio）</li>
+ *   <li>稳健 Z 分数 ≥ z</li>
+ *   <li>绝对变化量 ≥ minAbs（避免 1ms → 3ms 这种“翻倍”）</li>
+ *   <li>样本量：本窗口执行次数 ≥ minExec，且数据质量 NORMAL</li>
+ * </ol>
+ * 波动类型：
+ * <ul>
+ *   <li>SPIKE 突增：单窗口命中且倍率 ≥ spikeRatio（只记录，不告警）</li>
+ *   <li>SUSTAINED 持续升高：最近 window 个窗口中命中 ≥ need 个（默认 5 中 3）</li>
+ *   <li>SLOW_DEGRADATION 缓慢劣化：按天判断，见 BaselineService.detectDegradation</li>
+ * </ul>
+ * 恢复：连续 recoverWindows 个窗口当前值 &lt; recoverRatio × 基线。
+ */
+public final class AnomalyDetector {
+
+    public enum Direction { UP, DOWN }
+
+    /** 指标的检测参数 */
+    public record Spec(Metric metric, Direction direction, double ratio, double minAbs) {
+    }
+
+    /** 检测全局参数（SYS_CONFIG 可调） */
+    public record Params(int minSamples, double z, int minExec, double spikeRatio, int window, int need,
+                         double recoverRatio, int recoverWindows) {
+        public static final Params DEFAULTS = new Params(30, 3.5, 5, 5.0, 5, 3, 1.5, 10);
+    }
+
+    public record Check(boolean hit, double ratio, double z, String reason) {
+    }
+
+    public static final List<Spec> SPECS = List.of(
+            new Spec(Metric.AVG_ELAPSED_MS, Direction.UP, 2.0, 50),
+            new Spec(Metric.CPU_PER_EXEC_MS, Direction.UP, 2.0, 20),
+            new Spec(Metric.LOGICAL_READS_PER_EXEC, Direction.UP, 2.0, 1000),
+            new Spec(Metric.PHYSICAL_READS_PER_EXEC, Direction.UP, 3.0, 100),
+            new Spec(Metric.ROWS_EXAMINED_PER_EXEC, Direction.UP, 2.0, 1000),
+            new Spec(Metric.SCAN_RATIO, Direction.UP, 3.0, 10),
+            new Spec(Metric.EXEC_PER_MIN, Direction.UP, 3.0, 100),
+            new Spec(Metric.EXEC_PER_MIN, Direction.DOWN, 3.0, 100),
+            new Spec(Metric.DB_TIME_SHARE, Direction.UP, 2.0, 0.05),
+            new Spec(Metric.ERROR_RATE, Direction.UP, 3.0, 0.01));
+
+    /** 倍率上限（写库与展示用） */
+    public static final double RATIO_CAP = 999;
+
+    private AnomalyDetector() {
+    }
+
+    public static Check check(Spec s, Double current, Baseline b, double execInWindow, boolean normalQuality, Params p) {
+        if (current == null || Double.isNaN(current) || Double.isInfinite(current)) {
+            return new Check(false, 0, 0, "无当前值");
+        }
+        if (b == null || b.samples() < p.minSamples()) {
+            return new Check(false, 0, 0, "基线样本不足");
+        }
+        if (!normalQuality) {
+            return new Check(false, 0, 0, "数据质量非 NORMAL");
+        }
+        double med = b.median();
+        // 基线中位数为 0（平时几乎不执行/不报错）时倍率没有意义：原来记为 Infinity，写库（NUMBER）与 JSON 序列化都会出错。
+        // 以 RATIO_CAP 封顶，是否告警仍由 Z 分数与绝对变化量共同决定
+        double ratio = med > 0 ? Math.min(current / med, RATIO_CAP) : (current > 0 ? RATIO_CAP : 1);
+        double z = RobustStats.robustZ(current, med, b.mad(), 0.05, s.minAbs() / 10);
+        boolean ratioOk;
+        boolean absOk;
+        if (s.direction() == Direction.UP) {
+            ratioOk = ratio >= s.ratio();
+            absOk = current - med >= s.minAbs();
+            // 执行次数类指标本身就是样本量，其余指标要求本窗口有足够执行次数
+            if (s.metric() != Metric.EXEC_PER_MIN && execInWindow < p.minExec()) {
+                return new Check(false, ratio, z, "本窗口执行次数不足");
+            }
+        } else {
+            ratioOk = ratio <= 1.0 / s.ratio();
+            absOk = med - current >= s.minAbs();
+        }
+        boolean zOk = z >= p.z();
+        boolean hit = ratioOk && zOk && absOk;
+        return new Check(hit, ratio, z, hit ? "命中" : (!ratioOk ? "倍率不足" : !zOk ? "Z 分数不足" : "绝对变化量不足"));
+    }
+
+    /** flags（新→旧，含本窗口）里该位为 1 的个数是否满足“window 中 need” */
+    public static boolean sustained(List<Integer> flagsNewestFirst, int bit, Params p) {
+        if (flagsNewestFirst == null) {
+            return false;
+        }
+        int hits = 0;
+        for (int i = 0; i < Math.min(p.window(), flagsNewestFirst.size()); i++) {
+            Integer f = flagsNewestFirst.get(i);
+            if (f != null && (f & bit) != 0) {
+                hits++;
+            }
+        }
+        return hits >= p.need();
+    }
+
+    public static int bit(Spec s) {
+        // DOWN 方向占用高位，避免和同一指标的 UP 冲突
+        return s.direction() == Direction.UP ? s.metric().bit() : (s.metric().bit() << 16);
+    }
+
+    /** 是否仍处于“未恢复”状态（用于恢复计数） */
+    public static boolean stillElevated(Spec s, Double current, Baseline b, Params p) {
+        if (current == null || b == null || b.median() <= 0) {
+            return false;
+        }
+        double r = current / b.median();
+        return s.direction() == Direction.UP ? r >= p.recoverRatio() : r <= 1.0 / p.recoverRatio();
+    }
+
+    /** 级别：倍率 ≥ 5 或资源占比 ≥ 20% 为 CRITICAL */
+    public static String severity(double ratio, Double dbTimeShare) {
+        return ratio >= 5 || (dbTimeShare != null && dbTimeShare >= 0.2) ? "CRITICAL" : "WARNING";
+    }
+}
