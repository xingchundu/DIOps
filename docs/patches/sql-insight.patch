-  try {
-    const r = await pool.request().query(sqlText);
-    const lines = (r.recordset || []).map((row) => row.StmtText || row.stmttext || Object.values(row).join(' '));
-    return ['[SQL Server] Execution Plan:', '-'.repeat(50), ...(lines.length ? lines : ['(无计划输出)'])].join('\n');
