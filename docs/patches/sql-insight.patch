-  }
-  const r = await conn.execute(
-    `SELECT COUNT(*) C FROM ALL_TABLES WHERE OWNER=:1 AND TABLE_NAME=:2`,
-    [owner, String(tableName).toUpperCase()],
-    { outFormat: oracledb.OUT_FORMAT_OBJECT }
