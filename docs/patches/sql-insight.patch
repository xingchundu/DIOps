@@ -0,0 +1,46 @@
+package com.dbops.sqlinsight.store;
+
+import com.fasterxml.jackson.core.type.TypeReference;
+import com.fasterxml.jackson.databind.ObjectMapper;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+
+/** 模块内 JSON 小工具 */
+public final class Json {
+    public static final ObjectMapper MAPPER = new ObjectMapper();
+
+    private Json() {
+    }
+
+    public static String write(Object o) {
+        try {
+            return MAPPER.writeValueAsString(o);
+        } catch (Exception e) {
+            return "{}";
+        }
+    }
+
+    public static Map<String, Object> map(String s) {
+        if (s == null || s.isBlank()) {
+            return new LinkedHashMap<>();
+        }
+        try {
+            return MAPPER.readValue(s, new TypeReference<LinkedHashMap<String, Object>>() {
+            });
+        } catch (Exception e) {
+            return new LinkedHashMap<>();
+        }
+    }
+
+    public static Object any(String s) {
+        if (s == null || s.isBlank()) {
+            return null;
+        }
+        try {
+            return MAPPER.readValue(s, Object.class);
+        } catch (Exception e) {
+            return s;
+        }
+    }
+}
diff --git a/dbops-server/src/main/java/com/dbops/sqlinsight/store/StatsRepo.java b/dbops-server/src/main/java/com/dbops/sqlinsight/store/StatsRepo.java
new file mode 100644
index 0000000..94a19d5
--- /dev/null
+++ b/dbops-server/src/main/java/com/dbops/sqlinsight/store/StatsRepo.java
@@ -0,0 +1,195 @@
+package com.dbops.sqlinsight.store;
+
+import com.dbops.common.Db;
+import com.dbops.common.Values;
+import com.dbops.sqlinsight.collect.Counter;
+import com.dbops.sqlinsight.collect.Metric;
+import com.dbops.sqlinsight.collect.WindowRow;
+import org.springframework.stereotype.Component;
+
+import java.sql.Timestamp;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * 分钟统计、能力矩阵、变更窗口的读写。分钟统计按 (实例, 资产, 计划, 窗口起点) 幂等 —— 重复执行/补采不会产生重复行。
+ * 数据量大时可把本类换成 ClickHouse 实现，接口不变。
+ */
+@Component
+public class StatsRepo {
+
+    private static final String[] VALUE_COLS = {"WINDOW_MINUTES", "BATCH_ID", "DATA_QUALITY",
+            "EXCLUDE_BASELINE", "ANOMALY_FLAGS", "D_EXEC", "D_ELAPSED_MS", "D_CPU_MS", "D_LOGICAL_READS", "D_PHYSICAL_READS", "D_ROWS_EXAMINED",
+            "D_ROWS_RETURNED", "D_ERRORS", "D_TMP_DISK", "D_NO_INDEX", "AVG_ELAPSED_MS", "CPU_PER_EXEC_MS", "LOGICAL_READS_PER_EXEC",
+            "PHYSICAL_READS_PER_EXEC", "ROWS_EXAMINED_PER_EXEC", "SCAN_RATIO", "EXEC_PER_MIN", "DB_TIME_SHARE", "ERROR_RATE"};
+
+    /**
+     * 同一窗口重复写入（采集重试 / 两个节点同时采集）时以最新一次为准。
+     * 原来只有 WHEN NOT MATCHED：重试时新数据被静默丢弃，返回的“写入行数”却照样计数。
+     */
+    static final String MERGE_STATS = buildMerge();
+
+    private static String buildMerge() {
+        StringBuilder using = new StringBuilder("SELECT ? AS I, ? AS A, ? AS P, ? AS W");
+        StringBuilder set = new StringBuilder();
+        StringBuilder cols = new StringBuilder("INSTANCE_ID, ASSET_ID, PLAN_HASH, WINDOW_START");
+        StringBuilder vals = new StringBuilder("s.I, s.A, s.P, s.W");
+        for (String c : VALUE_COLS) {
+            using.append(", ? AS ").append(c);
+            set.append(set.length() == 0 ? "" : ", ").append("t.").append(c).append(" = s.").append(c);
+            cols.append(", ").append(c);
+            vals.append(", s.").append(c);
+        }
+        return "MERGE INTO DI_SQL_STATS_MIN t USING (" + using + " FROM DUAL) s "
+                + "ON (t.INSTANCE_ID = s.I AND t.ASSET_ID = s.A AND t.PLAN_HASH = s.P AND t.WINDOW_START = s.W) "
+                + "WHEN MATCHED THEN UPDATE SET " + set + " "
+                + "WHEN NOT MATCHED THEN INSERT (" + cols + ") VALUES (" + vals + ")";
+    }
+
+    private final Db db;
+
+    public StatsRepo(Db db) {
+        this.db = db;
+    }
+
+    public int insertWindow(long instanceId, Timestamp windowStart, String batchId, List<WindowRow> rows) {
+        if (rows.isEmpty()) {
+            return 0;
+        }
+        List<Object[]> batch = new ArrayList<>(rows.size());
+        for (WindowRow r : rows) {
+            List<Object> a = new ArrayList<>(32);
+            a.add(instanceId);
+            a.add(r.assetId);
+            a.add(Values.truncate(r.cur.planHash(), 64));
+            a.add(windowStart);
+            a.add(Values.round(r.minutes, 2));
+            a.add(batchId);
+            a.add(r.quality);
+            a.add(r.excludeBaseline ? 1 : 0);
+            a.add(r.anomalyFlags);
+            for (Counter c : Counter.values()) {
+                a.add(num(r.d(c)));
+            }
+            for (Metric m : Metric.values()) {
+                a.add(num(r.m(m)));
+            }
+            batch.add(a.toArray());
+        }
+        int[] res = db.jdbc().batchUpdate(MERGE_STATS, batch);
+        int n = 0;
+        for (int x : res) {
+            n += Math.max(x, 0) > 0 || x == java.sql.Statement.SUCCESS_NO_INFO ? 1 : 0;
+        }
+        return n;
+    }
+
+    static Object num(Double v) {
+        return v == null || v.isNaN() || v.isInfinite() ? null : Values.round(v, 6);
+    }
+
+    static Object num(double v) {
+        return Double.isNaN(v) || Double.isInfinite(v) ? null : Values.round(v, 6);
+    }
+
+    // ------------------------------------------------------------------ 能力矩阵
+
+    public void saveCapability(long instanceId, Map<String, Boolean> caps, String source, String detail) {
+        List<Object[]> batch = new ArrayList<>();
+        for (Map.Entry<String, Boolean> e : caps.entrySet()) {
+            batch.add(new Object[]{instanceId, e.getKey(), e.getValue() ? 1 : 0, source, Values.truncate(detail, 1000)});
+        }
+        batch.add(new Object[]{instanceId, "_source", detail == null ? 1 : 0, source, Values.truncate(detail, 1000)});
+        db.jdbc().batchUpdate("MERGE INTO DI_SQL_CAPABILITY t USING (SELECT ? AS I, ? AS M, ? AS S, ? AS SRC, ? AS D FROM DUAL) s "
+                + "ON (t.INSTANCE_ID = s.I AND t.METRIC = s.M) "
+                + "WHEN MATCHED THEN UPDATE SET SUPPORTED = s.S, SOURCE = s.SRC, DETAIL = s.D, PROBED_AT = SYSTIMESTAMP "
+                + "WHEN NOT MATCHED THEN INSERT (INSTANCE_ID, METRIC, SUPPORTED, SOURCE, DETAIL) VALUES (s.I, s.M, s.S, s.SRC, s.D)", batch);
+    }
+
+    public void saveCapability(long instanceId, String metric, boolean supported, String source, String detail) {
+        saveCapability(instanceId, Map.of(metric, supported), source, detail);
+    }
+
+    public Map<String, Boolean> capability(long instanceId) {
+        Map<String, Boolean> m = new HashMap<>();
+        for (Map<String, Object> r : db.query("SELECT METRIC, SUPPORTED FROM DI_SQL_CAPABILITY WHERE INSTANCE_ID=?", instanceId)) {
+            m.put(Values.str(r.get("METRIC")), Values.toInt(r.get("SUPPORTED"), 0) == 1);
+        }
+        return m;
+    }
+
+    // ------------------------------------------------------------------ 变更窗口
+
+    /** 当前是否处于变更窗口（实例级或全局） */
+    public Map<String, Object> activeChangeWindow(long instanceId) {
+        return db.one("SELECT WINDOW_ID, WINDOW_TYPE, TITLE, START_TIME, END_TIME FROM DI_CHANGE_WINDOW "
+                + "WHERE (INSTANCE_ID = ? OR INSTANCE_ID IS NULL) AND SYSTIMESTAMP BETWEEN START_TIME AND END_TIME "
+                + "ORDER BY START_TIME DESC FETCH FIRST 1 ROWS ONLY", instanceId);
+    }
+
+    public List<Map<String, Object>> recentChangeWindows(long instanceId, int hours) {
+        return db.query("SELECT WINDOW_ID, WINDOW_TYPE, TITLE, START_TIME, END_TIME, SOURCE, REF_ID FROM DI_CHANGE_WINDOW "
+                + "WHERE (INSTANCE_ID = ? OR INSTANCE_ID IS NULL) AND END_TIME >= SYSTIMESTAMP - NUMTODSINTERVAL(?, 'HOUR') "
+                + "AND START_TIME <= SYSTIMESTAMP ORDER BY START_TIME DESC", instanceId, hours);
+    }
+
+    // ------------------------------------------------------------------ 历史
+
+    /** 最近 n 个窗口内命中“四项判定”的位图：assetId → 每个窗口的 flags（新→旧） */
+    public Map<Long, List<Integer>> recentFlags(long instanceId, Timestamp since) {
+        Map<Long, List<Integer>> m = new HashMap<>();
+        // 同一资产同一窗口的多个计划行写入的是同一份资产级 flags，取 MAX 即可
+        for (Map<String, Object> r : db.query("SELECT ASSET_ID, WINDOW_START, MAX(ANOMALY_FLAGS) AS F FROM DI_SQL_STATS_MIN WHERE INSTANCE_ID=? "
+                + "AND WINDOW_START >= ? GROUP BY ASSET_ID, WINDOW_START ORDER BY WINDOW_START DESC", instanceId, since)) {
+            m.computeIfAbsent(Values.toLong(r.get("ASSET_ID"), 0), k -> new ArrayList<>()).add(Values.toInt(r.get("F"), 0));
+        }
+        return m;
+    }
+
+    /** P-007/P-012 连续性判断：资产最近各窗口某列的合计（新→旧，按窗口汇总多个计划） */
+    public Map<Long, List<Double>> recentColumn(long instanceId, String column, Timestamp since) {
+        if (!column.matches("[A-Z_]+")) {
+            throw new IllegalArgumentException(column);
+        }
+        Map<Long, List<Double>> m = new HashMap<>();
+        for (Map<String, Object> r : db.query("SELECT ASSET_ID, WINDOW_START, SUM(" + column + ") AS V FROM DI_SQL_STATS_MIN WHERE INSTANCE_ID=? "
+                + "AND WINDOW_START >= ? GROUP BY ASSET_ID, WINDOW_START ORDER BY WINDOW_START DESC", instanceId, since)) {
+            Double v = Values.toDouble(r.get("V"));
+            m.computeIfAbsent(Values.toLong(r.get("ASSET_ID"), 0), k -> new ArrayList<>()).add(v == null ? Double.NaN : v);
+        }
+        return m;
+    }
+
+    /** P-013：资产在实例上的原生 SQL ID 个数 */
+    public Map<Long, Long> nativeIdCounts(long instanceId, List<Long> assetIds) {
+        Map<Long, Long> m = new HashMap<>();
+        for (int i = 0; i < assetIds.size(); i += 500) {
+            List<Long> part = assetIds.subList(i, Math.min(assetIds.size(), i + 500));
+            List<Object> args = new ArrayList<>();
+            args.add(instanceId);
+            args.addAll(part);
+            for (Map<String, Object> r : db.query("SELECT ASSET_ID, COUNT(*) AS C FROM DI_SQL_ASSET_SOURCE WHERE INSTANCE_ID=? AND ASSET_ID IN ("
+                    + Db.placeholders(part.size()) + ") GROUP BY ASSET_ID", args)) {
+                m.put(Values.toLong(r.get("ASSET_ID"), 0), Values.toLong(r.get("C"), 0));
+            }
+        }
+        return m;
+    }
+
+    /** 过期数据清理（分批删除，避免长事务） */
+    public int purge(int keepDays) {
+        int total = 0;
+        for (int i = 0; i < 200; i++) {
+            int n = db.update("DELETE FROM DI_SQL_STATS_MIN WHERE WINDOW_START < LOCALTIMESTAMP - NUMTODSINTERVAL(?, 'DAY') AND ROWNUM <= 20000", keepDays);
+            total += n;
+            if (n < 20000) {
+                break;
+            }
+        }
+        db.updateQuietly("DELETE FROM DI_SQL_ASSET_SOURCE WHERE LAST_SEEN < SYSTIMESTAMP - NUMTODSINTERVAL(?, 'DAY')", keepDays);
+        db.updateQuietly("DELETE FROM DI_SQL_PROBLEM WHERE STATUS='RESOLVED' AND RESOLVED_AT < SYSTIMESTAMP - INTERVAL '90' DAY");
+        return total;
+    }
+}
diff --git a/dbops-server/src/main/java/com/dbops/sqlinsight/web/SqlCompatController.java b/dbops-server/src/main/java/com/dbops/sqlinsight/web/SqlCompatController.java
new file mode 100644
index 0000000..a221882
--- /dev/null
+++ b/dbops-server/src/main/java/com/dbops/sqlinsight/web/SqlCompatController.java
@@ -0,0 +1,168 @@
+package com.dbops.sqlinsight.web;
+
+import com.dbops.common.Db;
+import com.dbops.common.R;
+import com.dbops.common.Values;
+import com.dbops.monitor.TargetConnector;
+import com.dbops.security.CurrentUser;
+import com.dbops.sqlinsight.ast.SqlAstService;
+import com.dbops.sqlinsight.audit.ExplainService;
+import com.dbops.sqlinsight.audit.SqlAuditService;
+import com.dbops.sqlinsight.collect.SqlCollectService;
+import com.dbops.sqlinsight.collect.SlowSqlService;
+import com.dbops.common.BizException;
+import java.sql.Timestamp;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RequestParam;
+import org.springframework.web.bind.annotation.RestController;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * /api/sql —— 原 Node routes/sql.js 的同名接口（已删除），前端 sqlApi 不用改：
+ * <ul>
+ *   <li>GET /slow：读 SQL_SLOW_SUMMARY 慢 SQL 快照（按采集时间存放，可按时间范围 / 批次查询）</li>
+ *   <li>POST /explain：危险语句识别改为 AST（原正则可被注释/多语句绕过），执行计划支持 5 库</li>
+ *   <li>POST /optimize：改为统一审核引擎（原 8 条正则）</li>
+ *   <li>POST /capture/:id：立即采集慢 SQL（7 种库；原仅 Oracle、且 MERGE 有绑定 bug）</li>
+ * </ul>
+ */
+@RestController
+@RequestMapping("/api/sql")
+public class SqlCompatController {
+
+    private final Db db;
+    private final SqlAstService ast;
+    private final ExplainService explain;
+    private final SqlAuditService auditSvc;
+    private final SqlCollectService collect;
+    private final SlowSqlService slowSql;
+    private final TargetConnector connector;
+
+    public SqlCompatController(Db db, SqlAstService ast, ExplainService explain, SqlAuditService auditSvc, SqlCollectService collect,
+                               TargetConnector connector, SlowSqlService slowSql) {
+        this.slowSql = slowSql;
+        this.db = db;
+        this.ast = ast;
+        this.explain = explain;
+        this.auditSvc = auditSvc;
+        this.collect = collect;
+        this.connector = connector;
+    }
+
+    /**
+     * 慢 SQL 快照（SQL_SLOW_SUMMARY，按采集时间存放）。
+     * 默认最近 24 小时；from/to 支持毫秒时间戳或 yyyy-MM-dd HH:mm[:ss]；batch 指定某一次采集。
+     */
+    @GetMapping("/slow")
+    public Map<String, Object> slow(@RequestParam(required = false) Long instanceId, @RequestParam(required = false) String from,
+                                    @RequestParam(required = false) String to, @RequestParam(required = false) String keyword,
+                                    @RequestParam(required = false) Double minAvgMs, @RequestParam(required = false) String batch,
+                                    @RequestParam(required = false) Long assetId,
+                                    @RequestParam(required = false, defaultValue = "1") String page,
+                                    @RequestParam(required = false, defaultValue = "20") String size) {
+        Timestamp[] range = range(from, to, 24);
+        return R.ok(slowSql.list(instanceId, range[0], range[1], keyword, minAvgMs, batch, assetId, page, size));
+    }
+
+    /** 采集批次时间轴 */
+    @GetMapping("/slow/batches")
+    public Map<String, Object> batches(@RequestParam(required = false) Long instanceId, @RequestParam(required = false) String from,
+                                       @RequestParam(required = false) String to) {
+        Timestamp[] range = range(from, to, 24 * 7);
+        return R.ok(slowSql.batches(instanceId, range[0], range[1]));
+    }
+
+    /** 单条快照详情（含完整 SQL 文本） */
+    @GetMapping("/slow/{rowId}")
+    public Map<String, Object> slowRow(@PathVariable long rowId) {
+        return R.ok(slowSql.row(rowId));
+    }
+
+    /** 同一条 SQL 在历次快照中的指标变化 */
+    @GetMapping("/slow/{rowId}/history")
+    public Map<String, Object> slowHistory(@PathVariable long rowId, @RequestParam(required = false, defaultValue = "7") int days) {
+        return R.ok(slowSql.history(rowId, days));
+    }
+
+    static Timestamp[] range(String from, String to, int defaultHours) {
+        long now = System.currentTimeMillis();
+        Timestamp t = parseTs(to, now);
+        Timestamp f = parseTs(from, t.getTime() - defaultHours * 3600_000L);
+        if (f.after(t)) {
+            throw BizException.badRequest("开始时间不能晚于结束时间");
+        }
+        return new Timestamp[]{f, t};
+    }
+
+    static Timestamp parseTs(String v, long def) {
+        if (v == null || v.isBlank()) {
+            return new Timestamp(def);
+        }
+        Long ms = Values.toStrictLong(v);
+        if (ms != null) {
+            return new Timestamp(ms);
+        }
+        try {
+            String s = v.trim().replace('T', ' ');
+            if (s.length() == 10) {
+                s += " 00:00:00";
+            } else if (s.length() == 16) {
+                s += ":00";
+            }
+            return Timestamp.valueOf(s.length() > 19 ? s.substring(0, 19) : s);
+        } catch (Exception e) {
+            throw BizException.badRequest("时间格式不正确: " + v);
+        }
+    }
+
+    @PostMapping("/explain")
+    public Map<String, Object> explain(@RequestBody Map<String, Object> b) {
+        Long instanceId = Values.toLong(b.get("instanceId"));
+        String sql = Values.str(b.get("sqlText"), "");
+        if (instanceId == null || sql.isBlank()) {
+            return R.badRequest("instanceId和sqlText不能为空");
+        }
+        if (!Values.truthy(b.get("allowDangerous"))) {
+            String danger = ast.dangerousType(sql, connector.fetch(instanceId).dbType());
+            if (danger != null) {
+                return R.fail(403, "安全拦截: 检测到 " + danger + " 操作，请勾选「允许执行」后重试");
+            }
+        }
+        return R.ok(explain.explain(instanceId, sql));
+    }
+
+    @PostMapping("/optimize")
+    public Map<String, Object> optimize(@RequestBody Map<String, Object> b) {
+        String sql = Values.str(b.get("sqlText"), "");
+        if (sql.isBlank()) {
+            return R.badRequest("SQL不能为空");
+        }
+        Map<String, Object> a = auditSvc.audit(new SqlAuditService.Request(sql, Values.str(b.get("dbType")), Values.str(b.get("schema")),
+                Values.toLong(b.get("instanceId")), false, false));
+        return R.ok(R.map("suggestions", auditSvc.optimizeSuggestions(a), "score", a.get("score"), "risk", a.get("risk")));
+    }
+
+    /**
+     * 立即采集慢 SQL：直接从源库统计视图取“单次平均耗时 ≥ 阈值”的 SQL，整批写入 SQL_SLOW_SUMMARY（按采集时间）。
+     * 支持 Oracle / 磐维 / 达梦 / MySQL / GoldenDB / PostgreSQL / SQL Server；minAvgMs 可临时覆盖阈值。
+     */
+    @PostMapping("/capture/{instanceId}")
+    public Map<String, Object> capture(CurrentUser u, @PathVariable long instanceId, @RequestParam(required = false) Double minAvgMs) {
+        u.require("ADMIN", "DBA", "OPS");
+        Map<String, Object> s = slowSql.capture(instanceId, "MANUAL", minAvgMs);
+        if (s.get("error") != null) {
+            return R.fail(500, "采集失败：" + s.get("error"));
+        }
+        long n = Values.toLong(s.get("count"), 0);
+        String msg = n > 0 ? String.format("已采集 %d 条慢 SQL（%s，单次平均耗时 ≥ %s ms），采集时间 %s", n, s.get("source"), s.get("minAvgMs"), s.get("captureTime"))
+                : String.format("采集完成：当前没有单次平均耗时 ≥ %s ms 的 SQL（%s）", s.get("minAvgMs"), s.get("source"));
+        return R.ok(s, msg);
+    }
+}
