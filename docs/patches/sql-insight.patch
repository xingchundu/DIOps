+    const opts = Object.assign({}, init || {});
+    const headers = new Headers(opts.headers || (typeof input !== 'string' && input.headers) || {});
+    const t = token();
+    if (t && !headers.has('Authorization')) headers.set('Authorization', 'Bearer ' + t);
+    opts.headers = headers;
