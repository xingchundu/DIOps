+# ── SQL Server（SET SHOWPLAN_TEXT ON 输出） ─────────────────
+# 形如：  |--Nested Loops(Inner Join, OUTER REFERENCES:(...))
+#            |--Clustered Index Scan(OBJECT:([db].[dbo].[orders].[PK_orders]))
+#            |--Table Scan(OBJECT:([db].[dbo].[t]), WHERE:(...))
+_MS_LINE_RE = re.compile(r"^(?P<indent>[\s|]*)\|--(?P<op>[A-Za-z][A-Za-z ]*?)\s*(?:\((?P<args>.*)\))?\s*$")
+_MS_OBJ_RE = re.compile(r"OBJECT:\((?:\[[^\]]*\]\.)*\[(?P<t>[^\]]+)\](?:\.\[(?P<i>[^\]]+)\])?")
+
+
+def _analyze_sqlserver(text: str) -> dict:
+    operations: list[dict[str, Any]] = []
+    issues: list[dict[str, Any]] = []
+    for line in text.splitlines():
+        m = _MS_LINE_RE.match(line.rstrip())
+        if not m:
+            continue
+        op = m.group("op").strip()
+        args = m.group("args") or ""
+        level = len(m.group("indent")) // 2
+        table = ""
+        mo = _MS_OBJ_RE.search(args)
+        if mo:
+            # 索引扫描时 OBJECT 里是 [表].[索引]，取倒数第二段为表名
+            parts = re.findall(r"\[([^\]]+)\]", args[mo.start():mo.end()])
+            table = parts[-2] if len(parts) >= 2 and "Index" in op else parts[-1] if parts else ""
+        flag = None
+        if op in ("Table Scan", "Clustered Index Scan"):
+            flag = "full_scan"
+            issues.append({"type": "full_scan",
+                           "detail": f"{op} on {table or '?'}", "suggestion": "为 WHERE/JOIN 条件列建立合适的非聚集索引"})
+        elif op == "Index Scan":
+            flag = "index_scan"
+            issues.append({"type": "index_scan",
+                           "detail": f"索引全扫描 {table}", "suggestion": "确认谓词是否可改为 Index Seek（避免函数/隐式转换）"})
+        elif op in ("Key Lookup", "RID Lookup", "Bookmark Lookup"):
+            issues.append({"type": "key_lookup",
+                           "detail": f"{op} on {table}", "suggestion": "考虑覆盖索引（INCLUDE 所需列）减少回表"})
+        elif op == "Sort":
+            issues.append({"type": "large_sort", "detail": "排序操作", "suggestion": "检查是否可利用索引顺序避免排序"})
+        elif op == "Hash Match":
+            flag = "hash"
+        operations.append({"op": op, "table": table, "cost": None, "rows": None, "level": level, "flag": flag})
+    return {"operations": operations, "issues": issues, "total_cost": None, "summary": _build_summary(operations, issues, None)}
+
+
