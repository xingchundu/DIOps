+        al.put("topRules", safeList(() -> db.query("SELECT NVL(RULE_NAME, '其他') RULE_NAME, COUNT(*) CNT, SUM(CASE WHEN STATUS = 'RESOLVED' THEN 1 ELSE 0 END) RESOLVED "
