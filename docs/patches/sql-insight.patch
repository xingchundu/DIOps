--- /dev/null
+++ b/dbops-server/src/main/java/com/dbops/sqlinsight/collect/Metric.java
@@ -0,0 +1,43 @@
+package com.dbops.sqlinsight.collect;
+
+import java.util.List;
+
+/**
+ * 9 个窗口指标（设计方案 3.3）。column 为 DI_SQL_STATS_MIN 列名；needs 为依赖的计数器，任何一个不支持则该指标不支持。
+ */
+public enum Metric {
+    AVG_ELAPSED_MS("avg_elapsed_ms", "AVG_ELAPSED_MS", "平均耗时(ms)", List.of(Counter.ELAPSED_MS)),
+    CPU_PER_EXEC_MS("cpu_per_exec_ms", "CPU_PER_EXEC_MS", "单次CPU(ms)", List.of(Counter.CPU_MS)),
+    LOGICAL_READS_PER_EXEC("logical_reads_per_exec", "LOGICAL_READS_PER_EXEC", "单次逻辑读", List.of(Counter.LOGICAL_READS)),
+    PHYSICAL_READS_PER_EXEC("physical_reads_per_exec", "PHYSICAL_READS_PER_EXEC", "单次物理读", List.of(Counter.PHYSICAL_READS)),
+    ROWS_EXAMINED_PER_EXEC("rows_examined_per_exec", "ROWS_EXAMINED_PER_EXEC", "单次扫描行数", List.of(Counter.ROWS_EXAMINED)),
+    SCAN_RATIO("scan_ratio", "SCAN_RATIO", "扫描/返回比", List.of(Counter.ROWS_EXAMINED, Counter.ROWS_RETURNED)),
+    EXEC_PER_MIN("exec_per_min", "EXEC_PER_MIN", "每分钟执行次数", List.of(Counter.EXEC)),
+    DB_TIME_SHARE("db_time_share", "DB_TIME_SHARE", "DB Time 占比", List.of(Counter.ELAPSED_MS)),
+    ERROR_RATE("error_rate", "ERROR_RATE", "错误率", List.of(Counter.ERRORS));
+
+    public final String key;
+    public final String column;
+    public final String label;
+    public final List<Counter> needs;
+
+    Metric(String key, String column, String label, List<Counter> needs) {
+        this.key = key;
+        this.column = column;
+        this.label = label;
+        this.needs = needs;
+    }
+
+    public int bit() {
+        return 1 << ordinal();
+    }
+
+    public static Metric byKey(String k) {
+        for (Metric m : values()) {
+            if (m.key.equalsIgnoreCase(k) || m.name().equalsIgnoreCase(k) || m.column.equalsIgnoreCase(k)) {
+                return m;
+            }
+        }
+        return null;
+    }
+}
diff --git a/dbops-server/src/main/java/com/dbops/sqlinsight/collect/SessionSampler.java b/dbops-server/src/main/java/com/dbops/sqlinsight/collect/SessionSampler.java
new file mode 100644
index 0000000..40ed602
--- /dev/null
+++ b/dbops-server/src/main/java/com/dbops/sqlinsight/collect/SessionSampler.java
@@ -0,0 +1,118 @@
+package com.dbops.sqlinsight.collect;
+
+import com.dbops.common.Values;
+import com.dbops.monitor.DbType;
+import com.dbops.monitor.TargetDb;
+
+import java.sql.SQLException;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * 活动会话采样（设计方案 3.5：10~15 秒一次）。只取“正在执行用户 SQL”的会话。
+ * 各库一条查询；查询失败时上层把 active_session 能力记为 UNSUPPORTED，P-001/P-002/P-010 记 SKIPPED。
+ */
+public final class SessionSampler {
+
+    private SessionSampler() {
+    }
+
+    public static String query(String platformType) {
+        return switch (DbType.normalize(platformType)) {
+            case DbType.ORACLE -> "SELECT TO_CHAR(s.SID) || ',' || TO_CHAR(s.SERIAL#) AS SID, s.SQL_ID AS NID, s.SCHEMANAME AS SCH, "
+                    + "(SELECT SUBSTR(MAX(q.SQL_TEXT), 1, 1000) FROM V$SQLSTATS q WHERE q.SQL_ID = s.SQL_ID) AS TXT, "
+                    + "s.LAST_CALL_ET AS RUN_SEC, s.EVENT AS WAIT_EVENT, "
+                    + "s.SECONDS_IN_WAIT AS WAIT_SEC, s.WAIT_CLASS AS WAIT_CLASS, TO_CHAR(s.BLOCKING_SESSION) AS BLOCKER "
+                    + "FROM V$SESSION s "
+                    + "WHERE s.TYPE = 'USER' AND s.STATUS = 'ACTIVE' AND s.SQL_ID IS NOT NULL AND s.SID <> SYS_CONTEXT('USERENV','SID') "
+                    + "AND NVL(s.WAIT_CLASS, 'x') <> 'Idle'";
+            case DbType.MYSQL, DbType.GOLDENDB -> "SELECT p.ID AS SID, NULL AS NID, p.DB AS SCH, LEFT(p.INFO, 1000) AS TXT, p.TIME AS RUN_SEC, "
+                    + "p.STATE AS WAIT_EVENT, CASE WHEN p.STATE LIKE '%lock%' THEN p.TIME ELSE 0 END AS WAIT_SEC, "
+                    + "CASE WHEN p.STATE LIKE '%lock%' THEN 'Lock' ELSE NULL END AS WAIT_CLASS, NULL AS BLOCKER "
+                    + "FROM information_schema.PROCESSLIST p WHERE p.COMMAND = 'Query' AND p.INFO IS NOT NULL AND p.ID <> CONNECTION_ID()";
+            case DbType.POSTGRESQL, DbType.PANWEI -> "SELECT CAST(a.pid AS VARCHAR) AS SID, NULL AS NID, a.datname AS SCH, LEFT(a.query, 1000) AS TXT, "
+                    + "EXTRACT(EPOCH FROM (now() - a.query_start)) AS RUN_SEC, a.wait_event AS WAIT_EVENT, "
+                    + "CASE WHEN a.wait_event_type = 'Lock' THEN EXTRACT(EPOCH FROM (now() - a.state_change)) ELSE 0 END AS WAIT_SEC, "
+                    + "a.wait_event_type AS WAIT_CLASS, NULL AS BLOCKER "
+                    + "FROM pg_stat_activity a WHERE a.state = 'active' AND a.pid <> pg_backend_pid() AND a.query IS NOT NULL "
+                    + "AND a.query_start IS NOT NULL";
+            case DbType.DAMENG -> "SELECT CAST(s.SESS_ID AS VARCHAR(32)) AS SID, NULL AS NID, s.CURR_SCH AS SCH, SUBSTR(s.SQL_TEXT, 1, 1000) AS TXT, "
+                    + "DATEDIFF(SS, s.LAST_RECV_TIME, SYSDATE) AS RUN_SEC, NULL AS WAIT_EVENT, 0 AS WAIT_SEC, NULL AS WAIT_CLASS, NULL AS BLOCKER "
+                    + "FROM V$SESSIONS s WHERE s.STATE = 'ACTIVE' AND s.SQL_TEXT IS NOT NULL AND s.SESS_ID <> SESSID()";
+            case DbType.SQLSERVER -> "SELECT CAST(r.session_id AS VARCHAR(16)) AS SID, CONVERT(VARCHAR(64), r.query_hash, 1) AS NID, "
+                    + "DB_NAME(r.database_id) AS SCH, SUBSTRING(t.text, r.statement_start_offset / 2 + 1, 1000) AS TXT, "
+                    + "r.total_elapsed_time / 1000.0 AS RUN_SEC, r.wait_type AS WAIT_EVENT, r.wait_time / 1000.0 AS WAIT_SEC, "
+                    + "CASE WHEN r.wait_type LIKE 'LCK%' THEN 'Lock' ELSE NULL END AS WAIT_CLASS, "
+                    + "CASE WHEN r.blocking_session_id > 0 THEN CAST(r.blocking_session_id AS VARCHAR(16)) END AS BLOCKER "
+                    + "FROM sys.dm_exec_requests r CROSS APPLY sys.dm_exec_sql_text(r.sql_handle) t "
+                    + "WHERE r.session_id <> @@SPID AND r.session_id > 50";
+            default -> null;
+        };
+    }
+
+    /** PG 系补充阻塞者（pg_blocking_pids 在 9.6+ 可用；磐维可能没有，失败忽略） */
+    private static final String PG_BLOCKERS = "SELECT CAST(pid AS VARCHAR) AS SID, CAST(pg_blocking_pids(pid) AS VARCHAR) AS B "
+            + "FROM pg_stat_activity WHERE wait_event_type = 'Lock'";
+
+    /**
+     * MySQL 行锁等待：InnoDB 行锁等待时 PROCESSLIST.STATE 通常是 "updating"/"executing"，不含 lock 字样，
+     * 原实现只看 STATE，行锁阻塞一律识别不到。sys.innodb_lock_waits（5.7+/8.0）优先，5.6/5.7 回退 information_schema。
+     */
+    private static final String MY_BLOCKERS = "SELECT CAST(waiting_pid AS CHAR) AS SID, CAST(blocking_pid AS CHAR) AS B FROM sys.innodb_lock_waits";
+    private static final String MY_BLOCKERS_57 = "SELECT CAST(r.trx_mysql_thread_id AS CHAR) AS SID, CAST(b.trx_mysql_thread_id AS CHAR) AS B "
+            + "FROM information_schema.innodb_lock_waits w "
+            + "JOIN information_schema.innodb_trx r ON r.trx_id = w.requesting_trx_id "
+            + "JOIN information_schema.innodb_trx b ON b.trx_id = w.blocking_trx_id";
+
+    public static List<ActiveSession> sample(TargetDb db, String platformType, int maxRows) throws SQLException {
+        String q = query(platformType);
+        if (q == null) {
+            return List.of();
+        }
+        List<Map<String, Object>> rows = db.queryMax(maxRows, q);
+        Map<String, String> pgBlockers = Map.of();
+        if (DbType.isPgFamily(DbType.normalize(platformType))) {
+            pgBlockers = new java.util.HashMap<>();
+            for (Map<String, Object> b : db.queryOrEmpty(PG_BLOCKERS)) {
+                String v = Values.str(b.get("B"), "").replace("{", "").replace("}", "");
+                if (!v.isBlank()) {
+                    pgBlockers.put(Values.str(b.get("SID")), v);
+                }
+            }
+        }
+        String norm = DbType.normalize(platformType);
+        if (DbType.MYSQL.equals(norm) || DbType.GOLDENDB.equals(norm)) {
+            List<Map<String, Object>> w = db.queryQuietly(MY_BLOCKERS);
+            if (w == null) {
+                w = db.queryOrEmpty(MY_BLOCKERS_57);
+            }
+            pgBlockers = new java.util.HashMap<>();
+            for (Map<String, Object> b : w) {
+                String sid = Values.str(b.get("SID"));
+                if (sid != null && Values.str(b.get("B")) != null) {
+                    pgBlockers.merge(sid, Values.str(b.get("B")), (x, y) -> x + "," + y);
+                }
+            }
+        }
+        List<ActiveSession> out = new ArrayList<>(rows.size());
+        for (Map<String, Object> r : rows) {
+            String sid = Values.str(r.get("SID"));
+            String waitClass = Values.str(r.get("WAIT_CLASS"), "");
+            String blocker = Values.str(r.get("BLOCKER"));
+            if (blocker == null) {
+                blocker = pgBlockers.get(sid);
+            }
+            boolean lock = blocker != null || "Lock".equalsIgnoreCase(waitClass)
+                    || ("Application".equalsIgnoreCase(waitClass) && Values.str(r.get("WAIT_EVENT"), "").startsWith("enq: TX"));
+            out.add(new ActiveSession(sid, Values.str(r.get("NID")), Values.str(r.get("SCH")), Values.str(r.get("TXT")),
+                    nz(r.get("RUN_SEC")), Values.str(r.get("WAIT_EVENT")), nz(r.get("WAIT_SEC")), lock, blocker));
+        }
+        return out;
+    }
+
+    private static double nz(Object v) {
+        Double d = Values.toDouble(v);
+        return d == null || d.isNaN() ? 0 : d;
+    }
+}
diff --git a/dbops-server/src/main/java/com/dbops/sqlinsight/collect/SlowSqlService.java b/dbops-server/src/main/java/com/dbops/sqlinsight/collect/SlowSqlService.java
new file mode 100644
index 0000000..42dc009
--- /dev/null
+++ b/dbops-server/src/main/java/com/dbops/sqlinsight/collect/SlowSqlService.java
@@ -0,0 +1,223 @@
+package com.dbops.sqlinsight.collect;
+
+import com.dbops.common.BizException;
+import com.dbops.common.Db;
+import com.dbops.common.Values;
+import com.dbops.monitor.TargetConnector;
+import com.dbops.monitor.TargetDb;
+import com.dbops.service.SystemConfigService;
+import com.dbops.sqlinsight.store.AssetService;
+import com.dbops.sqlinsight.store.InstanceDirectory;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.stereotype.Service;
+
+import java.sql.Timestamp;
+import java.text.SimpleDateFormat;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.ConcurrentHashMap;
+
+/**
+ * 慢 SQL 快照：采集 → 按采集时间整批写入 SQL_SLOW_SUMMARY → 按时间范围查询 / 同一 SQL 的历次快照趋势。
+ * <p>
+ * 每批共用同一个 CAPTURE_TIME 与 CAPTURE_BATCH；每行关联 SQL 资产（ASSET_ID），在 SQL 洞察里可看到同一条 SQL 的运行时问题与波动。
+ * 口径：源库统计视图中“截至采集时刻”的累计值（平均耗时 = 累计耗时 / 累计执行次数），不是区间增量；区间增量看 SQL 洞察的分钟统计。
+ */
+@Service
+public class SlowSqlService {
+
+    private static final Logger log = LoggerFactory.getLogger(SlowSqlService.class);
+
+    private static final String INSERT = "INSERT INTO SQL_SLOW_SUMMARY (INSTANCE_ID, SQL_TEXT, SQL_HASH, DB_TYPE, AVG_ELAPSED, MAX_ELAPSED, EXEC_COUNT, "
+            + "TOTAL_ELAPSED, FULL_SCAN, CAPTURE_TIME, PLAN_HASH, CAPTURE_BATCH, CAPTURE_SOURCE, SCHEMA_NAME, NATIVE_SQL_ID, ASSET_ID, "
+            + "CPU_TIME_MS, LOGICAL_READS, PHYSICAL_READS, ROWS_PROCESSED, LAST_ACTIVE_TIME, STAT_SOURCE) "
+            + "VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)";
+
+    private final Db db;
+    private final TargetConnector connector;
+    private final InstanceDirectory instances;
+    private final AssetService assets;
+    private final SystemConfigService cfg;
+    private final Set<Long> running = ConcurrentHashMap.newKeySet();
+
+    public SlowSqlService(Db db, TargetConnector connector, InstanceDirectory instances, AssetService assets, SystemConfigService cfg) {
+        this.db = db;
+        this.connector = connector;
+        this.instances = instances;
+        this.assets = assets;
+        this.cfg = cfg;
+    }
+
+    /**
+     * 采集一次。
+     * @param source MANUAL（页面“立即采集”）/ SCHEDULE（定时）/ FAULT（故障自愈）
+     */
+    public Map<String, Object> capture(long instanceId, String source, Double minAvgMsOverride) {
+        InstanceDirectory.Inst inst = instances.get(instanceId);
+        if (inst == null) {
+            throw BizException.notFound("实例不存在");
+        }
+        if (!running.add(instanceId)) {
+            throw BizException.badRequest("该实例的慢 SQL 采集正在进行，请稍后");
+        }
+        long t0 = System.currentTimeMillis();
+        Map<String, Object> out = new LinkedHashMap<>();
+        out.put("instanceId", instanceId);
+        out.put("instanceName", inst.name());
+        out.put("dbType", inst.dbType());
+        try (TargetDb tdb = connector.open(instanceId)) {
+            int topN = (int) Math.max(1, Math.min(500, cfg.getLong("sqlinsight.slow.top_n", 50)));
+            double minAvg = minAvgMsOverride != null && minAvgMsOverride >= 0 ? minAvgMsOverride : cfg.getNumber("sqlinsight.slow.min_avg_ms", 1000);
+            SlowSqlSource.Result res = SlowSqlSource.capture(tdb, inst.dbType(), topN, minAvg,
+                    cfg.getNumber("sqlinsight.panwei.time_divisor", 1000), cfg.getNumber("sqlinsight.dameng.time_divisor", 1));
+            Timestamp now = new Timestamp(System.currentTimeMillis() / 1000 * 1000);
+            String batch = instanceId + "-" + new SimpleDateFormat("yyyyMMddHHmmss").format(now);
+            List<Object[]> rows = new ArrayList<>();
+            for (SlowSqlSource.SlowRow r : res.rows()) {
+                Long assetId = null;
+                String hash = null;
+                try {
+                    AssetService.AssetRef a = assets.resolveNative(instanceId, r.nativeId(), inst.dbType(), r.schema(), r.sqlText());
+                    assetId = a.assetId();
+                    hash = a.fingerprint();
+                } catch (Exception e) {
+                    log.debug("[slow-sql] asset resolve failed: {}", e.getMessage());
+                }
+                rows.add(new Object[]{instanceId, Values.truncate(r.sqlText(), 32000), hash, inst.dbType(), n(r.avgMs()), n(r.maxMs()), n(r.execs()),
+                        n(r.totalMs()), r.fullScan() ? 1 : 0, now, Values.truncate(r.planHash(), 64), batch, source,
+                        Values.truncate(r.schema(), 128), r.nativeId(), assetId, n(r.cpuMs()), n(r.logicalReads()), n(r.physicalReads()),
+                        n(r.rows()), r.lastActive(), res.source()});
+            }
+            if (!rows.isEmpty()) {
+                db.jdbc().batchUpdate(INSERT, rows);
+            }
+            out.put("count", rows.size());
+            out.put("batch", batch);
+            out.put("captureTime", now);
+            out.put("source", res.source());
+            out.put("minAvgMs", minAvg);
+            out.put("topN", topN);
+        } catch (BizException e) {
+            throw e;
+        } catch (Exception e) {
+            if (Db.isMissingColumn(e) || Db.isMissingTable(e)) {
+                throw new BizException(500, "SQL_SLOW_SUMMARY 表结构未升级：请执行 backend/sql/migration_sql_insight.sql");
+            }
+            out.put("count", 0);
+            out.put("error", Values.truncate(e.getMessage(), 500));
+            log.warn("[slow-sql] capture inst={} failed: {}", instanceId, e.getMessage());
+        } finally {
+            running.remove(instanceId);
+        }
+        out.put("costMs", System.currentTimeMillis() - t0);
+        return out;
+    }
+
+    private static Object n(Double v) {
+        return v == null || v.isNaN() || v.isInfinite() ? null : Values.round(v, 3);
+    }
+
+    // ------------------------------------------------------------------ 查询
+
+    public Map<String, Object> list(Long instanceId, Timestamp from, Timestamp to, String keyword, Double minAvgMs, String batch,
+                                    Long assetId, String page, String size) {
+        List<String> where = new ArrayList<>();
+        List<Object> args = new ArrayList<>();
+        if (batch != null && !batch.isBlank()) {
+            where.add("s.CAPTURE_BATCH = ?");
+            args.add(batch);
+        } else {
+            where.add("s.CAPTURE_TIME BETWEEN ? AND ?");
+            args.add(from);
+            args.add(to);
+        }
+        if (instanceId != null) {
+            where.add("s.INSTANCE_ID = ?");
+            args.add(instanceId);
+        }
+        if (assetId != null) {
+            where.add("s.ASSET_ID = ?");
+            args.add(assetId);
+        }
+        if (minAvgMs != null) {
+            where.add("s.AVG_ELAPSED >= ?");
+            args.add(minAvgMs);
+        }
+        if (keyword != null && !keyword.isBlank()) {
+            // LOWER(CLOB) 对每行生成临时 LOB（大表上又慢又占临时表空间）；改为在前 4000 字符内不区分大小写匹配
+            where.add("(INSTR(LOWER(DBMS_LOB.SUBSTR(s.SQL_TEXT, 4000, 1)), ?) > 0 OR s.NATIVE_SQL_ID = ? OR s.SQL_HASH = ?)");
+            args.add(Values.truncate(keyword.trim().toLowerCase(java.util.Locale.ROOT), 200));
+            args.add(keyword.trim());
+            args.add(keyword.trim());
+        }
+        String sql = "SELECT s.SQL_ID AS ROW_ID, s.INSTANCE_ID, i.INSTANCE_NAME, s.DB_TYPE, s.SCHEMA_NAME, s.NATIVE_SQL_ID, s.ASSET_ID, s.SQL_HASH, "
+                + "DBMS_LOB.SUBSTR(s.SQL_TEXT, 2000, 1) AS SQL_TEXT, s.AVG_ELAPSED, s.MAX_ELAPSED, s.EXEC_COUNT, s.TOTAL_ELAPSED, s.CPU_TIME_MS, "
+                + "s.LOGICAL_READS, s.PHYSICAL_READS, s.ROWS_PROCESSED, s.FULL_SCAN, s.PLAN_HASH, s.CAPTURE_TIME, s.CAPTURE_BATCH, "
+                + "s.CAPTURE_SOURCE, s.LAST_ACTIVE_TIME, s.STAT_SOURCE, a.STATIC_RISK "
+                + "FROM SQL_SLOW_SUMMARY s LEFT JOIN CMDB_INSTANCE i ON i.INSTANCE_ID = s.INSTANCE_ID LEFT JOIN DI_SQL_ASSET a ON a.ASSET_ID = s.ASSET_ID "
+                + "WHERE " + String.join(" AND ", where) + " ORDER BY s.CAPTURE_TIME DESC, s.AVG_ELAPSED DESC NULLS LAST";
+        return db.queryPage(sql, args, page, size);
+    }
+
+    /** 采集批次（时间轴） */
+    public List<Map<String, Object>> batches(Long instanceId, Timestamp from, Timestamp to) {
+        List<Object> args = new ArrayList<>(List.of(from, to));
+        String w = "";
+        if (instanceId != null) {
+            w = " AND s.INSTANCE_ID = ?";
+            args.add(instanceId);
+        }
+        return db.query("SELECT s.CAPTURE_BATCH, s.INSTANCE_ID, MAX(i.INSTANCE_NAME) INSTANCE_NAME, MAX(s.CAPTURE_TIME) CAPTURE_TIME, "
+                + "MAX(s.CAPTURE_SOURCE) CAPTURE_SOURCE, MAX(s.STAT_SOURCE) STAT_SOURCE, COUNT(*) SQL_COUNT, MAX(s.AVG_ELAPSED) MAX_AVG_ELAPSED "
+                + "FROM SQL_SLOW_SUMMARY s LEFT JOIN CMDB_INSTANCE i ON i.INSTANCE_ID = s.INSTANCE_ID "
+                + "WHERE s.CAPTURE_TIME BETWEEN ? AND ? AND s.CAPTURE_BATCH IS NOT NULL" + w
+                + " GROUP BY s.CAPTURE_BATCH, s.INSTANCE_ID ORDER BY CAPTURE_TIME DESC FETCH FIRST 200 ROWS ONLY", args);
+    }
+
+    /** 同一条 SQL（同资产 / 同原生 ID）在该实例历次快照中的指标，用于看变化趋势 */
+    public List<Map<String, Object>> history(long rowId, int days) {
+        Map<String, Object> r = db.one("SELECT INSTANCE_ID, ASSET_ID, NATIVE_SQL_ID FROM SQL_SLOW_SUMMARY WHERE SQL_ID=?", rowId);
+        if (r == null) {
+            throw BizException.notFound("记录不存在");
+        }
+        Timestamp since = new Timestamp(System.currentTimeMillis() - Math.max(1, Math.min(days, 90)) * 86400_000L);
+        if (r.get("ASSET_ID") != null) {
+            return db.query("SELECT SQL_ID AS ROW_ID, CAPTURE_TIME, AVG_ELAPSED, MAX_ELAPSED, EXEC_COUNT, TOTAL_ELAPSED, PLAN_HASH, FULL_SCAN "
+                    + "FROM SQL_SLOW_SUMMARY WHERE INSTANCE_ID=? AND ASSET_ID=? AND CAPTURE_TIME >= ? ORDER BY CAPTURE_TIME", r.get("INSTANCE_ID"),
+                    r.get("ASSET_ID"), since);
+        }
+        return db.query("SELECT SQL_ID AS ROW_ID, CAPTURE_TIME, AVG_ELAPSED, MAX_ELAPSED, EXEC_COUNT, TOTAL_ELAPSED, PLAN_HASH, FULL_SCAN "
+                + "FROM SQL_SLOW_SUMMARY WHERE INSTANCE_ID=? AND NATIVE_SQL_ID=? AND CAPTURE_TIME >= ? ORDER BY CAPTURE_TIME", r.get("INSTANCE_ID"),
+                r.get("NATIVE_SQL_ID"), since);
+    }
+
+    public Map<String, Object> row(long rowId) {
+        Map<String, Object> r = db.one("SELECT s.*, i.INSTANCE_NAME FROM SQL_SLOW_SUMMARY s LEFT JOIN CMDB_INSTANCE i ON i.INSTANCE_ID = s.INSTANCE_ID "
+                + "WHERE s.SQL_ID=?", rowId);
+        if (r == null) {
+            throw BizException.notFound("记录不存在");
+        }
+        return r;
+    }
+
+    /** 过期快照清理（分批） */
+    public int purge(int keepDays) {
+        int total = 0;
+        for (int i = 0; i < 100; i++) {
+            int n = db.update("DELETE FROM SQL_SLOW_SUMMARY WHERE CAPTURE_TIME < SYSTIMESTAMP - NUMTODSINTERVAL(?, 'DAY') AND ROWNUM <= 10000", keepDays);
+            total += n;
+            if (n < 10000) {
+                break;
+            }
+        }
+        return total;
+    }
+
+    public boolean isRunning(long instanceId) {
+        return running.contains(instanceId);
+    }
+}
diff --git a/dbops-server/src/main/java/com/dbops/sqlinsight/collect/SlowSqlSource.java b/dbops-server/src/main/java/com/dbops/sqlinsight/collect/SlowSqlSource.java
new file mode 100644
index 0000000..5076574
--- /dev/null
+++ b/dbops-server/src/main/java/com/dbops/sqlinsight/collect/SlowSqlSource.java
@@ -0,0 +1,264 @@
+package com.dbops.sqlinsight.collect;
+
+import com.dbops.common.Values;
+import com.dbops.monitor.DbType;
+import com.dbops.monitor.TargetDb;
+
+import java.sql.SQLException;
+import java.sql.Timestamp;
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+/**
+ * 慢 SQL 快照采集（“SQL优化 → 立即采集慢SQL”与定时采集共用）。
+ * <p>
+ * 与分钟统计（{@link StatsSource} + {@link DeltaEngine}）不同：这里直接取源库统计视图中
+ * “截至采集时刻、单次平均耗时 ≥ 阈值”的 SQL，按采集时间整批写入 SQL_SLOW_SUMMARY，第一次点击就有结果。
+ * <ul>
+ *   <li>Oracle：V$SQLAREA_PLAN_HASH（按 SQL_ID + 计划），全文取 SQL_FULLTEXT；全表扫描由 V$SQL_PLAN 判定</li>
+ *   <li>磐维（PanWeiDB / openGauss）：dbe_perf.statement，含单次最大耗时 max_elapse_time</li>
+ *   <li>达梦 DM8：优先 V$LONG_EXEC_SQLS（每条超时执行一行，按 SQL 文本汇总，含最大耗时）；不可用时退回 V$SQL_STAT</li>
+ *   <li>MySQL / GoldenDB / PostgreSQL / SQL Server：同分钟统计的视图，附带各自的最大耗时列</li>
+ * </ul>
+ * 统计视图里字段随版本不同，仍走“探测实际列名 → 候选列”的方式，缺失的字段写空值，不写 0。
+ */
+public final class SlowSqlSource {
+
+    public record SlowRow(String nativeId, String schema, String sqlText, String planHash, Double execs, Double totalMs,
+                          Double avgMs, Double maxMs, Double cpuMs, Double logicalReads, Double physicalReads, Double rows,
+                          Timestamp lastActive, boolean fullScan) {
+    }
+
+    public record Result(String source, List<SlowRow> rows) {
+    }
+
+    /** 慢 SQL 采集额外需要的列：全文、单次最大耗时、最近执行时间 */
+    record Extras(List<StatsSource.Col> fullText, List<StatsSource.Col> maxElapsed, List<StatsSource.Col> lastActive) {
+    }
+
+    private SlowSqlSource() {
+    }
+
+    static Extras extras(String platformType, double panweiDiv, double damengDiv) {
+        double pd = panweiDiv > 0 ? panweiDiv : 1000;
+        double dd = damengDiv > 0 ? damengDiv : 1;
+        return switch (DbType.normalize(platformType)) {
+            case DbType.ORACLE -> new Extras(List.of(StatsSource.Col.expr("DBMS_LOB.SUBSTR(SQL_FULLTEXT, 2000, 1)", 1, "SQL_FULLTEXT")),
+                    List.of(), List.of(StatsSource.Col.c("LAST_ACTIVE_TIME")));
+            case DbType.MYSQL, DbType.GOLDENDB -> new Extras(List.of(StatsSource.Col.c("QUERY_SAMPLE_TEXT")),
+                    List.of(StatsSource.Col.c("MAX_TIMER_WAIT", 1e9)), List.of(StatsSource.Col.c("LAST_SEEN")));
+            case DbType.POSTGRESQL -> new Extras(List.of(),
+                    List.of(StatsSource.Col.c("MAX_EXEC_TIME"), StatsSource.Col.c("MAX_TIME")), List.of());
+            case DbType.PANWEI -> new Extras(List.of(), List.of(StatsSource.Col.c("MAX_ELAPSE_TIME", pd)),
+                    List.of(StatsSource.Col.c("LAST_UPDATED")));
+            case DbType.DAMENG -> new Extras(List.of(), List.of(StatsSource.Col.c("MAX_EXEC_TIME", dd)), List.of(StatsSource.Col.c("LAST_EXEC_TIME")));
+            case DbType.SQLSERVER -> new Extras(List.of(), List.of(StatsSource.Col.c("MAX_US", 1000)), List.of(StatsSource.Col.c("LAST_EXEC")));
+            default -> new Extras(List.of(), List.of(), List.of());
+        };
+    }
+
+    private static StatsSource.Col first(List<StatsSource.Col> list, Set<String> cols) {
+        for (StatsSource.Col c : list) {
+            if (c.available(cols)) {
+                return c;
+            }
+        }
+        return null;
+    }
+
+    private static String num(double v) {
+        if (v == Math.rint(v) && Math.abs(v) < 1e15) {
+            return String.valueOf((long) v);
+        }
+        return String.valueOf(v);
+    }
+
+    /**
+     * 通用慢 SQL 查询（纯函数，单测可直接调用）：单次平均耗时 ≥ minAvgMs，按平均耗时倒序取前 topN。
+     * 条件写成 “总耗时 ≥ 阈值 × 执行次数”，避免除法和除零。
+     */
+    static String buildQuery(StatsSource.Probe p, Set<String> cols, Extras ex, int topN, double minAvgMs) {
+        StatsSource.Col exec = p.counters().get(Counter.EXEC);
+        StatsSource.Col ela = p.counters().get(Counter.ELAPSED_MS);
+        StatsSource.Col text = first(ex.fullText(), cols);
+        if (text == null) {
+            text = p.text();
+        }
+        StatsSource.Col max = first(ex.maxElapsed(), cols);
+        StatsSource.Col last = first(ex.lastActive(), cols);
+        StringBuilder sel = new StringBuilder();
+        for (int i = 0; i < p.ids().size(); i++) {
+            sel.append(i == 0 ? "" : ", ").append(p.ids().get(i)).append(" AS NID").append(i);
+        }
+        sel.append(", ").append(text == null ? "NULL" : text.expr()).append(" AS TXT");
+        sel.append(", ").append(p.schema() == null ? "NULL" : p.schema().expr()).append(" AS SCH");
+        sel.append(", ").append(p.plan() == null ? "NULL" : p.plan().expr()).append(" AS PLN");
+        for (Map.Entry<Counter, StatsSource.Col> e : p.counters().entrySet()) {
+            sel.append(", ").append(e.getValue().expr()).append(" AS C_").append(e.getKey().name());
+        }
+        sel.append(", ").append(max == null ? "NULL" : max.expr()).append(" AS MAXV");
+        sel.append(", ").append(max == null ? "1" : num(max.divisor())).append(" AS MAXD");
+        sel.append(", ").append(last == null ? "NULL" : last.expr()).append(" AS LASTV");
+        String avg = "(" + ela.expr() + ") / NULLIF(" + exec.expr() + ", 0)";
+        sel.append(", ").append(avg).append(" AS AVGV");
+        List<String> where = new ArrayList<>(p.filters());
+        where.add(exec.expr() + " > 0");
+        where.add("(" + ela.expr() + ") >= " + num(Math.max(0, minAvgMs) * ela.divisor()) + " * (" + exec.expr() + ")");
+        String w = " WHERE " + String.join(" AND ", where);
+        String order = " ORDER BY " + avg + " DESC";
+        int n = Math.max(1, topN);
+        return switch (p.spec().limit()) {
+            case ROWNUM -> "SELECT * FROM (SELECT " + sel + " FROM " + p.spec().from() + w + order + ") WHERE ROWNUM <= " + n;
+            case TOP -> "SELECT TOP " + n + " " + sel + " FROM " + p.spec().from() + w + order;
+            case LIMIT -> "SELECT " + sel + " FROM " + p.spec().from() + w + order + " LIMIT " + n;
+        };
+    }
+
+    /** 达梦 V$LONG_EXEC_SQLS：每行一次超时执行，按 SQL 文本汇总（纯函数） */
+    static String damengLongExecQuery(Set<String> cols, int topN, double minAvgMs, double divisor) {
+        if (!cols.contains("SQL_TEXT") || !cols.contains("EXEC_TIME")) {
+            return null;
+        }
+        double d = divisor > 0 ? divisor : 1;
+        String t = "SUBSTR(SQL_TEXT, 1, 2000)";
+        String last = cols.contains("FINISH_TIME") ? "MAX(FINISH_TIME)" : "NULL";
+        String nid = cols.contains("SQL_ID") ? "MAX(SQL_ID)" : "NULL";
+        return "SELECT * FROM (SELECT " + nid + " AS NID0, " + t + " AS TXT, NULL AS SCH, NULL AS PLN, COUNT(*) AS C_EXEC, "
+                + "SUM(EXEC_TIME) / " + num(d) + " AS C_ELAPSED_MS, MAX(EXEC_TIME) AS MAXV, " + num(d) + " AS MAXD, " + last + " AS LASTV, "
+                + "AVG(EXEC_TIME) / " + num(d) + " AS AVGV FROM V$LONG_EXEC_SQLS WHERE EXEC_TIME >= " + num(Math.max(0, minAvgMs) * d)
+                + " GROUP BY " + t + " ORDER BY AVGV DESC) WHERE ROWNUM <= " + Math.max(1, topN);
+    }
+
+    public static Result capture(TargetDb db, String platformType, int topN, double minAvgMs, double panweiDiv, double damengDiv)
+            throws SQLException {
+        String t = DbType.normalize(platformType);
+        if (DbType.DAMENG.equals(t)) {
+            try {
+                Set<String> cols = StatsSource.columns(db, "V$LONG_EXEC_SQLS");
+                String q = damengLongExecQuery(cols, topN, minAvgMs, damengDiv);
+                if (q != null) {
+                    return new Result("V$LONG_EXEC_SQLS", map(db.queryMax(topN, q), null, true));
+                }
+            } catch (SQLException ignore) {
+                // 未开启 / 无权限：退回 V$SQL_STAT
+            }
+        }
+        StatsSource.Spec spec = StatsSource.spec(t, panweiDiv, damengDiv);
+        if (spec == null) {
+            throw new SQLException("不支持的数据库类型: " + platformType);
+        }
+        Set<String> cols = StatsSource.columns(db, spec.from());
+        StatsSource.Probe p = StatsSource.resolve(spec, cols);
+        if (!p.ok()) {
+            throw new SQLException(p.error());
+        }
+        String q = buildQuery(p, cols, extras(t, panweiDiv, damengDiv), topN, minAvgMs);
+        List<SlowRow> rows = map(db.queryMax(topN, q), p, false);
+        if (DbType.ORACLE.equals(t)) {
+            rows = markOracleFullScan(db, rows);
+        }
+        return new Result(spec.sourceName(), rows);
+    }
+
+    static List<SlowRow> map(List<Map<String, Object>> raw, StatsSource.Probe p, boolean longExec) {
+        List<SlowRow> out = new ArrayList<>(raw.size());
+        for (Map<String, Object> r : raw) {
+            String text = Values.str(r.get("TXT"));
+            if (text == null || text.isBlank()) {
+                continue;
+            }
+            StringBuilder nid = new StringBuilder();
+            int n = p == null ? 1 : p.ids().size();
+            for (int i = 0; i < n; i++) {
+                if (i > 0) {
+                    nid.append('|');
+                }
+                nid.append(Values.str(r.get("NID" + i), ""));
+            }
+            String nativeId = nid.toString().replaceAll("^\\|+|\\|+$", "");
+            if (nativeId.isBlank()) {
+                nativeId = "TXT:" + Integer.toHexString(text.hashCode());
+            }
+            Double maxRaw = Values.toDouble(r.get("MAXV"));
+            Double maxD = Values.toDouble(r.get("MAXD"));
+            Double noIdx = p == null ? null : div(r.get("C_NO_INDEX"), p, Counter.NO_INDEX);
+            out.add(new SlowRow(Values.truncate(nativeId, 160), Values.str(r.get("SCH")), text, Values.str(r.get("PLN")),
+                    p == null ? Values.toDouble(r.get("C_EXEC")) : div(r.get("C_EXEC"), p, Counter.EXEC),
+                    p == null ? Values.toDouble(r.get("C_ELAPSED_MS")) : div(r.get("C_ELAPSED_MS"), p, Counter.ELAPSED_MS),
+                    longExec ? Values.toDouble(r.get("AVGV")) : avg(r, p),
+                    maxRaw == null ? null : maxRaw / (maxD == null || maxD == 0 ? 1 : maxD),
+                    p == null ? null : div(r.get("C_CPU_MS"), p, Counter.CPU_MS),
+                    p == null ? null : div(r.get("C_LOGICAL_READS"), p, Counter.LOGICAL_READS),
+                    p == null ? null : div(r.get("C_PHYSICAL_READS"), p, Counter.PHYSICAL_READS),
+                    p == null ? null : div(r.get("C_ROWS_RETURNED"), p, Counter.ROWS_RETURNED),
+                    ts(r.get("LASTV")), noIdx != null && noIdx > 0));
+        }
+        return out;
+    }
+
+    private static Double avg(Map<String, Object> r, StatsSource.Probe p) {
+        Double e = div(r.get("C_ELAPSED_MS"), p, Counter.ELAPSED_MS);
+        Double x = div(r.get("C_EXEC"), p, Counter.EXEC);
+        return e == null || x == null || x == 0 ? null : e / x;
+    }
+
+    private static Double div(Object v, StatsSource.Probe p, Counter c) {
+        Double d = Values.toDouble(v);
+        StatsSource.Col col = p.counters().get(c);
+        if (d == null || col == null) {
+            return null;
+        }
+        return d / col.divisor();
+    }
+
+    static Timestamp ts(Object v) {
+        if (v instanceof Timestamp t) {
+            return t;
+        }
+        if (v instanceof java.util.Date d) {
+            return new Timestamp(d.getTime());
+        }
+        if (v instanceof java.time.LocalDateTime l) {
+            return Timestamp.valueOf(l);
+        }
+        if (v instanceof java.time.OffsetDateTime o) {
+            return Timestamp.from(o.toInstant());
+        }
+        return null;
+    }
+
+    /** Oracle：执行计划中含 TABLE ACCESS FULL 的 SQL 标记全表扫描（查询失败不影响采集结果） */
+    static List<SlowRow> markOracleFullScan(TargetDb db, List<SlowRow> rows) {
+        if (rows.isEmpty()) {
+            return rows;
+        }
+        List<String> ids = new ArrayList<>();
+        for (SlowRow r : rows) {
+            if (r.nativeId().matches("[0-9a-z]{13}")) {
+                ids.add(r.nativeId());
+            }
+        }
+        if (ids.isEmpty()) {
+            return rows;
+        }
+        Set<String> full = new HashSet<>();
+        StringBuilder ph = new StringBuilder();
+        for (int i = 0; i < ids.size(); i++) {
+            ph.append(i == 0 ? "?" : ", ?");
+        }
+        for (Map<String, Object> m : db.queryOrEmpty("SELECT DISTINCT SQL_ID FROM V$SQL_PLAN WHERE SQL_ID IN (" + ph
+                + ") AND OPERATION = 'TABLE ACCESS' AND OPTIONS LIKE '%FULL%'", ids.toArray())) {
+            full.add(Values.str(m.get("SQL_ID")));
+        }
+        List<SlowRow> out = new ArrayList<>(rows.size());
+        for (SlowRow r : rows) {
+            out.add(full.contains(r.nativeId()) == r.fullScan() ? r : new SlowRow(r.nativeId(), r.schema(), r.sqlText(), r.planHash(),
+                    r.execs(), r.totalMs(), r.avgMs(), r.maxMs(), r.cpuMs(), r.logicalReads(), r.physicalReads(), r.rows(),
+                    r.lastActive(), r.fullScan() || full.contains(r.nativeId())));
+        }
+        return out;
+    }
+}
diff --git a/dbops-server/src/main/java/com/dbops/sqlinsight/collect/SqlCollectService.java b/dbops-server/src/main/java/com/dbops/sqlinsight/collect/SqlCollectService.java
new file mode 100644
index 0000000..190c404
--- /dev/null
+++ b/dbops-server/src/main/java/com/dbops/sqlinsight/collect/SqlCollectService.java
@@ -0,0 +1,295 @@
+package com.dbops.sqlinsight.collect;
+
+import com.dbops.common.Values;
+import com.dbops.monitor.TargetConnector;
+import com.dbops.monitor.TargetDb;
+import com.dbops.service.SystemConfigService;
+import com.dbops.sqlinsight.anomaly.AnomalyService;
+import com.dbops.sqlinsight.rules.ProblemService;
+import com.dbops.sqlinsight.rules.RuleConfigService;
+import com.dbops.sqlinsight.rules.RuntimeRuleEngine;
+import com.dbops.sqlinsight.store.AssetService;
+import com.dbops.sqlinsight.store.InstanceDirectory;
+import com.dbops.sqlinsight.store.StatsRepo;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.stereotype.Service;
+
+import java.sql.Timestamp;
+import java.time.Instant;
+import java.time.LocalDateTime;
+import java.time.ZoneId;
+import java.time.temporal.ChronoUnit;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.ConcurrentHashMap;
+
+/**
+ * 每分钟一轮的 SQL 采集主流程（设计方案第 3 节）：
+ * <pre>
+ * 能力探测(6h 缓存) → 累计快照 → 增量/数据质量 → 资产指纹 → 变更窗口标记
+ *   → 单窗口波动判定(写 flags) → 分钟统计入库(幂等) → 运行态规则 → 事件管理/告警/诊断
+ * </pre>
+ * 活动会话采样（P-001/P-002/P-010）单独 15 秒一次。
+ */
+@Service
+public class SqlCollectService {
+
+    private static final Logger log = LoggerFactory.getLogger(SqlCollectService.class);
+    private static final long PROBE_TTL_MS = 6 * 3600_000L;
+
+    private final TargetConnector connector;
+    private final InstanceDirectory instances;
+    private final AssetService assets;
+    private final StatsRepo stats;
+    private final RuleConfigService rules;
+    private final ProblemService problems;
+    private final AnomalyService anomalies;
+    private final SystemConfigService cfg;
+    private final DeltaEngine delta = new DeltaEngine();
+    private final Map<Long, StatsSource.Probe> probes = new ConcurrentHashMap<>();
+    private final Map<Long, Long> probedAt = new ConcurrentHashMap<>();
+    private final Set<Long> running = ConcurrentHashMap.newKeySet();
+    private final Set<Long> sampling = ConcurrentHashMap.newKeySet();
+    /** 会话规则连续命中计数：实例 → (规则|会话键 → 次数) */
+    private final Map<Long, Map<String, Integer>> sessionStreak = new ConcurrentHashMap<>();
+    private final Map<Long, String> lastError = new ConcurrentHashMap<>();
+
+    public SqlCollectService(TargetConnector connector, InstanceDirectory instances, AssetService assets, StatsRepo stats,
+                             RuleConfigService rules, ProblemService problems, AnomalyService anomalies, SystemConfigService cfg) {
+        this.connector = connector;
+        this.instances = instances;
+        this.assets = assets;
+        this.stats = stats;
+        this.rules = rules;
+        this.problems = problems;
+        this.anomalies = anomalies;
+        this.cfg = cfg;
+    }
+
+    public boolean isRunning(long instanceId) {
+        return running.contains(instanceId);
+    }
+
+    public String lastError(long instanceId) {
+        return lastError.get(instanceId);
+    }
+
+    public void reprobe(long instanceId) {
+        probedAt.remove(instanceId);
+    }
+
+    // ------------------------------------------------------------------ 分钟采集
+
+    public Map<String, Object> collect(long instanceId) {
+        InstanceDirectory.Inst inst = instances.get(instanceId);
+        if (inst == null) {
+            throw com.dbops.common.BizException.notFound("实例不存在");
+        }
+        if (!running.add(instanceId)) {
+            return Map.of("skipped", "上一轮采集仍在进行");
+        }
+        long t0 = System.currentTimeMillis();
+        Map<String, Object> summary = new LinkedHashMap<>();
+        try (TargetDb tdb = connector.open(instanceId)) {
+            StatsSource.Probe probe = probe(inst, tdb);
+            summary.put("source", probe.spec() == null ? null : probe.spec().sourceName());
+            if (!probe.ok()) {
+                summary.put("error", probe.error());
+                lastError.put(instanceId, probe.error());
+                return summary;
+            }
+            int topN = (int) cfg.getLong("sqlinsight.collect.top_n", 1000);
+            List<SqlCounters> snap = StatsSource.snapshot(tdb, probe, topN);
+            long now = System.currentTimeMillis();
+            long interval = Math.max(30_000L, cfg.getLong("sqlinsight.collect.interval_sec", 60) * 1000);
+            DeltaEngine.Result dr = delta.compute(instanceId, snap, now, interval, probe.activityFiltered());
+            summary.put("snapshot", snap.size());
+            summary.put("baseline", dr.baseline());
+            summary.put("reset", dr.reset());
+            summary.put("gap", dr.gap());
+            summary.put("idle", dr.idle());
+            Timestamp windowStart = Timestamp.from(Instant.ofEpochMilli(now).truncatedTo(ChronoUnit.MINUTES));
+            int stored = processWindow(inst, dr.rows(), windowStart, summary);
+            summary.put("stored", stored);
+            lastError.remove(instanceId);
+        } catch (Exception e) {
+            delta.forget(instanceId);
+            lastError.put(instanceId, Values.truncate(e.getMessage(), 500));
+            summary.put("error", e.getMessage());
+            log.warn("[sqlinsight] collect inst={} failed: {}", instanceId, e.getMessage());
+        } finally {
+            running.remove(instanceId);
+        }
+        summary.put("costMs", System.currentTimeMillis() - t0);
+        return summary;
+    }
+
+    StatsSource.Probe probe(InstanceDirectory.Inst inst, TargetDb tdb) {
+        Long at = probedAt.get(inst.id());
+        StatsSource.Probe p = probes.get(inst.id());
+        // 探测失败只缓存 5 分钟（原来失败也缓存 6 小时：授权/网络问题修好后要等 6 小时才恢复采集）
+        long ttl = p != null && !p.ok() ? 5 * 60_000L : PROBE_TTL_MS;
+        if (p != null && at != null && System.currentTimeMillis() - at < ttl) {
+            return p;
+        }
+        StatsSource.Spec spec = StatsSource.spec(inst.dbType(), cfg.getNumber("sqlinsight.panwei.time_divisor", 1000),
+                cfg.getNumber("sqlinsight.dameng.time_divisor", 1));
+        if (spec == null) {
+            p = new StatsSource.Probe(null, false, "不支持的数据库类型: " + inst.dbType(), List.of(), null, null, null, Map.of(), List.of(), null);
+        } else {
+            p = StatsSource.probe(tdb, spec);
+        }
+        try {
+            stats.saveCapability(inst.id(), p.ok() ? p.capability() : StatsSource.noneCapability(),
+                    spec == null ? null : spec.sourceName(), p.error());
+        } catch (Exception e) {
+            log.warn("[sqlinsight] save capability inst={}: {}", inst.id(), e.getMessage());
+        }
+        probes.put(inst.id(), p);
+        probedAt.put(inst.id(), System.currentTimeMillis());
+        return p;
+    }
+
+    /** 窗口处理（与连接无关，单测可直接喂 WindowRow） */
+    int processWindow(InstanceDirectory.Inst inst, List<WindowRow> rows, Timestamp windowStart, Map<String, Object> summary) {
+        if (rows.isEmpty()) {
+            problems.resolveStale(inst.id(), 30);
+            return 0;
+        }
+        // 1) 资产
+        Map<Long, List<String>> nativeIds = new HashMap<>();
+        Map<Long, Boolean> core = new HashMap<>();
+        Map<Long, String> bizOf = new HashMap<>();
+        for (WindowRow r : rows) {
+            AssetService.AssetRef a = assets.resolveNative(inst.id(), r.cur.nativeId(), inst.dbType(), r.cur.schema(), r.cur.sqlText());
+            r.assetId = a.assetId();
+            core.put(a.assetId(), a.core());
+            if (a.bizType() != null && InstanceDirectory.BIZ_TYPES.contains(a.bizType())) {
+                bizOf.put(a.assetId(), a.bizType());
+            }
+            nativeIds.computeIfAbsent(a.assetId(), k -> new ArrayList<>()).add(r.cur.nativeId());
+        }
+        assets.touchSources(inst.id(), nativeIds);
+        assets.touchLastSeen(nativeIds.keySet());
+
+        // 2) 变更窗口：窗口内数据入库但不进基线、不告警
+        Map<String, Object> change = stats.activeChangeWindow(inst.id());
+        if (change != null) {
+            rows.forEach(r -> r.excludeBaseline = true);
+            summary.put("changeWindow", change.get("TITLE"));
+        }
+
+        // 3) 合并：入库粒度 (资产, 计划)；规则/检测粒度 资产
+        double total = 0;
+        for (WindowRow r : rows) {
+            double e = r.d(Counter.ELAPSED_MS);
+            total += Double.isNaN(e) ? 0 : e;
+        }
+        Map<String, List<WindowRow>> byPlan = new LinkedHashMap<>();
+        Map<Long, List<WindowRow>> byAsset = new LinkedHashMap<>();
+        for (WindowRow r : rows) {
+            byPlan.computeIfAbsent(r.assetId + "#" + r.cur.planHash(), k -> new ArrayList<>()).add(r);
+            byAsset.computeIfAbsent(r.assetId, k -> new ArrayList<>()).add(r);
+        }
+        List<WindowRow> planRows = new ArrayList<>();
+        for (List<WindowRow> g : byPlan.values()) {
+            planRows.add(WindowRow.merge(g, total));
+        }
+        Map<Long, WindowRow> assetRows = new LinkedHashMap<>();
+        for (Map.Entry<Long, List<WindowRow>> e : byAsset.entrySet()) {
+            assetRows.put(e.getKey(), WindowRow.merge(e.getValue(), total));
+        }
+
+        // 4) 单窗口波动判定（flags 随统计一起入库，作为持续性判断的状态）
+        boolean anomalyOn = cfg.getBool("sqlinsight.anomaly.enabled", true);
+        AnomalyService.Detection det = null;
+        if (anomalyOn) {
+            det = anomalies.detect(inst.id(), assetRows, LocalDateTime.ofInstant(windowStart.toInstant(), ZoneId.systemDefault()));
+            for (WindowRow r : planRows) {
+                WindowRow a = assetRows.get(r.assetId);
+                r.anomalyFlags = a == null ? 0 : a.anomalyFlags;
+            }
+        }
+
+        // 5) 入库
+        String batchId = inst.id() + "-" + windowStart.getTime() / 60000;
+        int stored = stats.insertWindow(inst.id(), windowStart, batchId, planRows);
+
+        // 6) 运行态规则
+        if (cfg.getBool("sqlinsight.rules.enabled", true)) {
+            Timestamp since = new Timestamp(windowStart.getTime() - 10 * 60_000L);
+            Map<Long, List<Double>> shares = stats.recentColumn(inst.id(), "DB_TIME_SHARE", since);
+            Map<Long, List<Double>> tmp = stats.recentColumn(inst.id(), "D_TMP_DISK", since);
+            Map<Long, Long> nat = stats.nativeIdCounts(inst.id(), new ArrayList<>(assetRows.keySet()));
+            StatsSource.Probe p = probes.get(inst.id());
+            RuntimeRuleEngine.Ctx ctx = new RuntimeRuleEngine.Ctx(
+                    (code, asset) -> rules.resolve(code, new RuleConfigService.Scope(asset, inst.id(), bizOf.getOrDefault(asset, inst.bizType()), inst.family())),
+                    c -> p != null && p.supports(c),
+                    a -> tail(shares.get(a)), a -> tail(tmp.get(a)), nat::get);
+            RuntimeRuleEngine.Result res = RuntimeRuleEngine.evaluateWindow(new ArrayList<>(assetRows.values()), ctx);
+            int opened = problems.applyWindow(inst, res, assetRows.keySet());
+            problems.resolveStale(inst.id(), 30);
+            summary.put("problemsOpened", opened);
+            summary.put("hits", res.hits().size());
+        }
+
+        // 7) 事件管理
+        if (anomalyOn && det != null) {
+            anomalies.process(inst, det, assetRows, core, windowStart, change);
+        }
+        return stored;
+    }
+
+    /** recentColumn 返回含本窗口（新→旧），规则需要“之前的窗口” */
+    private static List<Double> tail(List<Double> l) {
+        return l == null || l.isEmpty() ? List.of() : l.subList(1, l.size());
+    }
+
+    // ------------------------------------------------------------------ 活动会话采样
+
+    public Map<String, Object> sampleSessions(long instanceId) {
+        InstanceDirectory.Inst inst = instances.get(instanceId);
+        if (inst == null || !sampling.add(instanceId)) {
+            return Map.of();
+        }
+        try (TargetDb tdb = connector.open(instanceId)) {
+            List<ActiveSession> sessions;
+            try {
+                sessions = SessionSampler.sample(tdb, inst.dbType(), 500);
+            } catch (Exception e) {
+                stats.saveCapability(instanceId, "active_session", false, "session", Values.truncate(e.getMessage(), 900));
+                problems.applySessions(inst, List.of(), false, "活动会话视图不可用：" + Values.truncate(e.getMessage(), 300));
+                return Map.of("error", Values.str(e.getMessage(), ""));
+            }
+            Map<String, Integer> streak = sessionStreak.computeIfAbsent(instanceId, k -> new ConcurrentHashMap<>());
+            List<RuntimeRuleEngine.SessionHit> hits = RuntimeRuleEngine.evaluateSessions(sessions,
+                    s -> {
+                        if (s.sqlText() == null || s.sqlText().isBlank()) {
+                            return 0L;
+                        }
+                        String nid = s.nativeId() != null ? s.nativeId() : "TXT:" + Integer.toHexString(s.sqlText().hashCode());
+                        return assets.resolveNative(instanceId, nid, inst.dbType(), s.schema(), s.sqlText()).assetId();
+                    },
+                    (code, asset) -> rules.resolve(code, new RuleConfigService.Scope(asset, inst.id(), inst.bizType(), inst.family())),
+                    k -> streak.getOrDefault(k, 0));
+            Map<String, Integer> next = new HashMap<>();
+            for (RuntimeRuleEngine.SessionHit h : hits) {
+                String k = h.code() + "|" + h.sessionKey();
+                next.put(k, streak.getOrDefault(k, 0) + 1);
+            }
+            streak.clear();
+            streak.putAll(next);
+            problems.applySessions(inst, hits, true, null);
+            return Map.of("sessions", sessions.size(), "hits", hits.stream().filter(h -> h.severity() != null).count());
+        } catch (Exception e) {
+            return Map.of("error", Values.str(e.getMessage(), ""));
+        } finally {
+            sampling.remove(instanceId);
+        }
+    }
+}
diff --git a/dbops-server/src/main/java/com/dbops/sqlinsight/collect/SqlCounters.java b/dbops-server/src/main/java/com/dbops/sqlinsight/collect/SqlCounters.java
new file mode 100644
index 0000000..73ab8e1
--- /dev/null
+++ b/dbops-server/src/main/java/com/dbops/sqlinsight/collect/SqlCounters.java
@@ -0,0 +1,33 @@
+package com.dbops.sqlinsight.collect;
+
+import java.util.Arrays;
+
+/** 一条 SQL（原生标识 + 计划）在某个时刻的累计计数器快照；不支持/缺失的计数器为 NaN */
+public record SqlCounters(String nativeId, String planHash, String schema, String sqlText, double[] values) {
+
+    public SqlCounters {
+        if (values == null || values.length != Counter.SIZE) {
+            double[] v = new double[Counter.SIZE];
+            Arrays.fill(v, Double.NaN);
+            if (values != null) {
+                System.arraycopy(values, 0, v, 0, Math.min(values.length, v.length));
+            }
+            values = v;
+        }
+        planHash = planHash == null || planHash.isBlank() ? "NA" : planHash;
+    }
+
+    public double get(Counter c) {
+        return values[c.ordinal()];
+    }
+
+    public String key() {
+        return nativeId + "#" + planHash;
+    }
+
+    public static double[] empty() {
+        double[] v = new double[Counter.SIZE];
+        Arrays.fill(v, Double.NaN);
+        return v;
+    }
+}
diff --git a/dbops-server/src/main/java/com/dbops/sqlinsight/collect/StatsSource.java b/dbops-server/src/main/java/com/dbops/sqlinsight/collect/StatsSource.java
new file mode 100644
index 0000000..f784d10
--- /dev/null
+++ b/dbops-server/src/main/java/com/dbops/sqlinsight/collect/StatsSource.java
@@ -0,0 +1,344 @@
+package com.dbops.sqlinsight.collect;
+
+import com.dbops.common.Values;
+import com.dbops.monitor.DbType;
+import com.dbops.monitor.TargetDb;
+
+import java.sql.PreparedStatement;
+import java.sql.ResultSetMetaData;
+import java.sql.SQLException;
+import java.util.ArrayList;
+import java.util.EnumMap;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Set;
+
+/**
+ * 各库 SQL 累计统计视图的“声明式”描述 + 自适应取数。
+ * <p>
+ * 先用 {@code SELECT * FROM 视图 WHERE 1=0} 读取实际列名（能力探测），每个计数器在候选列中取第一个存在的；
+ * 不存在的计数器记为 UNSUPPORTED，不会按 0 处理。版本差异（PG13 total_exec_time / 旧版 total_time、
+ * MySQL 8.0.28 SUM_CPU_TIME、磐维/达梦字段待实测）都用候选列吸收，不需要写分支代码。
+ */
+public final class StatsSource {
+
+    /** 候选列：expr 为 SQL 表达式，requires 为它依赖的列（全部存在才可用），divisor 为单位换算除数 */
+    public record Col(String expr, Set<String> requires, double divisor) {
+        static Col c(String column) {
+            return new Col(column, Set.of(column.toUpperCase(Locale.ROOT)), 1);
+        }
+
+        static Col c(String column, double divisor) {
+            return new Col(column, Set.of(column.toUpperCase(Locale.ROOT)), divisor);
+        }
+
+        static Col expr(String expr, double divisor, String... requires) {
+            Set<String> r = new HashSet<>();
+            for (String s : requires) {
+                r.add(s.toUpperCase(Locale.ROOT));
+            }
+            return new Col(expr, r, divisor);
+        }
+
+        boolean available(Set<String> cols) {
+            return cols.containsAll(requires);
+        }
+    }
+
+    /** 过滤条件：requires 不满足时整条跳过 */
+    public record Filter(String sql, Set<String> requires) {
+        static Filter f(String sql, String... requires) {
+            Set<String> r = new HashSet<>();
+            for (String s : requires) {
+                r.add(s.toUpperCase(Locale.ROOT));
+            }
+            return new Filter(sql, r);
+        }
+    }
+
+    public enum LimitStyle { ROWNUM, LIMIT, TOP }
+
+    public record Spec(String dbType, String sourceName, String from, List<String> idCols, List<String> optionalIdCols,
+                       List<Col> text, List<Col> schema, List<Col> plan, Map<Counter, List<Col>> counters,
+                       List<Filter> filters, Filter activity, LimitStyle limit) {
+    }
+
+    /** 探测结果：选中的列 + 能力矩阵 */
+    public record Probe(Spec spec, boolean ok, String error, List<String> ids, Col text, Col schema, Col plan,
+                        Map<Counter, Col> counters, List<String> filters, String activity) {
+
+        public Map<String, Boolean> capability() {
+            Map<String, Boolean> m = new LinkedHashMap<>();
+            for (Counter c : Counter.values()) {
+                m.put(c.capability(), ok && counters.containsKey(c));
+            }
+            m.put("plan_hash", ok && plan != null);
+            return m;
+        }
+
+        public boolean supports(Counter c) {
+            return ok && counters.containsKey(c);
+        }
+
+        public boolean activityFiltered() {
+            return activity != null;
+        }
+    }
+
+    private StatsSource() {
+    }
+
+    /** 探测失败时的能力矩阵：全部不支持 */
+    public static Map<String, Boolean> noneCapability() {
+        Map<String, Boolean> m = new LinkedHashMap<>();
+        for (Counter c : Counter.values()) {
+            m.put(c.capability(), false);
+        }
+        m.put("plan_hash", false);
+        return m;
+    }
+
+    // ------------------------------------------------------------------ 各库声明
+
+    public static Spec spec(String platformType, double panweiTimeDivisor, double damengTimeDivisor) {
+        String t = DbType.normalize(platformType);
+        return switch (t) {
+            case DbType.ORACLE -> oracle();
+            case DbType.MYSQL, DbType.GOLDENDB -> mysql(t);
+            case DbType.POSTGRESQL -> postgres();
+            case DbType.PANWEI -> panwei(panweiTimeDivisor);
+            case DbType.DAMENG -> dameng(damengTimeDivisor);
+            case DbType.SQLSERVER -> sqlserver();
+            default -> null;
+        };
+    }
+
+    static Spec oracle() {
+        Map<Counter, List<Col>> m = new EnumMap<>(Counter.class);
+        m.put(Counter.EXEC, List.of(Col.c("EXECUTIONS")));
+        m.put(Counter.ELAPSED_MS, List.of(Col.c("ELAPSED_TIME", 1000)));
+        m.put(Counter.CPU_MS, List.of(Col.c("CPU_TIME", 1000)));
+        m.put(Counter.LOGICAL_READS, List.of(Col.c("BUFFER_GETS")));
+        m.put(Counter.PHYSICAL_READS, List.of(Col.c("DISK_READS")));
+        m.put(Counter.ROWS_RETURNED, List.of(Col.c("ROWS_PROCESSED")));
+        m.put(Counter.TMP_DISK, List.of(Col.c("DIRECT_WRITES")));
+        return new Spec(DbType.ORACLE, "V$SQLAREA_PLAN_HASH", "V$SQLAREA_PLAN_HASH", List.of("SQL_ID"), List.of(),
+                List.of(Col.c("SQL_TEXT")), List.of(Col.c("PARSING_SCHEMA_NAME")), List.of(Col.c("PLAN_HASH_VALUE")), m,
+                List.of(Filter.f("PARSING_SCHEMA_NAME NOT IN ('SYS','SYSTEM','DBSNMP','SYSMAN','XDB','AUDSYS','GSMADMIN_INTERNAL','ORDS_METADATA','MDSYS','CTXSYS','WMSYS','OUTLN')", "PARSING_SCHEMA_NAME"),
+                        Filter.f("COMMAND_TYPE IN (2, 3, 6, 7, 189)", "COMMAND_TYPE")),
+                Filter.f("LAST_ACTIVE_TIME >= SYSDATE - 2/1440", "LAST_ACTIVE_TIME"), LimitStyle.ROWNUM);
+    }
+
+    static Spec mysql(String t) {
+        Map<Counter, List<Col>> m = new EnumMap<>(Counter.class);
+        m.put(Counter.EXEC, List.of(Col.c("COUNT_STAR")));
+        m.put(Counter.ELAPSED_MS, List.of(Col.c("SUM_TIMER_WAIT", 1e9)));      // 皮秒 → 毫秒
+        m.put(Counter.CPU_MS, List.of(Col.c("SUM_CPU_TIME", 1e9)));            // 8.0.28+
+        m.put(Counter.ROWS_EXAMINED, List.of(Col.c("SUM_ROWS_EXAMINED")));
+        m.put(Counter.ROWS_RETURNED, List.of(Col.c("SUM_ROWS_SENT")));
+        m.put(Counter.ERRORS, List.of(Col.c("SUM_ERRORS")));
+        m.put(Counter.TMP_DISK, List.of(Col.c("SUM_CREATED_TMP_DISK_TABLES")));
+        m.put(Counter.NO_INDEX, List.of(Col.expr("SUM_NO_INDEX_USED + SUM_NO_GOOD_INDEX_USED", 1, "SUM_NO_INDEX_USED", "SUM_NO_GOOD_INDEX_USED"),
+                Col.c("SUM_NO_INDEX_USED")));
+        return new Spec(t, "performance_schema.events_statements_summary_by_digest",
+                "performance_schema.events_statements_summary_by_digest", List.of("SCHEMA_NAME", "DIGEST"), List.of(),
+                List.of(Col.c("DIGEST_TEXT")), List.of(Col.c("SCHEMA_NAME")), List.of(), m,
+                List.of(Filter.f("DIGEST IS NOT NULL", "DIGEST"),
+                        Filter.f("(SCHEMA_NAME IS NULL OR SCHEMA_NAME NOT IN ('mysql','performance_schema','information_schema','sys'))", "SCHEMA_NAME")),
+                Filter.f("LAST_SEEN >= NOW() - INTERVAL 2 MINUTE", "LAST_SEEN"), LimitStyle.LIMIT);
+    }
+
+    static Spec postgres() {
+        Map<Counter, List<Col>> m = new EnumMap<>(Counter.class);
+        m.put(Counter.EXEC, List.of(Col.c("CALLS")));
+        m.put(Counter.ELAPSED_MS, List.of(Col.c("TOTAL_EXEC_TIME"), Col.c("TOTAL_TIME")));  // PG13+ / 旧版，单位 ms
+        m.put(Counter.LOGICAL_READS, List.of(Col.expr("SHARED_BLKS_HIT + SHARED_BLKS_READ", 1, "SHARED_BLKS_HIT", "SHARED_BLKS_READ")));
+        m.put(Counter.PHYSICAL_READS, List.of(Col.c("SHARED_BLKS_READ")));
+        m.put(Counter.ROWS_RETURNED, List.of(Col.c("ROWS")));
+        m.put(Counter.TMP_DISK, List.of(Col.c("TEMP_BLKS_WRITTEN")));
+        return new Spec(DbType.POSTGRESQL, "pg_stat_statements",
+                "(SELECT s.*, d.datname AS dbname FROM pg_stat_statements s JOIN pg_database d ON d.oid = s.dbid) t",
+                List.of("USERID", "DBID", "QUERYID"), List.of("TOPLEVEL"),
+                List.of(Col.c("QUERY")), List.of(Col.c("DBNAME")), List.of(), m,
+                List.of(Filter.f("QUERYID IS NOT NULL", "QUERYID")), null, LimitStyle.LIMIT);
+    }
+
+    static Spec panwei(double divisor) {
+        double d = divisor > 0 ? divisor : 1000;
+        Map<Counter, List<Col>> m = new EnumMap<>(Counter.class);
+        m.put(Counter.EXEC, List.of(Col.c("N_CALLS")));
+        m.put(Counter.ELAPSED_MS, List.of(Col.c("TOTAL_ELAPSE_TIME", d)));
+        m.put(Counter.CPU_MS, List.of(Col.c("CPU_TIME", d)));
+        m.put(Counter.LOGICAL_READS, List.of(Col.c("N_BLOCKS_FETCHED")));
+        m.put(Counter.PHYSICAL_READS, List.of(Col.expr("N_BLOCKS_FETCHED - N_BLOCKS_HIT", 1, "N_BLOCKS_FETCHED", "N_BLOCKS_HIT")));
+        m.put(Counter.ROWS_EXAMINED, List.of(Col.expr("N_TUPLES_FETCHED + N_TUPLES_RETURNED", 1, "N_TUPLES_FETCHED", "N_TUPLES_RETURNED")));
+        m.put(Counter.ROWS_RETURNED, List.of(Col.c("N_RETURNED_ROWS")));
+        return new Spec(DbType.PANWEI, "dbe_perf.statement", "dbe_perf.statement", List.of("UNIQUE_SQL_ID", "USER_ID"),
+                List.of("NODE_ID"), List.of(Col.c("QUERY")), List.of(Col.c("USER_NAME")), List.of(), m,
+                List.of(Filter.f("N_CALLS > 0", "N_CALLS")),
+                Filter.f("LAST_UPDATED >= NOW() - INTERVAL '2 minutes'", "LAST_UPDATED"), LimitStyle.LIMIT);
+    }
+
+    /** 达梦 V$SQL_STAT（需 ENABLE_MONITOR=1）：字段名随版本不同，候选列覆盖已知写法，未命中则记 UNSUPPORTED */
+    static Spec dameng(double divisor) {
+        double d = divisor > 0 ? divisor : 1;
+        Map<Counter, List<Col>> m = new EnumMap<>(Counter.class);
+        m.put(Counter.EXEC, List.of(Col.c("EXEC_TIMES"), Col.c("EXECUTE_TIMES"), Col.c("EXEC_COUNT")));
+        m.put(Counter.ELAPSED_MS, List.of(Col.c("TOTAL_EXEC_TIME", d), Col.c("EXEC_TIME", d), Col.c("TIME_USED", d)));
+        m.put(Counter.CPU_MS, List.of(Col.c("CPU_TIME", d)));
+        m.put(Counter.LOGICAL_READS, List.of(Col.c("LOGIC_READ_CNT"), Col.c("LOGIC_READS")));
+        m.put(Counter.PHYSICAL_READS, List.of(Col.c("PHY_READ_CNT"), Col.c("PHY_READS")));
+        m.put(Counter.ROWS_RETURNED, List.of(Col.c("ROW_COUNT"), Col.c("ROWS_PROCESSED")));
+        return new Spec(DbType.DAMENG, "V$SQL_STAT", "V$SQL_STAT", List.of("SQL_ID"), List.of(),
+                List.of(Col.c("SQL_TXT"), Col.c("SQL_TEXT")), List.of(Col.c("CURR_SCH"), Col.c("SCH_NAME")), List.of(), m,
+                List.of(), null, LimitStyle.ROWNUM);
+    }
+
+    static Spec sqlserver() {
+        String from = "(SELECT CONVERT(VARCHAR(64), qs.query_hash, 1) AS QHASH, CONVERT(VARCHAR(64), qs.query_plan_hash, 1) AS PHASH, "
+                + "DB_NAME(st.dbid) AS DBNAME, "
+                + "MAX(SUBSTRING(st.text, qs.statement_start_offset / 2 + 1, ((CASE qs.statement_end_offset WHEN -1 THEN DATALENGTH(st.text) "
+                + "ELSE qs.statement_end_offset END - qs.statement_start_offset) / 2) + 1)) AS STMT, "
+                + "SUM(qs.execution_count) AS EXECS, SUM(qs.total_elapsed_time) AS ELAPSED_US, SUM(qs.total_worker_time) AS CPU_US, "
+                + "SUM(qs.total_logical_reads) AS LR, SUM(qs.total_physical_reads) AS PR, SUM(qs.total_rows) AS ROWS_RET, "
+                + "MAX(qs.last_execution_time) AS LAST_EXEC, MAX(qs.max_elapsed_time) AS MAX_US "
+                + "FROM sys.dm_exec_query_stats qs CROSS APPLY sys.dm_exec_sql_text(qs.sql_handle) st "
+                + "GROUP BY qs.query_hash, qs.query_plan_hash, st.dbid) t";
+        Map<Counter, List<Col>> m = new EnumMap<>(Counter.class);
+        m.put(Counter.EXEC, List.of(Col.c("EXECS")));
+        m.put(Counter.ELAPSED_MS, List.of(Col.c("ELAPSED_US", 1000)));
+        m.put(Counter.CPU_MS, List.of(Col.c("CPU_US", 1000)));
+        m.put(Counter.LOGICAL_READS, List.of(Col.c("LR")));
+        m.put(Counter.PHYSICAL_READS, List.of(Col.c("PR")));
+        m.put(Counter.ROWS_RETURNED, List.of(Col.c("ROWS_RET")));
+        return new Spec(DbType.SQLSERVER, "sys.dm_exec_query_stats", from, List.of("QHASH"), List.of(),
+                List.of(Col.c("STMT")), List.of(Col.c("DBNAME")), List.of(Col.c("PHASH")), m,
+                List.of(Filter.f("DBNAME NOT IN ('master','msdb','tempdb','model')", "DBNAME")),
+                Filter.f("LAST_EXEC >= DATEADD(MINUTE, -2, GETDATE())", "LAST_EXEC"), LimitStyle.TOP);
+    }
+
+    // ------------------------------------------------------------------ 探测 / 取数
+
+    public static Probe probe(TargetDb db, Spec spec) {
+        try {
+            return resolve(spec, columns(db, spec.from()));
+        } catch (SQLException e) {
+            return new Probe(spec, false, Values.truncate(e.getMessage(), 900), List.of(), null, null, null, Map.of(), List.of(), null);
+        }
+    }
+
+    /** 视图/子查询的实际列名（大写） */
+    public static Set<String> columns(TargetDb db, String from) throws SQLException {
+        Set<String> cols = new HashSet<>();
+        try (PreparedStatement ps = db.connection().prepareStatement("SELECT * FROM " + from + " WHERE 1=0")) {
+            ps.setQueryTimeout(15);
+            ResultSetMetaData md = ps.executeQuery().getMetaData();
+            for (int i = 1; i <= md.getColumnCount(); i++) {
+                cols.add(md.getColumnLabel(i).toUpperCase(Locale.ROOT));
+            }
+        }
+        return cols;
+    }
+
+    /** 纯函数：按实际列名选择候选列（单测可直接调用） */
+    public static Probe resolve(Spec spec, Set<String> cols) {
+        List<String> ids = new ArrayList<>();
+        for (String id : spec.idCols()) {
+            if (!cols.contains(id)) {
+                return new Probe(spec, false, spec.sourceName() + " 缺少标识列 " + id, List.of(), null, null, null, Map.of(), List.of(), null);
+            }
+            ids.add(id);
+        }
+        for (String id : spec.optionalIdCols()) {
+            if (cols.contains(id)) {
+                ids.add(id);
+            }
+        }
+        Map<Counter, Col> chosen = new EnumMap<>(Counter.class);
+        for (Map.Entry<Counter, List<Col>> e : spec.counters().entrySet()) {
+            Col c = first(e.getValue(), cols);
+            if (c != null) {
+                chosen.put(e.getKey(), c);
+            }
+        }
+        if (!chosen.containsKey(Counter.EXEC) || !chosen.containsKey(Counter.ELAPSED_MS)) {
+            return new Probe(spec, false, spec.sourceName() + " 缺少执行次数/耗时列（实际列：" + Values.truncate(String.join(",", cols), 600) + "）",
+                    ids, null, null, null, Map.of(), List.of(), null);
+        }
+        List<String> filters = new ArrayList<>();
+        for (Filter f : spec.filters()) {
+            if (cols.containsAll(f.requires())) {
+                filters.add(f.sql());
+            }
+        }
+        String activity = spec.activity() != null && cols.containsAll(spec.activity().requires()) ? spec.activity().sql() : null;
+        return new Probe(spec, true, null, ids, first(spec.text(), cols), first(spec.schema(), cols), first(spec.plan(), cols),
+                chosen, filters, activity);
+    }
+
+    private static Col first(List<Col> list, Set<String> cols) {
+        for (Col c : list) {
+            if (c.available(cols)) {
+                return c;
+            }
+        }
+        return null;
+    }
+
+    /** 生成取数 SQL（纯函数，便于单测） */
+    public static String buildQuery(Probe p, int topN) {
+        StringBuilder sel = new StringBuilder();
+        for (int i = 0; i < p.ids().size(); i++) {
+            sel.append(i == 0 ? "" : ", ").append(p.ids().get(i)).append(" AS NID").append(i);
+        }
+        sel.append(", ").append(p.text() == null ? "NULL" : p.text().expr()).append(" AS TXT");
+        sel.append(", ").append(p.schema() == null ? "NULL" : p.schema().expr()).append(" AS SCH");
+        sel.append(", ").append(p.plan() == null ? "NULL" : p.plan().expr()).append(" AS PLN");
+        for (Map.Entry<Counter, Col> e : p.counters().entrySet()) {
+            sel.append(", ").append(e.getValue().expr()).append(" AS C_").append(e.getKey().name());
+        }
+        List<String> where = new ArrayList<>(p.filters());
+        if (p.activity() != null) {
+            where.add(p.activity());
+        }
+        String w = where.isEmpty() ? "" : " WHERE " + String.join(" AND ", where);
+        String order = " ORDER BY " + p.counters().get(Counter.ELAPSED_MS).expr() + " DESC";
+        int n = Math.max(1, topN);
+        return switch (p.spec().limit()) {
+            case ROWNUM -> "SELECT * FROM (SELECT " + sel + " FROM " + p.spec().from() + w + order + ") WHERE ROWNUM <= " + n;
+            case TOP -> "SELECT TOP " + n + " " + sel + " FROM " + p.spec().from() + w + order;
+            case LIMIT -> "SELECT " + sel + " FROM " + p.spec().from() + w + order + " LIMIT " + n;
+        };
+    }
+
+    public static List<SqlCounters> snapshot(TargetDb db, Probe p, int topN) throws SQLException {
+        List<Map<String, Object>> rows = db.queryMax(topN, buildQuery(p, topN));
+        List<SqlCounters> out = new ArrayList<>(rows.size());
+        for (Map<String, Object> r : rows) {
+            out.add(toCounters(p, r));
+        }
+        return out;
+    }
+
+    static SqlCounters toCounters(Probe p, Map<String, Object> r) {
+        StringBuilder nid = new StringBuilder();
+        for (int i = 0; i < p.ids().size(); i++) {
+            if (i > 0) {
+                nid.append('|');
+            }
+            nid.append(Values.str(r.get("NID" + i), "null"));
+        }
+        double[] v = SqlCounters.empty();
+        for (Map.Entry<Counter, Col> e : p.counters().entrySet()) {
+            Double d = Values.toDouble(r.get("C_" + e.getKey().name()));
+            if (d != null) {
+                v[e.getKey().ordinal()] = d / e.getValue().divisor();
+            }
+        }
+        return new SqlCounters(Values.truncate(nid.toString(), 160), Values.str(r.get("PLN")), Values.str(r.get("SCH")),
+                Values.str(r.get("TXT")), v);
+    }
+}
diff --git a/dbops-server/src/main/java/com/dbops/sqlinsight/collect/WindowRow.java b/dbops-server/src/main/java/com/dbops/sqlinsight/collect/WindowRow.java
new file mode 100644
index 0000000..4693a9f
--- /dev/null
+++ b/dbops-server/src/main/java/com/dbops/sqlinsight/collect/WindowRow.java
@@ -0,0 +1,101 @@
+package com.dbops.sqlinsight.collect;
+
+import java.util.EnumMap;
+import java.util.Map;
+
+/**
+ * 一条 SQL 在一个采集窗口内的增量与窗口指标（对应 DI_SQL_STATS_MIN 一行）。
+ * deltas 中 NaN 表示该计数器不支持；metrics 只包含可计算的指标。
+ */
+public final class WindowRow {
+    public final SqlCounters cur;
+    public final double[] deltas;
+    public final double minutes;
+    public final String quality;
+    public final Map<Metric, Double> metrics = new EnumMap<>(Metric.class);
+    public long assetId;
+    public int anomalyFlags;
+    public boolean excludeBaseline;
+
+    public WindowRow(SqlCounters cur, double[] deltas, double minutes, String quality) {
+        this.cur = cur;
+        this.deltas = deltas;
+        this.minutes = minutes;
+        this.quality = quality;
+    }
+
+    public double d(Counter c) {
+        return deltas[c.ordinal()];
+    }
+
+    public Double m(Metric m) {
+        return metrics.get(m);
+    }
+
+    /** 计算 9 个窗口指标；DB_TIME_SHARE 需要实例总耗时，单独传入 */
+    public void computeMetrics(double instanceElapsedMs) {
+        double exec = d(Counter.EXEC);
+        if (!(exec > 0)) {
+            return;
+        }
+        put(Metric.AVG_ELAPSED_MS, d(Counter.ELAPSED_MS) / exec);
+        put(Metric.CPU_PER_EXEC_MS, d(Counter.CPU_MS) / exec);
+        put(Metric.LOGICAL_READS_PER_EXEC, d(Counter.LOGICAL_READS) / exec);
+        put(Metric.PHYSICAL_READS_PER_EXEC, d(Counter.PHYSICAL_READS) / exec);
+        put(Metric.ROWS_EXAMINED_PER_EXEC, d(Counter.ROWS_EXAMINED) / exec);
+        double ret = d(Counter.ROWS_RETURNED);
+        put(Metric.SCAN_RATIO, d(Counter.ROWS_EXAMINED) / Math.max(1, Double.isNaN(ret) ? Double.NaN : ret));
+        put(Metric.EXEC_PER_MIN, exec / Math.max(minutes, 0.01));
+        if (instanceElapsedMs > 0) {
+            put(Metric.DB_TIME_SHARE, d(Counter.ELAPSED_MS) / instanceElapsedMs);
+        }
+        put(Metric.ERROR_RATE, d(Counter.ERRORS) / exec);
+    }
+
+    /**
+     * 合并多行（同一资产的多个原生 ID / 多个执行计划）：增量相加后重算指标。
+     * 返回行的 cur 取执行次数最多的那一行（用于展示计划/原生 ID）。
+     */
+    public static WindowRow merge(java.util.List<WindowRow> rows, double instanceElapsedMs) {
+        if (rows.size() == 1) {
+            return rows.get(0);
+        }
+        double[] d = new double[Counter.SIZE];
+        java.util.Arrays.fill(d, 0);
+        boolean[] nan = new boolean[Counter.SIZE];
+        WindowRow top = rows.get(0);
+        boolean partial = false;
+        double minutes = 0;
+        for (WindowRow r : rows) {
+            for (Counter c : Counter.values()) {
+                double v = r.d(c);
+                if (Double.isNaN(v)) {
+                    nan[c.ordinal()] = true;
+                } else {
+                    d[c.ordinal()] += v;
+                }
+            }
+            if (r.d(Counter.EXEC) > top.d(Counter.EXEC)) {
+                top = r;
+            }
+            partial |= !DeltaEngine.NORMAL.equals(r.quality);
+            minutes = Math.max(minutes, r.minutes);
+        }
+        for (Counter c : Counter.values()) {
+            if (nan[c.ordinal()]) {
+                d[c.ordinal()] = Double.NaN;
+            }
+        }
+        WindowRow m = new WindowRow(top.cur, d, minutes, partial ? DeltaEngine.PARTIAL : DeltaEngine.NORMAL);
+        m.assetId = top.assetId;
+        m.excludeBaseline = top.excludeBaseline;
+        m.computeMetrics(instanceElapsedMs);
+        return m;
+    }
+
+    private void put(Metric m, double v) {
+        if (!Double.isNaN(v) && !Double.isInfinite(v)) {
+            metrics.put(m, v);
+        }
+    }
+}
diff --git a/dbops-server/src/main/java/com/dbops/sqlinsight/diagnosis/CauseClassifier.java b/dbops-server/src/main/java/com/dbops/sqlinsight/diagnosis/CauseClassifier.java
new file mode 100644
index 0000000..916eb73
--- /dev/null
+++ b/dbops-server/src/main/java/com/dbops/sqlinsight/diagnosis/CauseClassifier.java
@@ -0,0 +1,149 @@
+package com.dbops.sqlinsight.diagnosis;
+
+import com.dbops.sqlinsight.collect.Metric;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * 原因分类 —— 按《SQL 问题识别与异常波动检测设计方案》6.2 节实现。纯函数。
+ * <p>
+ * “升高”指比值 ≥ 1.5，“稳定”指比值 &lt; 1.2；缺失指标按 NaN 处理，既不算升高也不算稳定（不把未采集误判成某种原因）。
+ * 多个原因同时满足时按表格优先级顺序全部列出；都不满足为 UNKNOWN。
+ * 发布 / 批处理 / 参数变更不单独成为原因，作为证据附在结果里（方案 6.1 诊断快照）。
+ *
+ * <pre>
+ * 优先级 原因                 指标特征                                      建议动作
+ * 1      PLAN_REGRESSION      出现新计划，且单次耗时或单次逻辑读升高        对比新旧计划，检查统计信息
+ * 2      LOCK_WAIT            单次耗时升高，CPU 和逻辑读稳定，存在锁等待/阻塞链  定位阻塞会话和事务
+ * 3      DATA_GROWTH_OR_SKEW  计划不变，单次逻辑读或扫描行数升高            检查表增长、参数分布、统计信息
+ * 4      CACHE_OR_IO          物理读升高且逻辑读稳定，或 I/O 等待升高        检查缓存命中率和磁盘延迟
+ * 5      RESOURCE_CONTENTION  单次逻辑读稳定，实例 CPU 或运行队列升高        查找同时段资源消耗最高的 SQL
+ * 6      TRAFFIC_SURGE        单次耗时稳定，执行次数升高                    检查业务流量、重试和 N+1
+ * 7      ERROR_SURGE          错误率升高                                    按错误码分组，检查对象和权限变更
+ * 8      UNKNOWN              不满足以上规则                                人工排查，结果沉淀为新规则
+ * </pre>
+ */
+public final class CauseClassifier {
+
+    public static final double UP = 1.5;
+    public static final double STABLE = 1.2;
+
+    /**
+     * @param ratios        当前 / 基线 比值（缺失不放）
+     * @param planSupported 源库统计视图是否提供计划标识（MySQL/PG/磐维/达梦没有，不下 PLAN_REGRESSION 结论）
+     * @param newPlan       异常窗口出现了基线期没有的计划
+     * @param newPlanDetail 例："14:02 出现新 plan_hash 1234，异常窗口中占比 96%"
+     * @param lockWait      存在锁等待或阻塞链
+     * @param instanceCpuRatio 实例 CPU 使用率 当前/基线（缺失为 NaN）
+     * @param instanceIoWaitRatio 实例 I/O 等待 当前/基线（缺失为 NaN）
+     * @param changes       同时段的发布/批处理/参数变更说明（证据，不作为原因）
+     */
+    public record Evidence(Map<Metric, Double> ratios, boolean planSupported, boolean newPlan, String newPlanDetail,
+                           boolean lockWait, String lockDetail, double instanceCpuRatio, double instanceIoWaitRatio,
+                           int concurrentAnomalies, boolean instanceScope, List<String> changes) {
+        double r(Metric m) {
+            Double v = ratios == null ? null : ratios.get(m);
+            return v == null || v.isNaN() ? Double.NaN : v;
+        }
+    }
+
+    public record Cause(String code, int priority, String title, List<String> evidence, List<String> suggestions) {
+    }
+
+    private CauseClassifier() {
+    }
+
+    static boolean up(double v) {
+        return !Double.isNaN(v) && v >= UP;
+    }
+
+    static boolean stable(double v) {
+        return !Double.isNaN(v) && v < STABLE;
+    }
+
+    static String x(double v) {
+        return Double.isNaN(v) ? "未采集" : String.format("%.1f 倍", v);
+    }
+
+    public static List<Cause> classify(Evidence e) {
+        List<Cause> out = new ArrayList<>();
+        double elapsed = e.r(Metric.AVG_ELAPSED_MS);
+        double lr = e.r(Metric.LOGICAL_READS_PER_EXEC);
+        double pr = e.r(Metric.PHYSICAL_READS_PER_EXEC);
+        double rows = e.r(Metric.ROWS_EXAMINED_PER_EXEC);
+        double cpu = e.r(Metric.CPU_PER_EXEC_MS);
+        double exec = e.r(Metric.EXEC_PER_MIN);
+        double err = e.r(Metric.ERROR_RATE);
+
+        // 1 PLAN_REGRESSION
+        if (e.planSupported() && e.newPlan() && (up(elapsed) || up(lr))) {
+            List<String> ev = new ArrayList<>();
+            ev.add(e.newPlanDetail() == null ? "出现基线期没有的新执行计划" : e.newPlanDetail());
+            if (up(elapsed)) {
+                ev.add("单次耗时为基线的 " + x(elapsed));
+            }
+            if (up(lr)) {
+                ev.add("单次逻辑读为基线的 " + x(lr));
+            }
+            out.add(new Cause("PLAN_REGRESSION", 1, "执行计划退化", ev, List.of("对比新旧执行计划", "检查相关表统计信息", "在测试环境验证后再处理（固定计划 / 更新统计信息）")));
+        }
+        // 2 LOCK_WAIT
+        if (up(elapsed) && stable(cpu) && stable(lr) && e.lockWait()) {
+            out.add(new Cause("LOCK_WAIT", 2, "锁等待", List.of("单次耗时为基线的 " + x(elapsed) + "，CPU 与逻辑读稳定",
+                    e.lockDetail() == null ? "存在锁等待或阻塞链" : e.lockDetail()), List.of("定位阻塞会话和事务", "检查长事务、未提交事务", "缩短事务或调整更新顺序")));
+        }
+        // 3 DATA_GROWTH_OR_SKEW
+        if (!e.newPlan() && (up(lr) || up(rows))) {
+            List<String> ev = new ArrayList<>();
+            ev.add(e.planSupported() ? "执行计划未变化" : "该库统计视图无计划标识，按计划未变处理");
+            if (up(lr)) {
+                ev.add("单次逻辑读为基线的 " + x(lr));
+            }
+            if (up(rows)) {
+                ev.add("单次扫描行数为基线的 " + x(rows));
+            }
+            out.add(new Cause("DATA_GROWTH_OR_SKEW", 3, "数据增长或参数分布倾斜", ev, List.of("检查表数据增长", "检查绑定参数分布（是否命中热点值）", "检查统计信息是否过期")));
+        }
+        // 4 CACHE_OR_IO
+        if ((up(pr) && stable(lr)) || up(e.instanceIoWaitRatio())) {
+            List<String> ev = new ArrayList<>();
+            if (up(pr) && stable(lr)) {
+                ev.add("单次物理读为基线的 " + x(pr) + "，逻辑读稳定（" + x(lr) + "）");
+            }
+            if (up(e.instanceIoWaitRatio())) {
+                ev.add("实例 I/O 等待为基线的 " + x(e.instanceIoWaitRatio()));
+            }
+            out.add(new Cause("CACHE_OR_IO", 4, "缓存命中下降或 I/O 变慢", ev, List.of("检查缓存命中率", "检查磁盘延迟", "排查同时段的大查询、备份、统计收集")));
+        }
+        // 5 RESOURCE_CONTENTION
+        // 实例 CPU 升高，且（单次逻辑读稳定 或 实例级事件）——显式加括号，语义与原式相同
+        if (up(e.instanceCpuRatio()) && (stable(lr) || e.instanceScope())) {
+            List<String> ev = new ArrayList<>();
+            ev.add("实例 CPU 使用率为基线的 " + x(e.instanceCpuRatio()));
+            if (stable(lr)) {
+                ev.add("单次逻辑读稳定（" + x(lr) + "）");
+            }
+            if (e.concurrentAnomalies() > 0) {
+                ev.add("同实例另有 " + e.concurrentAnomalies() + " 条 SQL 同时波动");
+            }
+            out.add(new Cause("RESOURCE_CONTENTION", 5, "实例资源争用", ev, List.of("查找同时段资源消耗最高的 SQL", "检查批处理、备份、参数变更")));
+        }
+        // 6 TRAFFIC_SURGE
+        if (stable(elapsed) && up(exec)) {
+            out.add(new Cause("TRAFFIC_SURGE", 6, "调用量突增", List.of("单次耗时稳定（" + x(elapsed) + "）", "每分钟执行次数为基线的 " + x(exec)),
+                    List.of("检查业务流量", "检查应用重试", "检查 N+1 查询")));
+        }
+        // 7 ERROR_SURGE
+        if (up(err)) {
+            out.add(new Cause("ERROR_SURGE", 7, "错误率升高", List.of("错误率为基线的 " + x(err)), List.of("按错误码分组", "检查对象和权限变更")));
+        }
+        if (out.isEmpty()) {
+            List<String> ev = new ArrayList<>();
+            ev.add("不满足已知规则（单次耗时 " + x(elapsed) + "，逻辑读 " + x(lr) + "，执行次数 " + x(exec) + "）");
+            out.add(new Cause("UNKNOWN", 8, "原因未明", ev, List.of("人工排查", "结果沉淀为新规则")));
+        }
+        return out;
+    }
+}
diff --git a/dbops-server/src/main/java/com/dbops/sqlinsight/diagnosis/DiagnosisService.java b/dbops-server/src/main/java/com/dbops/sqlinsight/diagnosis/DiagnosisService.java
