+
+        // ---------------- 运维
+        Map<String, Object> ops = new LinkedHashMap<>();
+        ops.put("backup", safeOne(() -> db.one("SELECT COUNT(*) TOTAL, SUM(CASE WHEN STATUS = 'SUCCESS' THEN 1 ELSE 0 END) SUCCESS, "
