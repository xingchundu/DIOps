+                + "FROM MONITOR_METRIC_SAMPLE WHERE COLLECTED_AT >= ? AND COLLECTED_AT < ? AND REACHABLE = 1 AND" + inIds + ") WHERE RN_A = 1 OR RN_D = 1", from, to))) {
+            Map<String, Object> d = MonitorBoardService.parse(r.get("HEALTH_DETAIL"));
