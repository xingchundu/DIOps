[
  {
    "no": 1,
    "category": "1. 主机与操作系统",
    "subcategory": "CPU",
    "item": "CPU 使用率（user/sys/iowait）",
    "desc": "主机整体 CPU 消耗，重点看 iowait 与 steal",
    "collect": "top / vmstat 1 / sar -u 1 1 / nmon",
    "threshold": "持续 >80% 关注；iowait >20% 需排查 IO",
    "level": "严重",
    "note": "定位高 CPU 进程（top -Hp <pid>），检查慢 SQL、全表扫描、并行度设置"
  },
  {
    "no": 2,
    "category": "1. 主机与操作系统",
    "subcategory": "CPU",
    "item": "CPU 负载 load average",
    "desc": "1/5/15 分钟平均负载，反映排队情况",
    "collect": "uptime / cat /proc/loadavg",
    "threshold": "load > CPU核数 × 0.7 告警",
    "level": "严重",
    "note": "结合运行队列 r 值判断，r 持续 > 核数说明 CPU 瓶颈"
  },
  {
    "no": 3,
    "category": "1. 主机与操作系统",
    "subcategory": "CPU",
    "item": "上下文切换 cs / 中断",
    "desc": "反映调度压力与网络中断压力",
    "collect": "vmstat 1 中 cs、in 列",
    "threshold": "cs 突增 3 倍以上关注",
    "level": "警告",
    "note": "排查是否有大量短连接、锁竞争导致的自旋"
  },
  {
    "no": 4,
    "category": "1. 主机与操作系统",
    "subcategory": "内存",
    "item": "物理内存使用率 / free",
    "desc": "可用内存、buff/cache 占用情况",
    "collect": "free -g / cat /proc/meminfo",
    "threshold": "available < 10% 告警",
    "level": "严重",
    "note": "确认 openGauss 是否 OOM，调整 shared_buffers、work_mem"
  },
  {
    "no": 5,
    "category": "1. 主机与操作系统",
    "subcategory": "内存",
    "item": "Swap 使用与换页",
    "desc": "swap 使用量及 si/so 换页速率",
    "collect": "free -g / vmstat 1 中 si、so",
    "threshold": "si/so 持续 >0 或 swap 使用 >20% 告警",
    "level": "严重",
    "note": "数据库不应频繁换页，swap 使用需立即干预，考虑扩容内存"
  },
  {
    "no": 6,
    "category": "1. 主机与操作系统",
    "subcategory": "磁盘IO",
    "item": "磁盘读写吞吐与 IOPS",
    "desc": "设备级读/写 MB/s 与 IOPS",
    "collect": "iostat -x 1 / sar -d",
    "threshold": "util% > 90% 或 await > 20ms 告警",
    "level": "严重",
    "note": "定位热点磁盘与热点文件，检查是否有全表扫描、检查点过于频繁"
  },
  {
    "no": 7,
    "category": "1. 主机与操作系统",
    "subcategory": "磁盘IO",
    "item": "磁盘 IO 响应时间 await/util",
    "desc": "IO 等待时长与利用率",
    "collect": "iostat -x 1 (r_await, w_await, %util)",
    "threshold": "await > 20ms 持续告警",
    "level": "严重",
    "note": "排查存储后端、是否带宽打满、是否顺序/随机混合"
  },
  {
    "no": 8,
    "category": "1. 主机与操作系统",
    "subcategory": "磁盘空间",
    "item": "文件系统使用率",
    "desc": "数据目录、WAL目录、归档目录、日志目录空间",
    "collect": "df -h / du -sh $PGDATA",
    "threshold": ">75% 关注，>85% 告警，>95% 紧急",
    "level": "紧急",
    "note": "清理归档/日志，扩容磁盘，设置自动清理策略"
  },
  {
    "no": 9,
    "category": "1. 主机与操作系统",
    "subcategory": "磁盘空间",
    "item": "Inode 使用率",
    "desc": "文件数量耗尽风险",
    "collect": "df -i",
    "threshold": ">85% 告警",
    "level": "警告",
    "note": "清理小文件（临时文件、归档碎片），排查异常建文件行为"
  },
  {
    "no": 10,
    "category": "1. 主机与操作系统",
    "subcategory": "磁盘空间",
    "item": "磁盘 inode/空间增长趋势",
    "desc": "按天采集，识别异常增长",
    "collect": "定时脚本 du -sh 采集入库",
    "threshold": "日增长 > 5% 关注",
    "level": "警告",
    "note": "结合业务量判断，预防磁盘写满"
  },
  {
    "no": 11,
    "category": "1. 主机与操作系统",
    "subcategory": "网络",
    "item": "网卡吞吐与丢包/错包",
    "desc": "网络带宽使用率、丢包率",
    "collect": "sar -n DEV 1 / ifconfig / ip -s link",
    "threshold": "丢包率 > 0.1% 告警",
    "level": "警告",
    "note": "检查网卡、交换机、bond 状态，排查主备同步网络"
  },
  {
    "no": 12,
    "category": "1. 主机与操作系统",
    "subcategory": "网络",
    "item": "TCP 连接状态统计",
    "desc": "ESTABLISHED / TIME_WAIT / CLOSE_WAIT 数量",
    "collect": "ss -s / netstat -an | awk",
    "threshold": "TIME_WAIT 异常增长关注",
    "level": "提示",
    "note": "大量 CLOSE_WAIT 说明应用未正确关闭连接"
  },
  {
    "no": 13,
    "category": "1. 主机与操作系统",
    "subcategory": "进程",
    "item": "panweidb / 关键进程存活",
    "desc": "数据库主进程及各后台线程存活状态",
    "collect": "ps -ef | grep panweidb / gs_ctl status -D $PGDATA",
    "threshold": "进程不存在立即告警",
    "level": "紧急",
    "note": "触发 HA 切换或拉起实例，检查 crash 日志"
  },
  {
    "no": 14,
    "category": "1. 主机与操作系统",
    "subcategory": "进程",
    "item": "进程句柄数 / 线程数",
    "desc": "进程打开的 fd 数量、线程数",
    "collect": "lsof -p <pid> | wc -l / ls /proc/<pid>/task | wc -l",
    "threshold": "接近 ulimit -n 上限 80% 告警",
    "level": "警告",
    "note": "调整 ulimit，排查 fd 泄漏"
  },
  {
    "no": 15,
    "category": "1. 主机与操作系统",
    "subcategory": "时钟",
    "item": "NTP 时钟偏移",
    "desc": "集群节点间时间同步状态",
    "collect": "ntpq -p / chronyc sources",
    "threshold": "偏移 > 1s 告警",
    "level": "警告",
    "note": "修复 NTP，主备时间偏差影响复制与日志判断"
  },
  {
    "no": 16,
    "category": "1. 主机与操作系统",
    "subcategory": "系统信息",
    "item": "主机 uptime / 重启检测",
    "desc": "识别意外重启",
    "collect": "uptime / who -b",
    "threshold": "uptime 归零告警",
    "level": "警告",
    "note": "排查是否断电、内核 panic、OOM Killer"
  },
  {
    "no": 17,
    "category": "2. 实例与可用性",
    "subcategory": "实例状态",
    "item": "实例运行状态",
    "desc": "openGauss 实例是否正常 open / read write",
    "collect": "gs_ctl status -D $PGDATA / gs_om -t status --detail",
    "threshold": "非 Normal 即告警",
    "level": "紧急",
    "note": "查看 $PGLOG，重启或触发切换"
  },
  {
    "no": 18,
    "category": "2. 实例与可用性",
    "subcategory": "实例状态",
    "item": "数据库连接可用性",
    "desc": "能否正常建连、简单查询是否成功",
    "collect": "gsql -d postgres -c \"select 1\"",
    "threshold": "探测失败连续 3 次告警",
    "level": "紧急",
    "note": "排查实例、监听、连接数、认证问题"
  },
  {
    "no": 19,
    "category": "2. 实例与可用性",
    "subcategory": "实例状态",
    "item": "实例启动时长 / 最近重启",
    "desc": "识别异常重启与运行稳定性",
    "collect": "select pg_postmaster_start_time()",
    "threshold": "近 24h 内有重启记录告警",
    "level": "严重",
    "note": "结合系统日志与数据库日志判断原因"
  },
  {
    "no": 20,
    "category": "2. 实例与可用性",
    "subcategory": "集群状态",
    "item": "集群整体状态",
    "desc": "主备集群整体健康状态",
    "collect": "gs_om -t status --detail",
    "threshold": "集群状态非 Normal 告警",
    "level": "紧急",
    "note": "按 gs_om 输出定位异常节点"
  },
  {
    "no": 21,
    "category": "2. 实例与可用性",
    "subcategory": "版本信息",
    "item": "数据库版本与补丁",
    "desc": "版本号、构建时间、是否需升级",
    "collect": "select version(); gs_ctl query -D $PGDATA",
    "threshold": "与基线版本不一致关注",
    "level": "提示",
    "note": "定期核对补丁基线，评估升级"
  },
  {
    "no": 22,
    "category": "3. 连接与会话",
    "subcategory": "连接数",
    "item": "当前连接数",
    "desc": "当前活跃+空闲连接总数",
    "collect": "select count(*) from pg_stat_activity;",
    "threshold": "> max_connections 80% 告警",
    "level": "严重",
    "note": "清理空闲连接，评估连接池配置"
  },
  {
    "no": 23,
    "category": "3. 连接与会话",
    "subcategory": "连接数",
    "item": "连接数使用率",
    "desc": "当前连接 / max_connections",
    "collect": "select count(*)*100/(select setting from pg_settings where name='max_connections') from pg_stat_activity;",
    "threshold": ">80% 告警，>90% 紧急",
    "level": "严重",
    "note": "扩大 max_connections 或引入连接池（pgbouncer）"
  },
  {
    "no": 24,
    "category": "3. 连接与会话",
    "subcategory": "连接数",
    "item": "空闲事务连接",
    "desc": "长期 idle in transaction 的连接",
    "collect": "select * from pg_stat_activity where state='idle in transaction';",
    "threshold": ">5min 告警，>30min 紧急",
    "level": "严重",
    "note": "排查应用未提交/未回滚事务，必要时 kill session"
  },
  {
    "no": 25,
    "category": "3. 连接与会话",
    "subcategory": "连接数",
    "item": "空闲连接（idle）占比",
    "desc": "连接池空转情况",
    "collect": "select state,count(*) from pg_stat_activity group by 1;",
    "threshold": "idle 占比 >60% 关注",
    "level": "提示",
    "note": "优化连接池 min/max 配置，缩短 idle 超时"
  },
  {
    "no": 26,
    "category": "3. 连接与会话",
    "subcategory": "会话",
    "item": "活跃会话数",
    "desc": "state='active' 的会话数",
    "collect": "select count(*) from pg_stat_activity where state='active';",
    "threshold": "与业务基线对比，突增 2 倍关注",
    "level": "警告",
    "note": "结合等待事件定位阻塞源"
  },
  {
    "no": 27,
    "category": "3. 连接与会话",
    "subcategory": "会话",
    "item": "长事务 / 长 SQL",
    "desc": "运行时长超过阈值的事务与 SQL",
    "collect": "select pid,now()-xact_start,query from pg_stat_activity where state<>'idle' and now()-xact_start > interval '5 min';",
    "threshold": ">5min 告警，>30min 紧急",
    "level": "严重",
    "note": "分析执行计划、锁等待，必要时终止"
  },
  {
    "no": 28,
    "category": "3. 连接与会话",
    "subcategory": "会话",
    "item": "会话最长存活时间",
    "desc": "监控挂死会话",
    "collect": "select max(now()-backend_start) from pg_stat_activity;",
    "threshold": "按业务设定，异常增长关注",
    "level": "提示",
    "note": "排查连接泄漏"
  },
  {
    "no": 29,
    "category": "3. 连接与会话",
    "subcategory": "会话",
    "item": "被取消 / 被终止会话数",
    "desc": "statement cancel / terminate 统计",
    "collect": "select pg_stat_get_db_conflict_* / 日志统计",
    "threshold": "突增告警",
    "level": "警告",
    "note": "排查应用超时重试与资源竞争"
  },
  {
    "no": 30,
    "category": "4. 内存与缓存",
    "subcategory": "缓存",
    "item": "共享缓冲区命中率",
    "desc": "shared_buffers 命中率",
    "collect": "select blks_hit*100/(blks_hit+blks_read) from pg_stat_database;",
    "threshold": "<95% 关注，<90% 告警",
    "level": "警告",
    "note": "适当增大 shared_buffers，优化 SQL 减少物理读"
  },
  {
    "no": 31,
    "category": "4. 内存与缓存",
    "subcategory": "缓存",
    "item": "数据文件物理读/逻辑读",
    "desc": "物理读占比反映缓存效率",
    "collect": "select datname,blks_read,blks_hit from pg_stat_database;",
    "threshold": "物理读比例升高关注",
    "level": "警告",
    "note": "定位全表扫描、缺少索引的 SQL"
  },
  {
    "no": 32,
    "category": "4. 内存与缓存",
    "subcategory": "内存",
    "item": "会话内存使用（work_mem/临时文件）",
    "desc": "排序/哈希落盘产生的临时文件",
    "collect": "select datname,temp_files,temp_bytes from pg_stat_database;",
    "threshold": "temp_bytes 突增告警",
    "level": "警告",
    "note": "提升 work_mem，优化排序/哈希的 SQL"
  },
  {
    "no": 33,
    "category": "4. 内存与缓存",
    "subcategory": "内存",
    "item": "内核内存 / 大页配置",
    "desc": "hugepage、内存 overcommit 配置",
    "collect": "cat /proc/meminfo | grep -i huge / sysctl vm.overcommit_memory",
    "threshold": "hugepage 未启用关注",
    "level": "提示",
    "note": "按 openGauss 最佳实践配置大页减少页表开销"
  },
  {
    "no": 34,
    "category": "4. 内存与缓存",
    "subcategory": "内存",
    "item": "内存泄漏趋势",
    "desc": "panweidb 进程 RSS 持续增长",
    "collect": "ps -o rss -p <pid> 定时采集",
    "threshold": "周环比增长 >10% 关注",
    "level": "警告",
    "note": "结合版本已知问题，必要时重启或升级"
  },
  {
    "no": 35,
    "category": "5. 锁与并发",
    "subcategory": "锁等待",
    "item": "锁等待会话数",
    "desc": "当前处于锁等待的会话",
    "collect": "select count(*) from pg_stat_activity where wait_event_type='Lock';",
    "threshold": ">5 告警，>20 紧急",
    "level": "严重",
    "note": "查询 pg_locks 定位阻塞源与被阻塞会话"
  },
  {
    "no": 36,
    "category": "5. 锁与并发",
    "subcategory": "锁等待",
    "item": "最长锁等待时长",
    "desc": "锁等待最久的会话时长",
    "collect": "select max(now()-wait_event) ... / pg_locks 关联 pg_stat_activity",
    "threshold": ">30s 告警，>5min 紧急",
    "level": "严重",
    "note": "杀阻塞源会话或优化其 SQL"
  },
  {
    "no": 37,
    "category": "5. 锁与并发",
    "subcategory": "锁等待",
    "item": "死锁检测次数",
    "desc": "数据库检测到的死锁次数",
    "collect": "日志统计 / pg_stat_database.deadlocks",
    "threshold": "出现即告警",
    "level": "严重",
    "note": "分析应用加锁顺序，统一加锁顺序避免死锁"
  },
  {
    "no": 38,
    "category": "5. 锁与并发",
    "subcategory": "锁等待",
    "item": "阻塞链深度",
    "desc": "阻塞与被阻塞会话形成的等待链",
    "collect": "with recursive 查询 pg_locks 构建阻塞树",
    "threshold": "深度 >3 关注",
    "level": "警告",
    "note": "定位链路根节点，优先处理"
  },
  {
    "no": 39,
    "category": "5. 锁与并发",
    "subcategory": "锁对象",
    "item": "表级锁争用",
    "desc": "热点表的排他锁等待",
    "collect": "select * from pg_locks where mode like '%Exclusive%'",
    "threshold": "争用频繁关注",
    "level": "警告",
    "note": "评估 DDL 与 DML 并发，错峰执行"
  },
  {
    "no": 40,
    "category": "5. 锁与并发",
    "subcategory": "轻量锁",
    "item": "LWLOCK 等待",
    "desc": "轻量级锁争用（如 buffer mapping、wal insert loc）",
    "collect": "gs_ash / 等待事件 lwlock:*",
    "threshold": "持续占比高关注",
    "level": "警告",
    "note": "热点 LWLock 需结合版本与参数调优"
  },
  {
    "no": 41,
    "category": "6. WAL与检查点",
    "subcategory": "WAL",
    "item": "WAL 生成速率",
    "desc": "单位时间 WAL 写入量",
    "collect": "select pg_current_xlog_location() 差值 / pg_xlog 目录增长",
    "threshold": "突增 2 倍关注",
    "level": "提示",
    "note": "结合业务批量写判断"
  },
  {
    "no": 42,
    "category": "6. WAL与检查点",
    "subcategory": "WAL",
    "item": "WAL 目录大小 / 保留量",
    "desc": "pg_xlog 目录占用",
    "collect": "du -sh $PGDATA/pg_xlog",
    "threshold": "超过 max_wal_size 阈值关注",
    "level": "警告",
    "note": "检查复制槽、归档是否积压导致 WAL 保留"
  },
  {
    "no": 43,
    "category": "6. WAL与检查点",
    "subcategory": "WAL",
    "item": "复制槽 WAL 保留量",
    "desc": "无用复制槽导致 WAL 堆积",
    "collect": "select slot_name,restart_lsn from pg_replication_slots; pg_waldump 对比",
    "threshold": "保留 WAL 持续增长告警",
    "level": "严重",
    "note": "删除无用复制槽，修复失效备机"
  },
  {
    "no": 44,
    "category": "6. WAL与检查点",
    "subcategory": "检查点",
    "item": "检查点发生频率",
    "desc": "checkpoint 触发次数",
    "collect": "日志统计 'checkpoint starting' / gs_stat",
    "threshold": "过于频繁（如 <1min 一次）告警",
    "level": "警告",
    "note": "调大 max_wal_size / checkpoint_timeout"
  },
  {
    "no": 45,
    "category": "6. WAL与检查点",
    "subcategory": "检查点",
    "item": "检查点写入耗时",
    "desc": "checkpoint 同步/异步耗时",
    "collect": "日志 'checkpoint complete' 时间差",
    "threshold": ">30s 关注",
    "level": "警告",
    "note": "结合 dirty page 量与 IO 能力调优"
  },
  {
    "no": 46,
    "category": "6. WAL与检查点",
    "subcategory": "脏页",
    "item": "脏页比例 / 刷脏压力",
    "desc": "shared buffer dirty 比例",
    "collect": "select * from pg_stat_bgwriter (buffers_backend 等)",
    "threshold": "backend 刷脏占比高关注",
