    "no": 1,
    "category": "1. 可用性与实例",
    "item": "实例状态",
    "source": "v$instance.status",
    "threshold": "status <> 'OPEN'",
    "level": "严重",
    "note": "含 MOUNTED/STARTING 等中间态"
  },
  {
